                            background: root.active_view == 7 ? AppStyle.primary : AppStyle.bg;
                            border-width: 1px; border-color: root.active_view == 7 ? AppStyle.primary-dark : AppStyle.border;
                            Text { text: "F8"; font-size: 9px; font-weight: 800; color: root.active_view == 7 ? #ffffff : AppStyle.text-muted; horizontal-alignment: center; vertical-alignment: center; }
                        }
                        Text { text: "Stok Opname"; font-size: AppStyle.font-xs; font-weight: root.active_view == 7 ? 800 : 600; color: root.active_view == 7 ? AppStyle.primary-dark : AppStyle.text-primary; vertical-alignment: center; }
                    }
                }

                // [F9] Laporan Keuangan
                Rectangle {
                    border-radius: 4px;
                    background: root.active_view == 8 ? AppStyle.primary-light : AppStyle.surface;
                    border-width: 1px;
                    border-color: root.active_view == 8 ? AppStyle.primary : AppStyle.border;
                    TouchArea { clicked => { root.active_view = 8; root.navigasi(8); } }
                    HorizontalLayout {
