                            border-width: 1px; border-color: root.active_view == 6 ? AppStyle.primary-dark : AppStyle.border;
                            Text { text: "F7"; font-size: 9px; font-weight: 800; color: root.active_view == 6 ? #ffffff : AppStyle.text-muted; horizontal-alignment: center; vertical-alignment: center; }
                        }
