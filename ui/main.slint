                    background: root.active_view == 11 ? AppStyle.primary-light : AppStyle.surface;
                    border-width: 1px;
                    border-color: root.active_view == 11 ? AppStyle.primary : AppStyle.border;
                    TouchArea { clicked => { root.active_view = 11; root.navigasi(11); } }
                    HorizontalLayout {
                        padding-left: 6px; padding-right: 8px; spacing: 4px; alignment: center;
                        Rectangle {
                            width: 22px; height: 18px; border-radius: 2px;
                            background: root.active_view == 11 ? AppStyle.primary : AppStyle.bg;
                            border-width: 1px; border-color: root.active_view == 11 ? AppStyle.primary-dark : AppStyle.border;
                            Text { text: "F12"; font-size: 9px; font-weight: 800; color: root.active_view == 11 ? #ffffff : AppStyle.text-muted; horizontal-alignment: center; vertical-alignment: center; }
                        }
                        Text { text: "Shift"; font-size: AppStyle.font-xs; font-weight: root.active_view == 11 ? 800 : 600; color: root.active_view == 11 ? AppStyle.primary-dark : AppStyle.text-primary; vertical-alignment: center; }
                    }
                }

                Rectangle { width: 1px; height: 24px; background: AppStyle.border; }

                // Pengaturan & Lisensi
                Rectangle {
                    border-radius: 4px;
                    background: root.active_view == 12 ? AppStyle.primary-light : AppStyle.surface;
                    border-width: 1px;
                    border-color: root.active_view == 12 ? AppStyle.primary : AppStyle.border;
                    TouchArea { clicked => { root.active_view = 12; root.navigasi(12); } }
                    HorizontalLayout {
                        padding-left: 8px; padding-right: 8px; alignment: center;
                        Text { text: "Pengaturan"; font-size: AppStyle.font-xs; font-weight: root.active_view == 12 ? 800 : 600; color: root.active_view == 12 ? AppStyle.primary-dark : AppStyle.text-secondary; vertical-alignment: center; }
                    }
                }
            }
        }

        // =========================================================================
        // FULL-WIDTH WORKSPACE CANVAS (100% Layar Bersih & Luas, Tanpa Sidebar)
        // =========================================================================
        VerticalLayout {
            padding: AppStyle.space-sm;
            spacing: AppStyle.space-xs;
            vertical-stretch: 1;

            if root.active_view == 0: KasirView {
                input_barcode <=> root.input_barcode;
                items: root.cart_items;
                catalog_products: root.products;
                total_belanja: root.total_belanja;
                bayar_tunai <=> root.bayar_tunai;
                kembalian: root.kembalian;

                    member_nama: root.member_nama;
                    member_kode: root.member_kode;
                    member_poin_saldo: root.member_poin_saldo;
                    is_member_attached: root.is_member_attached;
                    nilai_tukar_poin: root.nilai_tukar_poin;
                    pending_items: root.pending_items;
                    metode_bayar <=> root.kasir_metode_bayar;

                    cari_barcode(code) => { root.cari_barcode(code); }
                    ubah_qty(idx, qty) => { root.ubah_qty_kasir(idx, qty); }
                    hapus_item(idx) => { root.hapus_item_kasir(idx); }
                    proses_bayar(tunai) => { root.proses_bayar(tunai); }
                    reset_transaksi() => { root.reset_transaksi(); }

                    cari_member(q) => { root.cari_member_kasir(q); }
                    lepas_member() => { root.lepas_member_kasir(); }
                    tukar_poin(p) => { root.tukar_poin_kasir(p); }
                    batal_tukar_poin() => { root.batal_tukar_poin_kasir(); }
                    hold_transaksi(ket) => { root.hold_transaksi_kasir(ket); }
                    recall_transaksi(id) => { root.recall_transaksi_kasir(id); }
                    hapus_pending(id) => { root.hapus_pending_kasir(id); }
                }

                if root.active_view == 1: RiwayatView {
                    items: root.history_items;
                    total_omzet: root.total_omzet_riwayat;
                    cetak_struk(faktur) => { root.cetak_struk_riwayat(faktur); }
                    refresh_riwayat() => { root.refresh_riwayat(); }
                }

                if root.active_view == 2: ReturView {
                    items: root.retur_items;
                    proses_retur(faktur, kode, qty) => { root.proses_retur_penjualan(faktur, kode, qty); }
                    refresh_retur() => { root.refresh_retur_penjualan(); }
                }

                if root.active_view == 3: PembelianView {
                    items: root.pembelian_items;
                    simpan_pembelian(kode, suplier, qty, harga, bayar, metode) => {
                        root.simpan_transaksi_pembelian(kode, suplier, qty, harga, bayar, metode);
                    }
                    refresh_pembelian() => { root.refresh_transaksi_pembelian(); }
                }

                if root.active_view == 4: BarangView {
                    products: root.products;
                    filter_barang <=> root.filter_barang;
                    total_item_barang: root.total_item_barang;
                    total_nilai_beli: root.total_nilai_beli;
                    total_nilai_jual: root.total_nilai_jual;
                    cari_barang(kw) => { root.cari_barang(kw); }
                    simpan_barang_baru(k, n, b, kat, sat, hp, hj, st) => { root.simpan_barang_baru(k, n, b, kat, sat, hp, hj, st); }
                    hapus_barang(id) => { root.hapus_barang(id); }
                }

                if root.active_view == 5: PelangganView {
                    items: root.pelanggan_items;
                    cari_pelanggan(kw) => { root.cari_pelanggan(kw); }
                }

                if root.active_view == 6: SupplierView {
                    items: root.supplier_items;
                    tambah_supplier(k, n, telp, alm, rek) => { root.tambah_supplier_baru(k, n, telp, alm, rek); }
                    hapus_supplier(id) => { root.hapus_supplier_id(id); }
                    refresh_supplier() => { root.refresh_data_supplier(); }
                }

                if root.active_view == 7: StokOpnameView {
                    items: root.opname_items;
                    proses_opname(kode, fisik, alasan) => { root.proses_stok_opname(kode, fisik, alasan); }
                    refresh_opname() => { root.refresh_stok_opname(); }
                }

                if root.active_view == 8: LaporanView {
                    metrics: root.laporan_metrics;
                    top_products: root.top_products;
                    refresh_laporan() => { root.refresh_laporan(); }
                }

                if root.active_view == 9: HutangPiutangView {
                    hutang_items: root.hutang_items;
                    piutang_items: root.piutang_items;
                    bayar_hutang(id, jml) => { root.bayar_cicilan_hutang(id, jml); }
                    bayar_piutang(id, jml) => { root.bayar_cicilan_piutang(id, jml); }
                    refresh_data() => { root.refresh_hutang_piutang(); }
                }

                if root.active_view == 10: BukuKasView {
                    items: root.cashflow_items;
                    total_masuk: root.kas_total_masuk;
                    total_keluar: root.kas_total_keluar;
                    saldo_kas: root.kas_saldo;
                    catat_kas(jenis, kat, nom, ket) => { root.catat_arus_kas_biaya(jenis, kat, nom, ket); }
                    refresh_kas() => { root.refresh_buku_kas(); }
                }

                if root.active_view == 11: ShiftView {
                    modal_awal: root.shift_modal_awal;
                    total_tunai: root.shift_tunai;
                    total_nontunai: root.shift_nontunai;
                    total_retur: root.shift_retur;
                    uang_seharusnya: root.shift_uang_seharusnya;
                    shift_status: root.shift_status;
                    catatan <=> root.shift_catatan;
                    tutup_shift() => { root.tutup_shift_kasir(); }
                    buka_shift(modal) => { root.buka_shift_baru(modal); }
                }

                if root.active_view == 12: PengaturanView {
                    machine_id: root.machine_id;
                    input_license_token <=> root.input_license_token;
                    license_status_text: root.license_status_text;
                    license_toko: root.license_toko;
                    input_sql_dump <=> root.input_sql_dump;
                    import_summary: root.import_summary;
                    aktivasi_lisensi(tok) => { root.aktivasi_lisensi(tok); }
                    jalankan_import_sql(sql) => { root.jalankan_import_sql(sql); }
                    buat_backup_db() => { root.buat_backup_db(); }
                }
            }

        // =========================================================================
        // STATUS BAR BAWAH (Light Theme, Border-Top, Anti AI-Slop)
        // =========================================================================
        Rectangle {
            height: 26px;
            background: AppStyle.surface;
            border-width: 1px;
            border-color: AppStyle.border;

            HorizontalLayout {
                padding-left: AppStyle.space-md; padding-right: AppStyle.space-md;
                alignment: space-between;
                Text { text: root.status_pesan; font-size: AppStyle.font-xs; color: AppStyle.text-secondary; vertical-alignment: center; }
                Text { text: "FAZPOS Desktop Engine (SQLite WAL) • Siap"; font-size: 10px; color: AppStyle.text-muted; vertical-alignment: center; }
            }
        }
    }

    // =========================================================================
    // INTERACTIVE MODAL POPUPS (Pop-up Sukses Bayar & Bantuan Pintasan)
    // =========================================================================
    if root.show_modal_sukses || root.show_modal_help: Rectangle {
        background: #00000066;

        TouchArea {
            // block clicks through to background
        }

        // 1. POPUP MODAL SUKSES BAYAR (Struk & Kembalian)
        if root.show_modal_sukses: Rectangle {
            width: 440px;
            height: 360px;
            background: AppStyle.surface;
            border-radius: 6px;
            border-width: 1px;
            border-color: AppStyle.border;

            VerticalLayout {
                padding: AppStyle.space-lg;
                spacing: AppStyle.space-md;

                HorizontalLayout {
                    alignment: space-between;
                    Text { text: "TRANSAKSI BERHASIL DISIMPAN"; font-size: AppStyle.font-heading; font-weight: 800; color: AppStyle.success; }
                    Rectangle {
                        width: 24px; height: 24px; border-radius: 3px; background: AppStyle.bg;
                        TouchArea { clicked => { root.show_modal_sukses = false; } }
                        Text { text: "X"; font-size: 11px; font-weight: 700; color: AppStyle.text-muted; horizontal-alignment: center; vertical-alignment: center; }
                    }
                }

                Rectangle { height: 1px; background: AppStyle.border; }

                VerticalLayout {
                    spacing: 8px;
                    HorizontalLayout {
                        alignment: space-between;
                        Text { text: "No. Faktur:"; font-size: AppStyle.font-sm; color: AppStyle.text-secondary; }
                        Text { text: root.sukses_faktur; font-size: AppStyle.font-body; font-weight: 700; color: AppStyle.primary; }
                    }
                    HorizontalLayout {
                        alignment: space-between;
                        Text { text: "Total Tagihan:"; font-size: AppStyle.font-sm; color: AppStyle.text-secondary; }
                        Text { text: "Rp " + root.sukses_total; font-size: AppStyle.font-body; font-weight: 700; color: AppStyle.text-primary; }
                    }
                    HorizontalLayout {
                        alignment: space-between;
                        Text { text: "Uang Diterima:"; font-size: AppStyle.font-sm; color: AppStyle.text-secondary; }
                        Text { text: "Rp " + root.sukses_bayar; font-size: AppStyle.font-body; font-weight: 700; color: AppStyle.text-primary; }
                    }
                    Rectangle {
                        height: 70px;
                        background: AppStyle.success-bg;
                        border-radius: 6px;
                        border-width: 1px;
                        border-color: AppStyle.success-border;
                        VerticalLayout {
                            alignment: center; spacing: 4px;
                            Text { text: "KEMBALIAN UANG KAS:"; font-size: 10px; font-weight: 800; color: AppStyle.success; horizontal-alignment: center; }
                            Text { text: "Rp " + root.sukses_kembalian; font-size: 26px; font-weight: 900; color: AppStyle.success; horizontal-alignment: center; }
                        }
                    }
                }

                HorizontalLayout {
                    spacing: AppStyle.space-sm;
                    Rectangle {
                        horizontal-stretch: 1; height: AppStyle.button-height-primary;
                        background: AppStyle.primary; border-radius: 4px;
                        TouchArea { clicked => {
                            root.cetak_struk_terakhir();
                            root.show_modal_sukses = false;
                        } }
                        Text { text: "CETAK STRUK (ENTER)"; font-size: AppStyle.font-xs; font-weight: 700; color: #ffffff; horizontal-alignment: center; vertical-alignment: center; }
                    }
                    Rectangle {
                        horizontal-stretch: 1; height: AppStyle.button-height-primary;
                        background: AppStyle.success; border-radius: 4px;
                        TouchArea { clicked => { root.show_modal_sukses = false; } }
                        Text { text: "TRANSAKSI BARU (ESC)"; font-size: AppStyle.font-xs; font-weight: 700; color: #ffffff; horizontal-alignment: center; vertical-alignment: center; }
                    }
                }
            }
        }

        // 2. POPUP MODAL BANTUAN TOMBOL PINTAS (F1 - F12)
        if root.show_modal_help: Rectangle {
            width: 500px;
            height: 420px;
            background: AppStyle.surface;
            border-radius: 6px;
            border-width: 1px;
            border-color: AppStyle.border;

            VerticalLayout {
                padding: AppStyle.space-lg;
                spacing: AppStyle.space-md;

                HorizontalLayout {
                    alignment: space-between;
                    Text { text: "PANDUAN TOMBOL PINTAS (KEYBOARD)"; font-size: AppStyle.font-heading; font-weight: 800; color: AppStyle.primary-dark; }
                    Rectangle {
                        width: 24px; height: 24px; border-radius: 3px; background: AppStyle.bg;
                        TouchArea { clicked => { root.show_modal_help = false; } }
                        Text { text: "X"; font-size: 11px; font-weight: 700; color: AppStyle.text-muted; horizontal-alignment: center; vertical-alignment: center; }
                    }
                }

                Rectangle { height: 1px; background: AppStyle.border; }

                VerticalLayout {
                    spacing: 6px;
                    HorizontalLayout { alignment: space-between; Text { text: "F1 - Kasir POS"; font-size: AppStyle.font-sm; font-weight: 700; color: AppStyle.text-primary; } Text { text: "Buka layar kasir transaksi"; font-size: AppStyle.font-xs; color: AppStyle.text-muted; } }
                    HorizontalLayout { alignment: space-between; Text { text: "F2 - Riwayat Penjualan"; font-size: AppStyle.font-sm; font-weight: 700; color: AppStyle.text-primary; } Text { text: "Histori transaksi & cetak ulang"; font-size: AppStyle.font-xs; color: AppStyle.text-muted; } }
                    HorizontalLayout { alignment: space-between; Text { text: "F3 - Retur Penjualan"; font-size: AppStyle.font-sm; font-weight: 700; color: AppStyle.text-primary; } Text { text: "Retur barang dari pembeli"; font-size: AppStyle.font-xs; color: AppStyle.text-muted; } }
                    HorizontalLayout { alignment: space-between; Text { text: "F4 - Pembelian Supplier"; font-size: AppStyle.font-sm; font-weight: 700; color: AppStyle.text-primary; } Text { text: "Entri barang masuk & hutang"; font-size: AppStyle.font-xs; color: AppStyle.text-muted; } }
                    HorizontalLayout { alignment: space-between; Text { text: "F5 - Simpan / Bayar"; font-size: AppStyle.font-sm; font-weight: 700; color: AppStyle.text-primary; } Text { text: "Eksekusi checkout kasir"; font-size: AppStyle.font-xs; color: AppStyle.text-muted; } }
                    HorizontalLayout { alignment: space-between; Text { text: "F7 - Hold Antrean"; font-size: AppStyle.font-sm; font-weight: 700; color: AppStyle.text-primary; } Text { text: "Tahan keranjang pembeli"; font-size: AppStyle.font-xs; color: AppStyle.text-muted; } }
                    HorizontalLayout { alignment: space-between; Text { text: "F8 - Stok Opname"; font-size: AppStyle.font-sm; font-weight: 700; color: AppStyle.text-primary; } Text { text: "Cek fisik vs sistem gudang"; font-size: AppStyle.font-xs; color: AppStyle.text-muted; } }
                    HorizontalLayout { alignment: space-between; Text { text: "F9 - Laporan Bisnis"; font-size: AppStyle.font-sm; font-weight: 700; color: AppStyle.text-primary; } Text { text: "Omzet, laba kotor & produk laris"; font-size: AppStyle.font-xs; color: AppStyle.text-muted; } }
                    HorizontalLayout { alignment: space-between; Text { text: "F11 - Buku Kas & Biaya"; font-size: AppStyle.font-sm; font-weight: 700; color: AppStyle.text-primary; } Text { text: "Arus kas operasional"; font-size: AppStyle.font-xs; color: AppStyle.text-muted; } }
                    HorizontalLayout { alignment: space-between; Text { text: "F12 - Shift Kasir"; font-size: AppStyle.font-sm; font-weight: 700; color: AppStyle.text-primary; } Text { text: "Buka / Tutup laci kasir"; font-size: AppStyle.font-xs; color: AppStyle.text-muted; } }
                }

                Rectangle {
                    height: 36px; background: AppStyle.primary; border-radius: 4px;
                    TouchArea { clicked => { root.show_modal_help = false; } }
                    Text { text: "TUTUP PANDUAN (ESC)"; font-size: AppStyle.font-xs; font-weight: 700; color: #ffffff; horizontal-alignment: center; vertical-alignment: center; }
                }
            }
        }
    }
}
