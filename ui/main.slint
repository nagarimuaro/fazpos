                        Rectangle {
                            width: 22px; height: 18px; border-radius: 2px;
                            background: root.active_view == 2 ? AppStyle.primary : AppStyle.bg;
                            border-width: 1px; border-color: root.active_view == 2 ? AppStyle.primary-dark : AppStyle.border;
                            Text { text: "F3"; font-size: 9px; font-weight: 800; color: root.active_view == 2 ? #ffffff : AppStyle.text-muted; horizontal-alignment: center; vertical-alignment: center; }
                        }
                        Text { text: "Retur Jual"; font-size: AppStyle.font-xs; font-weight: root.active_view == 2 ? 800 : 600; color: root.active_view == 2 ? AppStyle.primary-dark : AppStyle.text-primary; vertical-alignment: center; }
                    }
                }

                Rectangle { width: 1px; height: 24px; background: AppStyle.border; }

                // [F4] Pembelian
                Rectangle {
                    border-radius: 4px;
                    background: root.active_view == 3 ? AppStyle.primary-light : AppStyle.surface;
                    border-width: 1px;
                    border-color: root.active_view == 3 ? AppStyle.primary : AppStyle.border;
                    TouchArea { clicked => { root.active_view = 3; root.navigasi(3); } }
                    HorizontalLayout {
                        padding-left: 6px; padding-right: 8px; spacing: 4px; alignment: center;
                        Rectangle {
                            width: 22px; height: 18px; border-radius: 2px;
                            background: root.active_view == 3 ? AppStyle.primary : AppStyle.bg;
                            border-width: 1px; border-color: root.active_view == 3 ? AppStyle.primary-dark : AppStyle.border;
                            Text { text: "F4"; font-size: 9px; font-weight: 800; color: root.active_view == 3 ? #ffffff : AppStyle.text-muted; horizontal-alignment: center; vertical-alignment: center; }
                        }
                        Text { text: "Pembelian"; font-size: AppStyle.font-xs; font-weight: root.active_view == 3 ? 800 : 600; color: root.active_view == 3 ? AppStyle.primary-dark : AppStyle.text-primary; vertical-alignment: center; }
                    }
                }

                // [F5] Master Barang
                Rectangle {
                    border-radius: 4px;
                    background: root.active_view == 4 ? AppStyle.primary-light : AppStyle.surface;
                    border-width: 1px;
                    border-color: root.active_view == 4 ? AppStyle.primary : AppStyle.border;
                    TouchArea { clicked => { root.active_view = 4; root.navigasi(4); } }
                    HorizontalLayout {
                        padding-left: 6px; padding-right: 8px; spacing: 4px; alignment: center;
                        Rectangle {
                            width: 22px; height: 18px; border-radius: 2px;
                            background: root.active_view == 4 ? AppStyle.primary : AppStyle.bg;
                            border-width: 1px; border-color: root.active_view == 4 ? AppStyle.primary-dark : AppStyle.border;
                            Text { text: "F5"; font-size: 9px; font-weight: 800; color: root.active_view == 4 ? #ffffff : AppStyle.text-muted; horizontal-alignment: center; vertical-alignment: center; }
                        }
                        Text { text: "Data Barang"; font-size: AppStyle.font-xs; font-weight: root.active_view == 4 ? 800 : 600; color: root.active_view == 4 ? AppStyle.primary-dark : AppStyle.text-primary; vertical-alignment: center; }
                    }
                }

                // [F6] Pelanggan & Member
                Rectangle {
                    border-radius: 4px;
                    background: root.active_view == 5 ? AppStyle.primary-light : AppStyle.surface;
                    border-width: 1px;
                    border-color: root.active_view == 5 ? AppStyle.primary : AppStyle.border;
                    TouchArea { clicked => { root.active_view = 5; root.navigasi(5); } }
                    HorizontalLayout {
                        padding-left: 6px; padding-right: 8px; spacing: 4px; alignment: center;
                        Rectangle {
                            width: 22px; height: 18px; border-radius: 2px;
                            background: root.active_view == 5 ? AppStyle.primary : AppStyle.bg;
                            border-width: 1px; border-color: root.active_view == 5 ? AppStyle.primary-dark : AppStyle.border;
                            Text { text: "F6"; font-size: 9px; font-weight: 800; color: root.active_view == 5 ? #ffffff : AppStyle.text-muted; horizontal-alignment: center; vertical-alignment: center; }
                        }
                        Text { text: "Pelanggan"; font-size: AppStyle.font-xs; font-weight: root.active_view == 5 ? 800 : 600; color: root.active_view == 5 ? AppStyle.primary-dark : AppStyle.text-primary; vertical-alignment: center; }
                    }
                }

                // [F7] Supplier
                Rectangle {
                    border-radius: 4px;
                    background: root.active_view == 6 ? AppStyle.primary-light : AppStyle.surface;
                    border-width: 1px;
                    border-color: root.active_view == 6 ? AppStyle.primary : AppStyle.border;
