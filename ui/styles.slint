export global AppStyle {
    // Palette - Kinetic Desktop & Native Core Theme (iPos / High Performance Desktop)
    out property <color> primary: #0284c7;
    out property <color> primary-dark: #0369a1;
    out property <color> primary-light: #e0f2fe;
    out property <color> primary-border: #bae6fd;

    out property <color> header-bg: #0f172a;
    out property <color> header-border: #1e293b;
    out property <color> header-text: #f8fafc;
    out property <color> header-muted: #94a3b8;

    out property <color> tab-active-bg: #0284c7;
    out property <color> tab-badge-bg: #075985;
    out property <color> tab-badge-text: #bae6fd;

    out property <color> success: #059669;
    out property <color> success-hover: #047857;
    out property <color> success-bg: #ecfdf5;
    out property <color> success-border: #a7f3d0;
    out property <color> success-dark: #064e3b;

    out property <color> danger: #dc2626;
    out property <color> danger-bg: #fef2f2;
    out property <color> danger-border: #fecaca;

    out property <color> warning: #d97706;
    out property <color> warning-bg: #fffbeb;
    out property <color> warning-border: #fef3c7;

    out property <color> bg: #e2e8f0;
    out property <color> surface: #ffffff;
    out property <color> surface-low: #f8fafc;
    out property <color> row-alt: #f8fafc;
    out property <color> border: #cbd5e1;
    out property <color> border-subtle: #e2e8f0;
    out property <color> border-focus: #0284c7;

    out property <color> text-primary: #0f172a;
    out property <color> text-secondary: #475569;
    out property <color> text-muted: #64748b;

    // Spacing (kelipatan 4px)
    out property <length> space-xs: 4px;
    out property <length> space-sm: 8px;
    out property <length> space-md: 12px;
    out property <length> space-lg: 16px;
    out property <length> space-xl: 24px;

    // Tipografi Desktop Kerapatan Tinggi
    out property <length> font-xs: 10px;
    out property <length> font-sm: 11px;
    out property <length> font-body: 12px;
    out property <length> font-heading: 14px;
    out property <length> font-title: 16px;
    out property <length> font-display: 28px;

    // Dimensi Komponen Desktop
    out property <length> input-height: 32px;
    out property <length> button-height-primary: 40px;
    out property <length> button-height-secondary: 28px;
    out property <length> row-height-dense: 28px;
    out property <length> header-height: 38px;
}
