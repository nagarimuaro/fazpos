import { ProductGridData } from "../models.slint";

export component BarangView inherits Rectangle {
    background: transparent;

    in-out property <[ProductGridData]> products: [];
    in-out property <string> filter_barang: "";
    in-out property <int> total_item_barang: 0;
    in-out property <float> total_nilai_beli: 0.0;
    in-out property <float> total_nilai_jual: 0.0;

    in-out property <string> form_kode: "";
    in-out property <string> form_nama: "";
    in-out property <string> form_barcode: "";
    in-out property <string> form_kategori: "Umum";
    in-out property <string> form_satuan: "PCS";
    in-out property <string> form_hpp: "0";
    in-out property <string> form_jual: "0";
    in-out property <string> form_stok: "0";
    in-out property <bool> show_add_form: false;

    callback cari_barang(string);
    callback simpan_barang_baru(string, string, string, string, string, float, float, float);
    callback hapus_barang(string);

    VerticalLayout {
        spacing: 8px;

        // Header & Summary Bar
        Rectangle {
            height: 44px;
            background: #ffffff;
            border-radius: 4px;
            border-width: 1px;
            border-color: #e2e8f0;

            HorizontalLayout {
                padding-left: 14px; padding-right: 14px;
                alignment: space-between;

                HorizontalLayout {
                    spacing: 12px;
                    alignment: start;
                    Text { text: "Katalog Barang (" + root.total_item_barang + " item)"; font-size: 14px; font-weight: 700; color: #0f172a; vertical-alignment: center; }
                    Rectangle { width: 1px; background: #e2e8f0; }
                    Text { text: "Kategori: Semua"; font-size: 12px; color: #64748b; vertical-alignment: center; }
                }

                HorizontalLayout {
                    spacing: 20px;
                    alignment: end;
                    HorizontalLayout {
                        spacing: 6px;
                        Text { text: "Tot. Nilai Beli:"; font-size: 12px; color: #64748b; vertical-alignment: center; }
                        Text { text: "Rp " + root.total_nilai_beli; font-size: 12px; font-weight: 700; color: #0f172a; vertical-alignment: center; }
                    }
                    HorizontalLayout {
                        spacing: 6px;
                        Text { text: "Tot. Nilai Jual:"; font-size: 12px; color: #64748b; vertical-alignment: center; }
                        Text { text: "Rp " + root.total_nilai_jual; font-size: 12px; font-weight: 700; color: #15803d; vertical-alignment: center; }
                    }
                }
            }
        }

        // Form Tambah Produk
        if root.show_add_form: Rectangle {
            background: #ffffff;
            border-radius: 4px;
            border-width: 1px;
            border-color: #cbd5e1;

            VerticalLayout {
                padding: 10px;
                spacing: 8px;

                Text { text: "INPUT PRODUK BARU"; font-size: 11px; font-weight: 800; color: #0369a1; }

                HorizontalLayout {
                    spacing: 8px;

                    VerticalLayout {
                        spacing: 2px; width: 110px;
                        Text { text: "Kode Produk:"; font-size: 10px; color: #64748b; }
                        Rectangle { height: 28px; background: #f8fafc; border-radius: 3px; border-width: 1px; border-color: #cbd5e1; HorizontalLayout { padding-left: 6px; TextInput { text <=> root.form_kode; font-size: 12px; color: #0f172a; vertical-alignment: center; } } }
                    }
                    VerticalLayout {
                        spacing: 2px; horizontal-stretch: 2;
                        Text { text: "Nama Barang:"; font-size: 10px; color: #64748b; }
                        Rectangle { height: 28px; background: #f8fafc; border-radius: 3px; border-width: 1px; border-color: #cbd5e1; HorizontalLayout { padding-left: 6px; TextInput { text <=> root.form_nama; font-size: 12px; color: #0f172a; vertical-alignment: center; } } }
                    }
                    VerticalLayout {
                        spacing: 2px; width: 120px;
                        Text { text: "Barcode:"; font-size: 10px; color: #64748b; }
                        Rectangle { height: 28px; background: #f8fafc; border-radius: 3px; border-width: 1px; border-color: #cbd5e1; HorizontalLayout { padding-left: 6px; TextInput { text <=> root.form_barcode; font-size: 12px; color: #0f172a; vertical-alignment: center; } } }
                    }
                    VerticalLayout {
                        spacing: 2px; width: 90px;
                        Text { text: "Harga Pokok:"; font-size: 10px; color: #64748b; }
                        Rectangle { height: 28px; background: #f8fafc; border-radius: 3px; border-width: 1px; border-color: #cbd5e1; HorizontalLayout { padding-left: 6px; TextInput { text <=> root.form_hpp; font-size: 12px; color: #0f172a; vertical-alignment: center; } } }
                    }
                    VerticalLayout {
                        spacing: 2px; width: 95px;
                        Text { text: "Harga Jual 1:"; font-size: 10px; color: #64748b; }
                        Rectangle { height: 28px; background: #f8fafc; border-radius: 3px; border-width: 1px; border-color: #cbd5e1; HorizontalLayout { padding-left: 6px; TextInput { text <=> root.form_jual; font-size: 12px; color: #0f172a; vertical-alignment: center; } } }
                    }
                    VerticalLayout {
                        spacing: 2px; width: 65px;
                        Text { text: "Stok Awal:"; font-size: 10px; color: #64748b; }
                        Rectangle { height: 28px; background: #f8fafc; border-radius: 3px; border-width: 1px; border-color: #cbd5e1; HorizontalLayout { padding-left: 6px; TextInput { text <=> root.form_stok; font-size: 12px; color: #0f172a; vertical-alignment: center; } } }
                    }
                }

                HorizontalLayout {
                    spacing: 8px;
                    alignment: end;

                    Rectangle {
                        width: 90px; height: 28px; background: #16a34a; border-radius: 3px;
                        TouchArea { clicked => {
                            root.simpan_barang_baru(
                                root.form_kode,
                                root.form_nama,
                                root.form_barcode,
                                root.form_kategori,
                                root.form_satuan,
                                root.form_hpp.to-float(),
                                root.form_jual.to-float(),
                                root.form_stok.to-float()
                            );
                            root.form_kode = "";
                            root.form_nama = "";
                            root.form_barcode = "";
                            root.form_hpp = "0";
                            root.form_jual = "0";
                            root.form_stok = "0";
                            root.show_add_form = false;
                        } }
                        Text { text: "Simpan"; font-size: 11px; font-weight: 700; color: #ffffff; horizontal-alignment: center; vertical-alignment: center; }
                    }

                    Rectangle {
                        width: 80px; height: 28px; background: #e2e8f0; border-radius: 3px;
                        TouchArea { clicked => { root.show_add_form = false; } }
                        Text { text: "Batal"; font-size: 11px; font-weight: 600; color: #475569; horizontal-alignment: center; vertical-alignment: center; }
                    }
                }
            }
        }

        // Tabel Grid Master Barang
        Rectangle {
            background: #ffffff;
            border-radius: 4px;
            border-width: 1px;
            border-color: #e2e8f0;
            vertical-stretch: 1;

            VerticalLayout {
                padding: 4px;
                spacing: 1px;

                // Header Kolom Tabel
                Rectangle {
                    height: 30px;
                    background: #f8fafc;
                    border-width: 1px;
                    border-color: #e2e8f0;

                    HorizontalLayout {
                        padding-left: 8px; padding-right: 8px;
                        Text { width: 35px; text: "No."; font-size: 11px; font-weight: 700; color: #475569; vertical-alignment: center; }
                        Text { width: 90px; text: "Kode"; font-size: 11px; font-weight: 700; color: #475569; vertical-alignment: center; }
                        Text { horizontal-stretch: 2; text: "Nama Barang"; font-size: 11px; font-weight: 700; color: #475569; vertical-alignment: center; }
                        Text { width: 90px; text: "Kategori"; font-size: 11px; font-weight: 700; color: #475569; vertical-alignment: center; }
                        Text { width: 60px; text: "Stok"; font-size: 11px; font-weight: 700; color: #475569; horizontal-alignment: center; vertical-alignment: center; }
                        Text { width: 65px; text: "Stok Min"; font-size: 11px; font-weight: 700; color: #475569; horizontal-alignment: center; vertical-alignment: center; }
                        Text { width: 60px; text: "Satuan"; font-size: 11px; font-weight: 700; color: #475569; vertical-alignment: center; }
                        Text { width: 90px; text: "Harga Beli"; font-size: 11px; font-weight: 700; color: #475569; horizontal-alignment: right; vertical-alignment: center; }
                        Text { width: 95px; text: "Harga Jual 1"; font-size: 11px; font-weight: 700; color: #475569; horizontal-alignment: right; vertical-alignment: center; }
                        Text { width: 95px; text: "Harga Jual 2"; font-size: 11px; font-weight: 700; color: #475569; horizontal-alignment: right; vertical-alignment: center; }
                        Text { width: 95px; text: "Harga Jual 3"; font-size: 11px; font-weight: 700; color: #475569; horizontal-alignment: right; vertical-alignment: center; }
                        Text { width: 35px; text: ""; font-size: 11px; }
                    }
                }

                // Baris Data
                for p[idx] in root.products: Rectangle {
                    height: 32px;
                    background: p.is_kritis ? #fef3c7 : (Math.mod(idx, 2) == 0 ? #ffffff : #f8fafc);
                    border-width: 1px;
                    border-color: #f1f5f9;

                    HorizontalLayout {
                        padding-left: 8px; padding-right: 8px;
                        Text { width: 35px; text: "" + (idx + 1); font-size: 11px; color: p.is_kritis ? #92400e : #64748b; vertical-alignment: center; }
                        Text { width: 90px; text: p.kode; font-size: 12px; font-weight: 600; color: p.is_kritis ? #b45309 : #0284c7; vertical-alignment: center; }
                        Text { horizontal-stretch: 2; text: p.nama; font-size: 12px; font-weight: 500; color: #0f172a; vertical-alignment: center; }
                        Text { width: 90px; text: p.kategori; font-size: 11px; color: #64748b; vertical-alignment: center; }
                        Text { width: 60px; text: "" + p.stok; font-size: 12px; font-weight: 700; color: p.is_kritis ? #b45309 : #0284c7; horizontal-alignment: center; vertical-alignment: center; }
                        Text { width: 65px; text: "" + p.stokminimum; font-size: 11px; color: #64748b; horizontal-alignment: center; vertical-alignment: center; }
                        Text { width: 60px; text: p.satuan; font-size: 11px; color: #64748b; vertical-alignment: center; }
                        Text { width: 90px; text: "" + p.hargapokok; font-size: 12px; color: #334155; horizontal-alignment: right; vertical-alignment: center; }
                        Text { width: 95px; text: "" + p.hargajual1; font-size: 12px; font-weight: 700; color: #15803d; horizontal-alignment: right; vertical-alignment: center; }
                        Text { width: 95px; text: "" + p.hargajual2; font-size: 11px; color: #64748b; horizontal-alignment: right; vertical-alignment: center; }
                        Text { width: 95px; text: "" + p.hargajual3; font-size: 11px; color: #64748b; horizontal-alignment: right; vertical-alignment: center; }

                        // Tombol Hapus Produk
                        Rectangle {
                            width: 35px;
                            Rectangle {
                                width: 20px; height: 20px; background: #fee2e2; border-radius: 3px;
                                TouchArea { clicked => { root.hapus_barang(p.id); } }
                                Text { text: "X"; font-size: 10px; font-weight: 700; color: #dc2626; horizontal-alignment: center; vertical-alignment: center; }
                            }
                        }
                    }
                }

                if root.products.length == 0: Rectangle {
                    height: 200px;
                    Text { text: "Katalog produk kosong."; font-size: 13px; color: #94a3b8; horizontal-alignment: center; vertical-alignment: center; }
                }
            }
        }

        // Toolbar Bawah
        Rectangle {
            height: 42px;
            background: #ffffff;
            border-radius: 4px;
            border-width: 1px;
            border-color: #e2e8f0;

            HorizontalLayout {
                padding-left: 10px; padding-right: 10px;
                alignment: space-between;

                // Kiri: Tombol Tambah
                HorizontalLayout {
                    spacing: 8px;
                    Rectangle {
                        height: 28px; background: #0284c7; border-radius: 3px;
                        TouchArea { clicked => { root.show_add_form = !root.show_add_form; } }
                        HorizontalLayout { padding-left: 12px; padding-right: 12px; Text { text: root.show_add_form ? "Tutup Form" : "+ Tambah Produk"; font-size: 11px; font-weight: 700; color: #ffffff; vertical-alignment: center; } }
                    }
                }

                // Tengah: Pencarian
                HorizontalLayout {
                    spacing: 6px;
                    alignment: center;
                    Text { text: "Cari Produk:"; font-size: 11px; font-weight: 600; color: #475569; vertical-alignment: center; }
                    Rectangle {
                        width: 240px; height: 28px; background: #f8fafc; border-radius: 3px; border-width: 1px; border-color: #cbd5e1;
                        HorizontalLayout {
                            padding-left: 8px;
                            TextInput {
                                text <=> root.filter_barang;
                                font-size: 12px; color: #0f172a; vertical-alignment: center;
                                edited => { root.cari_barang(self.text); }
                            }
                        }
                    }
                }

                // Kanan: Refresh
                HorizontalLayout {
                    spacing: 8px;
                    alignment: end;
                    Rectangle {
                        height: 28px; background: #e2e8f0; border-radius: 3px;
                        TouchArea { clicked => { root.cari_barang(""); } }
                        HorizontalLayout { padding-left: 12px; padding-right: 12px; Text { text: "Refresh"; font-size: 11px; font-weight: 600; color: #334155; vertical-alignment: center; } }
                    }
                }
            }
        }
    }
}
