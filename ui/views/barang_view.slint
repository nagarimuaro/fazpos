import { ProductGridData } from "../models.slint";
import { AppStyle } from "../styles.slint";

export component BarangView inherits Rectangle {
    background: transparent;

    in-out property <[ProductGridData]> products: [];
    in-out property <string> filter_barang: "";
    in-out property <int> total_item_barang: 0;
    in-out property <float> total_nilai_beli: 0.0;
    in-out property <float> total_nilai_jual: 0.0;

    in-out property <string> form_kode: "";
    in-out property <string> form_nama: "";
    in-out property <string> form_barcode: "";
    in-out property <string> form_kategori: "Umum";
    in-out property <string> form_satuan: "PCS";
    in-out property <string> form_hpp: "0";
    in-out property <string> form_jual: "0";
    in-out property <string> form_stok: "0";
    in-out property <bool> show_add_form: false;

    callback cari_barang(string);
    callback simpan_barang_baru(string, string, string, string, string, float, float, float);
    callback hapus_barang(string);

    VerticalLayout {
        spacing: AppStyle.space-sm;

        // Header & Summary Bar (Anti AI-Slop)
        Rectangle {
            height: AppStyle.header-height;
            background: AppStyle.surface;
            border-radius: 4px;
            border-width: 1px;
            border-color: AppStyle.border;

            HorizontalLayout {
                padding-left: AppStyle.space-md; padding-right: AppStyle.space-md;
                alignment: space-between;

                HorizontalLayout {
                    spacing: AppStyle.space-md;
                    alignment: start;
                    Text { text: "Katalog Barang (" + root.total_item_barang + " item)"; font-size: AppStyle.font-body; font-weight: 700; color: AppStyle.text-primary; vertical-alignment: center; }
                    Rectangle { width: 1px; background: AppStyle.border; }
                    Text { text: "Kategori: Semua"; font-size: AppStyle.font-sm; color: AppStyle.text-muted; vertical-alignment: center; }
                }

                HorizontalLayout {
                    spacing: AppStyle.space-lg;
                    alignment: end;
                    HorizontalLayout {
                        spacing: 6px;
                        Text { text: "Tot. Nilai Beli:"; font-size: AppStyle.font-sm; color: AppStyle.text-muted; vertical-alignment: center; }
                        Text { text: "Rp " + root.total_nilai_beli; font-size: AppStyle.font-sm; font-weight: 700; color: AppStyle.text-primary; vertical-alignment: center; }
                    }
                    HorizontalLayout {
                        spacing: 6px;
                        Text { text: "Tot. Nilai Jual:"; font-size: AppStyle.font-sm; color: AppStyle.text-muted; vertical-alignment: center; }
                        Text { text: "Rp " + root.total_nilai_jual; font-size: AppStyle.font-sm; font-weight: 700; color: AppStyle.success; vertical-alignment: center; }
                    }
                }
            }
        }

        // Form Tambah Produk
        if root.show_add_form: Rectangle {
            background: AppStyle.surface;
            border-radius: 4px;
            border-width: 1px;
            border-color: AppStyle.border-focus;

            VerticalLayout {
                padding: AppStyle.space-sm;
                spacing: AppStyle.space-sm;

                Text { text: "INPUT / EDIT PRODUK"; font-size: AppStyle.font-xs; font-weight: 800; color: AppStyle.primary-dark; }

                HorizontalLayout {
                    spacing: AppStyle.space-sm;

                    VerticalLayout {
                        spacing: 2px; width: 110px;
                        Text { text: "Kode Produk:"; font-size: 10px; color: AppStyle.text-muted; }
                        Rectangle { height: 28px; background: AppStyle.bg; border-radius: 3px; border-width: 1px; border-color: AppStyle.border-focus; HorizontalLayout { padding-left: 6px; TextInput { text <=> root.form_kode; font-size: AppStyle.font-sm; color: AppStyle.text-primary; vertical-alignment: center; } } }
                    }
                    VerticalLayout {
                        spacing: 2px; horizontal-stretch: 2;
                        Text { text: "Nama Barang:"; font-size: 10px; color: AppStyle.text-muted; }
                        Rectangle { height: 28px; background: AppStyle.bg; border-radius: 3px; border-width: 1px; border-color: AppStyle.border-focus; HorizontalLayout { padding-left: 6px; TextInput { text <=> root.form_nama; font-size: AppStyle.font-sm; color: AppStyle.text-primary; vertical-alignment: center; } } }
                    }
                    VerticalLayout {
                        spacing: 2px; width: 120px;
                        Text { text: "Barcode:"; font-size: 10px; color: AppStyle.text-muted; }
                        Rectangle { height: 28px; background: AppStyle.bg; border-radius: 3px; border-width: 1px; border-color: AppStyle.border-focus; HorizontalLayout { padding-left: 6px; TextInput { text <=> root.form_barcode; font-size: AppStyle.font-sm; color: AppStyle.text-primary; vertical-alignment: center; } } }
                    }
                    VerticalLayout {
                        spacing: 2px; width: 90px;
                        Text { text: "Harga Pokok:"; font-size: 10px; color: AppStyle.text-muted; }
                        Rectangle { height: 28px; background: AppStyle.bg; border-radius: 3px; border-width: 1px; border-color: AppStyle.border-focus; HorizontalLayout { padding-left: 6px; TextInput { text <=> root.form_hpp; font-size: AppStyle.font-sm; color: AppStyle.text-primary; vertical-alignment: center; } } }
                    }
                    VerticalLayout {
                        spacing: 2px; width: 95px;
                        Text { text: "Harga Jual 1:"; font-size: 10px; color: AppStyle.text-muted; }
                        Rectangle { height: 28px; background: AppStyle.bg; border-radius: 3px; border-width: 1px; border-color: AppStyle.border-focus; HorizontalLayout { padding-left: 6px; TextInput { text <=> root.form_jual; font-size: AppStyle.font-sm; color: AppStyle.text-primary; vertical-alignment: center; } } }
                    }
                    VerticalLayout {
                        spacing: 2px; width: 65px;
                        Text { text: "Stok Awal:"; font-size: 10px; color: AppStyle.text-muted; }
                        Rectangle { height: 28px; background: AppStyle.bg; border-radius: 3px; border-width: 1px; border-color: AppStyle.border-focus; HorizontalLayout { padding-left: 6px; TextInput { text <=> root.form_stok; font-size: AppStyle.font-sm; color: AppStyle.text-primary; vertical-alignment: center; } } }
                    }
                }

                HorizontalLayout {
                    spacing: AppStyle.space-sm;
                    alignment: end;

                    Rectangle {
                        width: 90px; height: 28px; background: AppStyle.success; border-radius: 3px;
                        TouchArea { clicked => {
                            root.simpan_barang_baru(
                                root.form_kode,
                                root.form_nama,
                                root.form_barcode,
                                root.form_kategori,
                                root.form_satuan,
                                root.form_hpp.to-float(),
                                root.form_jual.to-float(),
                                root.form_stok.to-float()
                            );
                            root.form_kode = "";
                            root.form_nama = "";
                            root.form_barcode = "";
                            root.form_hpp = "0";
                            root.form_jual = "0";
                            root.form_stok = "0";
                            root.show_add_form = false;
                        } }
                        Text { text: "Simpan"; font-size: AppStyle.font-xs; font-weight: 700; color: #ffffff; horizontal-alignment: center; vertical-alignment: center; }
                    }

                    Rectangle {
                        width: 80px; height: 28px; background: AppStyle.border; border-radius: 3px;
                        TouchArea { clicked => { root.show_add_form = false; } }
                        Text { text: "Batal"; font-size: AppStyle.font-xs; font-weight: 600; color: AppStyle.text-secondary; horizontal-alignment: center; vertical-alignment: center; }
                    }
                }
            }
        }

        // Tabel Grid Master Barang (Data-Dense & Kerapatan Tinggi)
        Rectangle {
            background: AppStyle.surface;
            border-radius: 4px;
            border-width: 1px;
            border-color: AppStyle.border;
            vertical-stretch: 1;

            VerticalLayout {
                padding: 4px;
                spacing: 1px;

                // Header Kolom Tabel
                Rectangle {
                    height: 30px;
                    background: AppStyle.bg;
                    border-width: 1px;
                    border-color: AppStyle.border;

                    HorizontalLayout {
                        padding-left: 8px; padding-right: 8px;
                        Text { width: 35px; text: "No."; font-size: AppStyle.font-xs; font-weight: 700; color: AppStyle.text-secondary; vertical-alignment: center; }
                        Text { width: 90px; text: "Kode"; font-size: AppStyle.font-xs; font-weight: 700; color: AppStyle.text-secondary; vertical-alignment: center; }
                        Text { horizontal-stretch: 2; text: "Nama Barang"; font-size: AppStyle.font-xs; font-weight: 700; color: AppStyle.text-secondary; vertical-alignment: center; }
                        Text { width: 90px; text: "Kategori"; font-size: AppStyle.font-xs; font-weight: 700; color: AppStyle.text-secondary; vertical-alignment: center; }
                        Text { width: 60px; text: "Stok"; font-size: AppStyle.font-xs; font-weight: 700; color: AppStyle.text-secondary; horizontal-alignment: center; vertical-alignment: center; }
                        Text { width: 65px; text: "Stok Min"; font-size: AppStyle.font-xs; font-weight: 700; color: AppStyle.text-secondary; horizontal-alignment: center; vertical-alignment: center; }
                        Text { width: 60px; text: "Satuan"; font-size: AppStyle.font-xs; font-weight: 700; color: AppStyle.text-secondary; vertical-alignment: center; }
                        Text { width: 90px; text: "Harga Beli"; font-size: AppStyle.font-xs; font-weight: 700; color: AppStyle.text-secondary; horizontal-alignment: right; vertical-alignment: center; }
                        Text { width: 95px; text: "Harga Jual 1"; font-size: AppStyle.font-xs; font-weight: 700; color: AppStyle.text-secondary; horizontal-alignment: right; vertical-alignment: center; }
                        Text { width: 95px; text: "Harga Jual 2"; font-size: AppStyle.font-xs; font-weight: 700; color: AppStyle.text-secondary; horizontal-alignment: right; vertical-alignment: center; }
                        Text { width: 95px; text: "Harga Jual 3"; font-size: AppStyle.font-xs; font-weight: 700; color: AppStyle.text-secondary; horizontal-alignment: right; vertical-alignment: center; }
                        Text { width: 35px; text: ""; font-size: AppStyle.font-xs; }
                    }
                }

                // Baris Data
                for p[idx] in root.products: Rectangle {
                    height: AppStyle.row-height-dense;
                    background: p.is_kritis ? AppStyle.warning-bg : (Math.mod(idx, 2) == 0 ? AppStyle.surface : AppStyle.row-alt);
                    border-width: 1px;
                    border-color: p.is_kritis ? AppStyle.warning-border : AppStyle.border;

                    HorizontalLayout {
                        padding-left: 8px; padding-right: 8px;
                        Text { width: 35px; text: "" + (idx + 1); font-size: AppStyle.font-xs; color: p.is_kritis ? AppStyle.warning : AppStyle.text-muted; vertical-alignment: center; }
                        Text { width: 90px; text: p.kode; font-size: AppStyle.font-sm; font-weight: 600; color: p.is_kritis ? AppStyle.warning : AppStyle.primary; vertical-alignment: center; }
                        Text { horizontal-stretch: 2; text: p.nama; font-size: AppStyle.font-sm; font-weight: 500; color: AppStyle.text-primary; vertical-alignment: center; }
                        Text { width: 90px; text: p.kategori; font-size: AppStyle.font-xs; color: AppStyle.text-muted; vertical-alignment: center; }
                        Text { width: 60px; text: "" + p.stok; font-size: AppStyle.font-sm; font-weight: 700; color: p.is_kritis ? AppStyle.warning : AppStyle.primary; horizontal-alignment: center; vertical-alignment: center; }
                        Text { width: 65px; text: "" + p.stokminimum; font-size: AppStyle.font-xs; color: AppStyle.text-muted; horizontal-alignment: center; vertical-alignment: center; }
                        Text { width: 60px; text: p.satuan; font-size: AppStyle.font-xs; color: AppStyle.text-muted; vertical-alignment: center; }
                        Text { width: 90px; text: "" + p.hargapokok; font-size: AppStyle.font-sm; color: AppStyle.text-secondary; horizontal-alignment: right; vertical-alignment: center; }
                        Text { width: 95px; text: "" + p.hargajual1; font-size: AppStyle.font-sm; font-weight: 700; color: AppStyle.success; horizontal-alignment: right; vertical-alignment: center; }
                        Text { width: 95px; text: "" + p.hargajual2; font-size: AppStyle.font-xs; color: AppStyle.text-muted; horizontal-alignment: right; vertical-alignment: center; }
                        Text { width: 95px; text: "" + p.hargajual3; font-size: AppStyle.font-xs; color: AppStyle.text-muted; horizontal-alignment: right; vertical-alignment: center; }

                        // Tombol Hapus Produk
                        Rectangle {
                            width: 35px;
                            Rectangle {
                                width: 20px; height: 20px; background: AppStyle.danger-bg; border-radius: 3px; border-width: 1px; border-color: AppStyle.danger-border;
                                TouchArea { clicked => { root.hapus_barang(p.id); } }
                                Text { text: "X"; font-size: 10px; font-weight: 700; color: AppStyle.danger; horizontal-alignment: center; vertical-alignment: center; }
                            }
                        }
                    }
                }

                if root.products.length == 0: Rectangle {
                    height: 200px;
                    Text { text: "Katalog produk kosong."; font-size: AppStyle.font-body; color: AppStyle.text-muted; horizontal-alignment: center; vertical-alignment: center; }
                }
            }
        }

        // Toolbar Bawah
        Rectangle {
            height: 42px;
            background: AppStyle.surface;
            border-radius: 4px;
            border-width: 1px;
            border-color: AppStyle.border;

            HorizontalLayout {
                padding-left: 10px; padding-right: 10px;
                alignment: space-between;

                // Kiri: Tombol Tambah
                HorizontalLayout {
                    spacing: 8px;
                    Rectangle {
                        height: 28px; background: AppStyle.primary; border-radius: 3px;
                        TouchArea { clicked => { root.show_add_form = !root.show_add_form; } }
                        HorizontalLayout { padding-left: 12px; padding-right: 12px; Text { text: root.show_add_form ? "Tutup Form" : "+ Tambah Produk"; font-size: AppStyle.font-xs; font-weight: 700; color: #ffffff; vertical-alignment: center; } }
                    }
                }

                // Tengah: Pencarian
                HorizontalLayout {
                    spacing: 6px;
                    alignment: center;
                    Text { text: "Cari Produk:"; font-size: AppStyle.font-xs; font-weight: 600; color: AppStyle.text-secondary; vertical-alignment: center; }
                    Rectangle {
                        width: 240px; height: 28px; background: AppStyle.bg; border-radius: 3px; border-width: 1px; border-color: AppStyle.border-focus;
                        HorizontalLayout {
                            padding-left: 8px;
                            TextInput {
                                text <=> root.filter_barang;
                                font-size: AppStyle.font-sm; color: AppStyle.text-primary; vertical-alignment: center;
                                edited => { root.cari_barang(self.text); }
                            }
                        }
                    }
                }

                // Kanan: Refresh
                HorizontalLayout {
                    spacing: 8px;
                    alignment: end;
                    Rectangle {
                        height: 28px; background: AppStyle.border; border-radius: 3px;
                        TouchArea { clicked => { root.cari_barang(""); } }
                        HorizontalLayout { padding-left: 12px; padding-right: 12px; Text { text: "Refresh"; font-size: AppStyle.font-xs; font-weight: 600; color: AppStyle.text-secondary; vertical-alignment: center; } }
                    }
                }
            }
        }
    }
}
