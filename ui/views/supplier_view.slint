import { SupplierGridData } from "../models.slint";

export component SupplierView inherits Rectangle {
    background: transparent;

    in-out property <[SupplierGridData]> items: [];
    in-out property <string> form_kode: "";
    in-out property <string> form_nama: "";
    in-out property <string> form_telepon: "";
    in-out property <string> form_alamat: "";
    in-out property <string> form_rekening: "";
    in-out property <bool> show_form: false;

    callback tambah_supplier(string, string, string, string, string);
    callback hapus_supplier(string);
    callback refresh_supplier();

    VerticalLayout {
        spacing: 8px;

        Rectangle {
            height: 44px; background: #ffffff; border-radius: 4px; border-width: 1px; border-color: #e2e8f0;
            HorizontalLayout {
                padding-left: 14px; padding-right: 14px; alignment: space-between;
                Text { text: "Master Data Supplier & Vendor"; font-size: 14px; font-weight: 700; color: #0f172a; vertical-alignment: center; }

                HorizontalLayout {
                    spacing: 8px;
                    Rectangle {
                        height: 28px; background: #0284c7; border-radius: 3px;
                        TouchArea { clicked => { root.show_form = !root.show_form; } }
                        HorizontalLayout { padding-left: 12px; padding-right: 12px; Text { text: root.show_form ? "Tutup Form" : "+ Tambah Supplier"; font-size: 11px; font-weight: 700; color: #ffffff; vertical-alignment: center; } }
                    }
                    Rectangle {
                        height: 28px; background: #e2e8f0; border-radius: 3px;
                        TouchArea { clicked => { root.refresh_supplier(); } }
                        HorizontalLayout { padding-left: 10px; padding-right: 10px; Text { text: "Refresh"; font-size: 11px; font-weight: 600; color: #334155; vertical-alignment: center; } }
                    }
                }
            }
        }

        if root.show_form: Rectangle {
            background: #ffffff; border-radius: 4px; border-width: 1px; border-color: #cbd5e1;

            VerticalLayout {
                padding: 10px;
                spacing: 8px;
                HorizontalLayout {
                    spacing: 10px;
                    VerticalLayout {
                        spacing: 2px;
                        Text { text: "Kode Supplier:"; font-size: 11px; font-weight: 600; color: #475569; }
                        Rectangle { height: 30px; width: 120px; background: #f8fafc; border-radius: 4px; border-width: 1px; border-color: #cbd5e1; HorizontalLayout { padding-left: 6px; TextInput { text <=> root.form_kode; font-size: 12px; color: #0f172a; vertical-alignment: center; } } }
                    }
                    VerticalLayout {
                        spacing: 2px; horizontal-stretch: 1;
                        Text { text: "Nama Supplier / Vendor:"; font-size: 11px; font-weight: 600; color: #475569; }
                        Rectangle { height: 30px; background: #f8fafc; border-radius: 4px; border-width: 1px; border-color: #cbd5e1; HorizontalLayout { padding-left: 6px; TextInput { text <=> root.form_nama; font-size: 12px; color: #0f172a; vertical-alignment: center; } } }
                    }
                    VerticalLayout {
                        spacing: 2px; width: 140px;
                        Text { text: "No. HP / Telepon:"; font-size: 11px; font-weight: 600; color: #475569; }
                        Rectangle { height: 30px; background: #f8fafc; border-radius: 4px; border-width: 1px; border-color: #cbd5e1; HorizontalLayout { padding-left: 6px; TextInput { text <=> root.form_telepon; font-size: 12px; color: #0f172a; vertical-alignment: center; } } }
                    }
                    VerticalLayout {
                        spacing: 2px; width: 160px;
                        Text { text: "No. Rekening:"; font-size: 11px; font-weight: 600; color: #475569; }
                        Rectangle { height: 30px; background: #f8fafc; border-radius: 4px; border-width: 1px; border-color: #cbd5e1; HorizontalLayout { padding-left: 6px; TextInput { text <=> root.form_rekening; font-size: 12px; color: #0f172a; vertical-alignment: center; } } }
                    }
                }
                HorizontalLayout {
                    spacing: 10px;
                    VerticalLayout {
                        spacing: 2px; horizontal-stretch: 1;
                        Text { text: "Alamat Kantor / Gudang:"; font-size: 11px; font-weight: 600; color: #475569; }
                        Rectangle { height: 30px; background: #f8fafc; border-radius: 4px; border-width: 1px; border-color: #cbd5e1; HorizontalLayout { padding-left: 6px; TextInput { text <=> root.form_alamat; font-size: 12px; color: #0f172a; vertical-alignment: center; } } }
                    }
                    Rectangle {
                        width: 120px; height: 30px; background: #16a34a; border-radius: 4px;
                        TouchArea { clicked => {
                            root.tambah_supplier(root.form_kode, root.form_nama, root.form_telepon, root.form_alamat, root.form_rekening);
                            root.form_kode = "";
                            root.form_nama = "";
                            root.form_telepon = "";
                            root.form_alamat = "";
                            root.form_rekening = "";
                            root.show_form = false;
                        } }
                        Text { text: "Simpan Supplier"; font-size: 11px; font-weight: 700; color: #ffffff; horizontal-alignment: center; vertical-alignment: center; }
                    }
                }
            }
        }

        Rectangle {
            background: #ffffff; border-radius: 4px; border-width: 1px; border-color: #e2e8f0;
            vertical-stretch: 1;

            VerticalLayout {
                padding: 4px; spacing: 1px;
                Rectangle {
                    height: 30px; background: #f8fafc; border-width: 1px; border-color: #e2e8f0;
                    HorizontalLayout {
                        padding-left: 8px; padding-right: 8px;
                        Text { width: 35px; text: "No."; font-size: 11px; font-weight: 700; color: #475569; vertical-alignment: center; }
                        Text { width: 100px; text: "Kode"; font-size: 11px; font-weight: 700; color: #475569; vertical-alignment: center; }
                        Text { width: 180px; text: "Nama Supplier"; font-size: 11px; font-weight: 700; color: #475569; vertical-alignment: center; }
                        Text { width: 130px; text: "Telepon"; font-size: 11px; font-weight: 700; color: #475569; vertical-alignment: center; }
                        Text { horizontal-stretch: 1; text: "Alamat"; font-size: 11px; font-weight: 700; color: #475569; vertical-alignment: center; }
                        Text { width: 140px; text: "Rekening"; font-size: 11px; font-weight: 700; color: #475569; vertical-alignment: center; }
                        Text { width: 40px; text: "Hapus"; font-size: 11px; font-weight: 700; color: #475569; horizontal-alignment: center; vertical-alignment: center; }
                    }
                }

                for s[idx] in root.items: Rectangle {
                    height: 32px; background: Math.mod(idx, 2) == 0 ? #ffffff : #f8fafc; border-width: 1px; border-color: #f1f5f9;
                    HorizontalLayout {
                        padding-left: 8px; padding-right: 8px;
                        Text { width: 35px; text: "" + (idx + 1); font-size: 11px; color: #64748b; vertical-alignment: center; }
                        Text { width: 100px; text: s.kode; font-size: 12px; font-weight: 600; color: #0284c7; vertical-alignment: center; }
                        Text { width: 180px; text: s.nama; font-size: 12px; font-weight: 600; color: #0f172a; vertical-alignment: center; }
                        Text { width: 130px; text: s.telepon; font-size: 12px; color: #64748b; vertical-alignment: center; }
                        Text { horizontal-stretch: 1; text: s.alamat; font-size: 12px; color: #334155; vertical-alignment: center; }
                        Text { width: 140px; text: s.rekening; font-size: 12px; color: #64748b; vertical-alignment: center; }
                        Rectangle {
                            width: 40px;
                            Rectangle {
                                width: 20px; height: 20px; background: #fee2e2; border-radius: 3px;
                                TouchArea { clicked => { root.hapus_supplier(s.id); } }
                                Text { text: "X"; font-size: 10px; font-weight: 700; color: #dc2626; horizontal-alignment: center; vertical-alignment: center; }
                            }
                        }
                    }
                }

                if root.items.length == 0: Rectangle {
                    height: 180px;
                    Text { text: "Belum ada data supplier."; font-size: 13px; color: #94a3b8; horizontal-alignment: center; vertical-alignment: center; }
                }
            }
        }
    }
}
