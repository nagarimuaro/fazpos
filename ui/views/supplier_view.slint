import { SupplierGridData } from "../models.slint";
import { AppStyle } from "../styles.slint";

export component SupplierView inherits Rectangle {
    background: transparent;

    in-out property <[SupplierGridData]> items: [];
    in-out property <string> form_kode: "";
    in-out property <string> form_nama: "";
    in-out property <string> form_telepon: "";
    in-out property <string> form_alamat: "";
    in-out property <string> form_rekening: "";
    in-out property <bool> show_form: false;

    callback tambah_supplier(string, string, string, string, string);
    callback hapus_supplier(string);
    callback refresh_supplier();

    VerticalLayout {
        spacing: AppStyle.space-sm;

        Rectangle {
            height: AppStyle.header-height; background: AppStyle.surface; border-radius: 4px; border-width: 1px; border-color: AppStyle.border;
            HorizontalLayout {
                padding-left: AppStyle.space-md; padding-right: AppStyle.space-md; alignment: space-between;
                Text { text: "Master Data Supplier & Vendor"; font-size: AppStyle.font-body; font-weight: 700; color: AppStyle.text-primary; vertical-alignment: center; }

                HorizontalLayout {
                    spacing: AppStyle.space-sm;
                    Rectangle {
                        height: 28px; background: AppStyle.primary; border-radius: 3px;
                        TouchArea { clicked => { root.show_form = !root.show_form; } }
                        HorizontalLayout { padding-left: 12px; padding-right: 12px; Text { text: root.show_form ? "Tutup Form" : "+ Tambah Supplier"; font-size: AppStyle.font-xs; font-weight: 700; color: #ffffff; vertical-alignment: center; } }
                    }
                    Rectangle {
                        height: 28px; background: AppStyle.border; border-radius: 3px;
                        TouchArea { clicked => { root.refresh_supplier(); } }
                        HorizontalLayout { padding-left: 10px; padding-right: 10px; Text { text: "Refresh"; font-size: AppStyle.font-xs; font-weight: 600; color: AppStyle.text-secondary; vertical-alignment: center; } }
                    }
                }
            }
        }

        if root.show_form: Rectangle {
            background: AppStyle.surface; border-radius: 4px; border-width: 1px; border-color: AppStyle.border-focus;

            VerticalLayout {
                padding: AppStyle.space-sm;
                spacing: AppStyle.space-sm;
                HorizontalLayout {
                    spacing: 10px;
                    VerticalLayout {
                        spacing: 2px;
                        Text { text: "Kode Supplier:"; font-size: AppStyle.font-xs; font-weight: 600; color: AppStyle.text-secondary; }
                        Rectangle { height: 30px; width: 120px; background: AppStyle.bg; border-radius: 4px; border-width: 1px; border-color: AppStyle.border-focus; HorizontalLayout { padding-left: 6px; TextInput { text <=> root.form_kode; font-size: AppStyle.font-sm; color: AppStyle.text-primary; vertical-alignment: center; } } }
                    }
                    VerticalLayout {
                        spacing: 2px; horizontal-stretch: 1;
                        Text { text: "Nama Supplier / Vendor:"; font-size: AppStyle.font-xs; font-weight: 600; color: AppStyle.text-secondary; }
                        Rectangle { height: 30px; background: AppStyle.bg; border-radius: 4px; border-width: 1px; border-color: AppStyle.border-focus; HorizontalLayout { padding-left: 6px; TextInput { text <=> root.form_nama; font-size: AppStyle.font-sm; color: AppStyle.text-primary; vertical-alignment: center; } } }
                    }
                    VerticalLayout {
                        spacing: 2px; width: 140px;
                        Text { text: "No. HP / Telepon:"; font-size: AppStyle.font-xs; font-weight: 600; color: AppStyle.text-secondary; }
                        Rectangle { height: 30px; background: AppStyle.bg; border-radius: 4px; border-width: 1px; border-color: AppStyle.border-focus; HorizontalLayout { padding-left: 6px; TextInput { text <=> root.form_telepon; font-size: AppStyle.font-sm; color: AppStyle.text-primary; vertical-alignment: center; } } }
                    }
                    VerticalLayout {
                        spacing: 2px; width: 160px;
                        Text { text: "No. Rekening:"; font-size: AppStyle.font-xs; font-weight: 600; color: AppStyle.text-secondary; }
                        Rectangle { height: 30px; background: AppStyle.bg; border-radius: 4px; border-width: 1px; border-color: AppStyle.border-focus; HorizontalLayout { padding-left: 6px; TextInput { text <=> root.form_rekening; font-size: AppStyle.font-sm; color: AppStyle.text-primary; vertical-alignment: center; } } }
                    }
                }
                HorizontalLayout {
                    spacing: 10px;
                    VerticalLayout {
                        spacing: 2px; horizontal-stretch: 1;
                        Text { text: "Alamat Kantor / Gudang:"; font-size: AppStyle.font-xs; font-weight: 600; color: AppStyle.text-secondary; }
                        Rectangle { height: 30px; background: AppStyle.bg; border-radius: 4px; border-width: 1px; border-color: AppStyle.border-focus; HorizontalLayout { padding-left: 6px; TextInput { text <=> root.form_alamat; font-size: AppStyle.font-sm; color: AppStyle.text-primary; vertical-alignment: center; } } }
                    }
                    Rectangle {
                        width: 120px; height: 30px; background: AppStyle.success; border-radius: 4px;
                        TouchArea { clicked => {
                            root.tambah_supplier(root.form_kode, root.form_nama, root.form_telepon, root.form_alamat, root.form_rekening);
                            root.form_kode = "";
                            root.form_nama = "";
                            root.form_telepon = "";
                            root.form_alamat = "";
                            root.form_rekening = "";
                            root.show_form = false;
                        } }
                        Text { text: "Simpan Supplier"; font-size: AppStyle.font-xs; font-weight: 700; color: #ffffff; horizontal-alignment: center; vertical-alignment: center; }
                    }
                }
            }
        }

        Rectangle {
            background: AppStyle.surface; border-radius: 4px; border-width: 1px; border-color: AppStyle.border;
            vertical-stretch: 1;

            VerticalLayout {
                padding: 4px; spacing: 1px;
                Rectangle {
                    height: 30px; background: AppStyle.bg; border-width: 1px; border-color: AppStyle.border;
                    HorizontalLayout {
                        padding-left: 8px; padding-right: 8px;
                        Text { width: 35px; text: "No."; font-size: AppStyle.font-xs; font-weight: 700; color: AppStyle.text-secondary; vertical-alignment: center; }
                        Text { width: 100px; text: "Kode"; font-size: AppStyle.font-xs; font-weight: 700; color: AppStyle.text-secondary; vertical-alignment: center; }
                        Text { width: 180px; text: "Nama Supplier"; font-size: AppStyle.font-xs; font-weight: 700; color: AppStyle.text-secondary; vertical-alignment: center; }
                        Text { width: 130px; text: "Telepon"; font-size: AppStyle.font-xs; font-weight: 700; color: AppStyle.text-secondary; vertical-alignment: center; }
                        Text { horizontal-stretch: 1; text: "Alamat"; font-size: AppStyle.font-xs; font-weight: 700; color: AppStyle.text-secondary; vertical-alignment: center; }
                        Text { width: 140px; text: "Rekening"; font-size: AppStyle.font-xs; font-weight: 700; color: AppStyle.text-secondary; vertical-alignment: center; }
                        Text { width: 40px; text: "Hapus"; font-size: AppStyle.font-xs; font-weight: 700; color: AppStyle.text-secondary; horizontal-alignment: center; vertical-alignment: center; }
                    }
                }

                for s[idx] in root.items: Rectangle {
                    height: AppStyle.row-height-dense; background: Math.mod(idx, 2) == 0 ? AppStyle.surface : AppStyle.row-alt; border-width: 1px; border-color: AppStyle.border;
                    HorizontalLayout {
                        padding-left: 8px; padding-right: 8px;
                        Text { width: 35px; text: "" + (idx + 1); font-size: AppStyle.font-xs; color: AppStyle.text-muted; vertical-alignment: center; }
                        Text { width: 100px; text: s.kode; font-size: AppStyle.font-sm; font-weight: 600; color: AppStyle.primary; vertical-alignment: center; }
                        Text { width: 180px; text: s.nama; font-size: AppStyle.font-sm; font-weight: 600; color: AppStyle.text-primary; vertical-alignment: center; }
                        Text { width: 130px; text: s.telepon; font-size: AppStyle.font-sm; color: AppStyle.text-muted; vertical-alignment: center; }
                        Text { horizontal-stretch: 1; text: s.alamat; font-size: AppStyle.font-sm; color: AppStyle.text-secondary; vertical-alignment: center; }
                        Text { width: 140px; text: s.rekening; font-size: AppStyle.font-sm; color: AppStyle.text-muted; vertical-alignment: center; }
                        Rectangle {
                            width: 40px;
                            Rectangle {
                                width: 20px; height: 20px; background: AppStyle.danger-bg; border-radius: 3px; border-width: 1px; border-color: AppStyle.danger-border;
                                TouchArea { clicked => { root.hapus_supplier(s.id); } }
                                Text { text: "X"; font-size: 10px; font-weight: 700; color: AppStyle.danger; horizontal-alignment: center; vertical-alignment: center; }
                            }
                        }
                    }
                }

                if root.items.length == 0: Rectangle {
                    height: 180px;
                    Text { text: "Belum ada data supplier."; font-size: AppStyle.font-body; color: AppStyle.text-muted; horizontal-alignment: center; vertical-alignment: center; }
                }
            }
        }
    }
}
