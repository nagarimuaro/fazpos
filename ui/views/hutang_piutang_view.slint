import { HutangGridData } from "../models.slint";
import { AppStyle } from "../styles.slint";

export component HutangPiutangView inherits Rectangle {
    background: transparent;

    in-out property <int> active_tab: 0; // 0: Hutang Supplier, 1: Piutang Pelanggan
    in-out property <[HutangGridData]> hutang_items: [];
    in-out property <[HutangGridData]> piutang_items: [];
    in-out property <string> input_bayar_nominal: "0";

    callback bayar_hutang(string, float);
    callback bayar_piutang(string, float);
    callback refresh_data();

    VerticalLayout {
        spacing: AppStyle.space-sm;

        Rectangle {
            height: AppStyle.header-height; background: AppStyle.surface; border-radius: 4px; border-width: 1px; border-color: AppStyle.border;
            HorizontalLayout {
                padding-left: AppStyle.space-md; padding-right: AppStyle.space-md; alignment: space-between;

                HorizontalLayout {
                    spacing: AppStyle.space-sm;
                    Rectangle {
                        height: 28px; border-radius: 3px;
                        background: root.active_tab == 0 ? AppStyle.primary : AppStyle.border;
                        TouchArea { clicked => { root.active_tab = 0; } }
                        HorizontalLayout { padding-left: 12px; padding-right: 12px; Text { text: "Hutang ke Supplier"; font-size: AppStyle.font-xs; font-weight: 700; color: root.active_tab == 0 ? #ffffff : AppStyle.text-secondary; vertical-alignment: center; } }
                    }
                    Rectangle {
                        height: 28px; border-radius: 3px;
                        background: root.active_tab == 1 ? AppStyle.primary : AppStyle.border;
                        TouchArea { clicked => { root.active_tab = 1; } }
                        HorizontalLayout { padding-left: 12px; padding-right: 12px; Text { text: "Piutang dari Pelanggan"; font-size: AppStyle.font-xs; font-weight: 700; color: root.active_tab == 1 ? #ffffff : AppStyle.text-secondary; vertical-alignment: center; } }
                    }
                }

                Rectangle {
                    height: 28px; background: AppStyle.border; border-radius: 3px;
                    TouchArea { clicked => { root.refresh_data(); } }
                    HorizontalLayout { padding-left: 10px; padding-right: 10px; Text { text: "Refresh"; font-size: AppStyle.font-xs; font-weight: 600; color: AppStyle.text-secondary; vertical-alignment: center; } }
                }
            }
        }

        // Tabel Data
        Rectangle {
            background: AppStyle.surface; border-radius: 4px; border-width: 1px; border-color: AppStyle.border;
            vertical-stretch: 1;

            VerticalLayout {
                padding: 4px; spacing: 1px;
                Rectangle {
                    height: 30px; background: AppStyle.bg; border-width: 1px; border-color: AppStyle.border;
                    HorizontalLayout {
                        padding-left: 8px; padding-right: 8px;
                        Text { width: 35px; text: "No."; font-size: AppStyle.font-xs; font-weight: 700; color: AppStyle.text-secondary; vertical-alignment: center; }
                        Text { width: 160px; text: "Faktur"; font-size: AppStyle.font-xs; font-weight: 700; color: AppStyle.text-secondary; vertical-alignment: center; }
                        Text { horizontal-stretch: 1; text: root.active_tab == 0 ? "Nama Supplier" : "Nama Pelanggan"; font-size: AppStyle.font-xs; font-weight: 700; color: AppStyle.text-secondary; vertical-alignment: center; }
                        Text { width: 140px; text: "Tanggal"; font-size: AppStyle.font-xs; font-weight: 700; color: AppStyle.text-secondary; vertical-alignment: center; }
                        Text { width: 120px; text: "Tagihan Awal"; font-size: AppStyle.font-xs; font-weight: 700; color: AppStyle.text-secondary; horizontal-alignment: right; vertical-alignment: center; }
                        Text { width: 120px; text: "Telah Dibayar"; font-size: AppStyle.font-xs; font-weight: 700; color: AppStyle.text-secondary; horizontal-alignment: right; vertical-alignment: center; }
                        Text { width: 120px; text: "Sisa Tagihan"; font-size: AppStyle.font-xs; font-weight: 700; color: AppStyle.text-secondary; horizontal-alignment: right; vertical-alignment: center; }
                        Text { width: 90px; text: "Status"; font-size: AppStyle.font-xs; font-weight: 700; color: AppStyle.text-secondary; horizontal-alignment: center; vertical-alignment: center; }
                        Text { width: 80px; text: "Aksi"; font-size: AppStyle.font-xs; font-weight: 700; color: AppStyle.text-secondary; horizontal-alignment: center; vertical-alignment: center; }
                    }
                }

                // Baris Hutang
                if root.active_tab == 0: VerticalLayout {
                    for h[idx] in root.hutang_items: Rectangle {
                        height: AppStyle.row-height-dense; background: Math.mod(idx, 2) == 0 ? AppStyle.surface : AppStyle.row-alt; border-width: 1px; border-color: AppStyle.border;
                        HorizontalLayout {
                            padding-left: 8px; padding-right: 8px;
                            Text { width: 35px; text: "" + (idx + 1); font-size: AppStyle.font-xs; color: AppStyle.text-muted; vertical-alignment: center; }
                            Text { width: 160px; text: h.faktur; font-size: AppStyle.font-sm; font-weight: 600; color: AppStyle.primary; vertical-alignment: center; }
                            Text { horizontal-stretch: 1; text: h.pihak; font-size: AppStyle.font-sm; color: AppStyle.text-primary; vertical-alignment: center; }
                            Text { width: 140px; text: h.tanggal; font-size: AppStyle.font-xs; color: AppStyle.text-muted; vertical-alignment: center; }
                            Text { width: 120px; text: "Rp " + h.tagihan; font-size: AppStyle.font-sm; color: AppStyle.text-secondary; horizontal-alignment: right; vertical-alignment: center; }
                            Text { width: 120px; text: "Rp " + h.dibayar; font-size: AppStyle.font-sm; color: AppStyle.success; horizontal-alignment: right; vertical-alignment: center; }
                            Text { width: 120px; text: "Rp " + h.sisa; font-size: AppStyle.font-sm; font-weight: 700; color: AppStyle.danger; horizontal-alignment: right; vertical-alignment: center; }
                            Text { width: 90px; text: h.status == "lunas" ? "LUNAS" : "TEMPO"; font-size: 10px; font-weight: 700; color: h.status == "lunas" ? AppStyle.success : AppStyle.warning; horizontal-alignment: center; vertical-alignment: center; }
                            Rectangle {
                                width: 80px;
                                if h.sisa > 0: Rectangle {
                                    width: 70px; height: 22px; background: AppStyle.success-bg; border-radius: 3px; border-width: 1px; border-color: AppStyle.success-border;
                                    TouchArea { clicked => { root.bayar_hutang(h.id, h.sisa); } }
                                    Text { text: "Lunasi"; font-size: 10px; font-weight: 700; color: AppStyle.success; horizontal-alignment: center; vertical-alignment: center; }
                                }
                            }
                        }
                    }
                    if root.hutang_items.length == 0: Rectangle { height: 140px; Text { text: "Tidak ada hutang aktif."; font-size: AppStyle.font-body; color: AppStyle.text-muted; horizontal-alignment: center; vertical-alignment: center; } }
                }

                // Baris Piutang
                if root.active_tab == 1: VerticalLayout {
                    for p[idx] in root.piutang_items: Rectangle {
                        height: AppStyle.row-height-dense; background: Math.mod(idx, 2) == 0 ? AppStyle.surface : AppStyle.row-alt; border-width: 1px; border-color: AppStyle.border;
                        HorizontalLayout {
                            padding-left: 8px; padding-right: 8px;
                            Text { width: 35px; text: "" + (idx + 1); font-size: AppStyle.font-xs; color: AppStyle.text-muted; vertical-alignment: center; }
                            Text { width: 160px; text: p.faktur; font-size: AppStyle.font-sm; font-weight: 600; color: AppStyle.primary; vertical-alignment: center; }
                            Text { horizontal-stretch: 1; text: p.pihak; font-size: AppStyle.font-sm; color: AppStyle.text-primary; vertical-alignment: center; }
                            Text { width: 140px; text: p.tanggal; font-size: AppStyle.font-xs; color: AppStyle.text-muted; vertical-alignment: center; }
                            Text { width: 120px; text: "Rp " + p.tagihan; font-size: AppStyle.font-sm; color: AppStyle.text-secondary; horizontal-alignment: right; vertical-alignment: center; }
                            Text { width: 120px; text: "Rp " + p.dibayar; font-size: AppStyle.font-sm; color: AppStyle.success; horizontal-alignment: right; vertical-alignment: center; }
                            Text { width: 120px; text: "Rp " + p.sisa; font-size: AppStyle.font-sm; font-weight: 700; color: AppStyle.danger; horizontal-alignment: right; vertical-alignment: center; }
                            Text { width: 90px; text: p.status == "lunas" ? "LUNAS" : "TEMPO"; font-size: 10px; font-weight: 700; color: p.status == "lunas" ? AppStyle.success : AppStyle.warning; horizontal-alignment: center; vertical-alignment: center; }
                            Rectangle {
                                width: 80px;
                                if p.sisa > 0: Rectangle {
                                    width: 70px; height: 22px; background: AppStyle.primary-light; border-radius: 3px; border-width: 1px; border-color: AppStyle.primary-border;
                                    TouchArea { clicked => { root.bayar_piutang(p.id, p.sisa); } }
                                    Text { text: "Terima"; font-size: 10px; font-weight: 700; color: AppStyle.primary-dark; horizontal-alignment: center; vertical-alignment: center; }
                                }
                            }
                        }
                    }
                    if root.piutang_items.length == 0: Rectangle { height: 140px; Text { text: "Tidak ada piutang aktif."; font-size: AppStyle.font-body; color: AppStyle.text-muted; horizontal-alignment: center; vertical-alignment: center; } }
                }
            }
        }
    }
}
