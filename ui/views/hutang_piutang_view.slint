import { HutangGridData } from "../models.slint";

export component HutangPiutangView inherits Rectangle {
    background: transparent;

    in-out property <int> active_tab: 0; // 0: Hutang Supplier, 1: Piutang Pelanggan
    in-out property <[HutangGridData]> hutang_items: [];
    in-out property <[HutangGridData]> piutang_items: [];
    in-out property <string> input_bayar_nominal: "0";

    callback bayar_hutang(string, float);
    callback bayar_piutang(string, float);
    callback refresh_data();

    VerticalLayout {
        spacing: 8px;

        Rectangle {
            height: 44px; background: #ffffff; border-radius: 4px; border-width: 1px; border-color: #e2e8f0;
            HorizontalLayout {
                padding-left: 14px; padding-right: 14px; alignment: space-between;

                HorizontalLayout {
                    spacing: 8px;
                    Rectangle {
                        height: 28px; border-radius: 3px;
                        background: root.active_tab == 0 ? #0284c7 : #e2e8f0;
                        TouchArea { clicked => { root.active_tab = 0; } }
                        HorizontalLayout { padding-left: 12px; padding-right: 12px; Text { text: "Hutang ke Supplier"; font-size: 11px; font-weight: 700; color: root.active_tab == 0 ? #ffffff : #334155; vertical-alignment: center; } }
                    }
                    Rectangle {
                        height: 28px; border-radius: 3px;
                        background: root.active_tab == 1 ? #0284c7 : #e2e8f0;
                        TouchArea { clicked => { root.active_tab = 1; } }
                        HorizontalLayout { padding-left: 12px; padding-right: 12px; Text { text: "Piutang dari Pelanggan"; font-size: 11px; font-weight: 700; color: root.active_tab == 1 ? #ffffff : #334155; vertical-alignment: center; } }
                    }
                }

                Rectangle {
                    height: 28px; background: #e2e8f0; border-radius: 3px;
                    TouchArea { clicked => { root.refresh_data(); } }
                    HorizontalLayout { padding-left: 10px; padding-right: 10px; Text { text: "Refresh"; font-size: 11px; font-weight: 600; color: #334155; vertical-alignment: center; } }
                }
            }
        }

        // Tabel Data
        Rectangle {
            background: #ffffff; border-radius: 4px; border-width: 1px; border-color: #e2e8f0;
            vertical-stretch: 1;

            VerticalLayout {
                padding: 4px; spacing: 1px;
                Rectangle {
                    height: 30px; background: #f8fafc; border-width: 1px; border-color: #e2e8f0;
                    HorizontalLayout {
                        padding-left: 8px; padding-right: 8px;
                        Text { width: 35px; text: "No."; font-size: 11px; font-weight: 700; color: #475569; vertical-alignment: center; }
                        Text { width: 160px; text: "Faktur"; font-size: 11px; font-weight: 700; color: #475569; vertical-alignment: center; }
                        Text { horizontal-stretch: 1; text: root.active_tab == 0 ? "Nama Supplier" : "Nama Pelanggan"; font-size: 11px; font-weight: 700; color: #475569; vertical-alignment: center; }
                        Text { width: 140px; text: "Tanggal"; font-size: 11px; font-weight: 700; color: #475569; vertical-alignment: center; }
                        Text { width: 120px; text: "Tagihan Awal"; font-size: 11px; font-weight: 700; color: #475569; horizontal-alignment: right; vertical-alignment: center; }
                        Text { width: 120px; text: "Telah Dibayar"; font-size: 11px; font-weight: 700; color: #475569; horizontal-alignment: right; vertical-alignment: center; }
                        Text { width: 120px; text: "Sisa Tagihan"; font-size: 11px; font-weight: 700; color: #475569; horizontal-alignment: right; vertical-alignment: center; }
                        Text { width: 90px; text: "Status"; font-size: 11px; font-weight: 700; color: #475569; horizontal-alignment: center; vertical-alignment: center; }
                        Text { width: 80px; text: "Aksi"; font-size: 11px; font-weight: 700; color: #475569; horizontal-alignment: center; vertical-alignment: center; }
                    }
                }

                // Baris Hutang
                if root.active_tab == 0: VerticalLayout {
                    for h[idx] in root.hutang_items: Rectangle {
                        height: 32px; background: Math.mod(idx, 2) == 0 ? #ffffff : #f8fafc; border-width: 1px; border-color: #f1f5f9;
                        HorizontalLayout {
                            padding-left: 8px; padding-right: 8px;
                            Text { width: 35px; text: "" + (idx + 1); font-size: 11px; color: #64748b; vertical-alignment: center; }
                            Text { width: 160px; text: h.faktur; font-size: 12px; font-weight: 600; color: #0284c7; vertical-alignment: center; }
                            Text { horizontal-stretch: 1; text: h.pihak; font-size: 12px; color: #0f172a; vertical-alignment: center; }
                            Text { width: 140px; text: h.tanggal; font-size: 11px; color: #64748b; vertical-alignment: center; }
                            Text { width: 120px; text: "Rp " + h.tagihan; font-size: 12px; color: #334155; horizontal-alignment: right; vertical-alignment: center; }
                            Text { width: 120px; text: "Rp " + h.dibayar; font-size: 12px; color: #15803d; horizontal-alignment: right; vertical-alignment: center; }
                            Text { width: 120px; text: "Rp " + h.sisa; font-size: 12px; font-weight: 700; color: #dc2626; horizontal-alignment: right; vertical-alignment: center; }
                            Text { width: 90px; text: h.status == "lunas" ? "LUNAS" : "TEMPO"; font-size: 11px; font-weight: 700; color: h.status == "lunas" ? #15803d : #b45309; horizontal-alignment: center; vertical-alignment: center; }
                            Rectangle {
                                width: 80px;
                                if h.sisa > 0: Rectangle {
                                    width: 70px; height: 22px; background: #dcfce7; border-radius: 3px;
                                    TouchArea { clicked => { root.bayar_hutang(h.id, h.sisa); } }
                                    Text { text: "Lunasi"; font-size: 10px; font-weight: 700; color: #15803d; horizontal-alignment: center; vertical-alignment: center; }
                                }
                            }
                        }
                    }
                    if root.hutang_items.length == 0: Rectangle { height: 140px; Text { text: "Tidak ada hutang aktif."; font-size: 12px; color: #94a3b8; horizontal-alignment: center; vertical-alignment: center; } }
                }

                // Baris Piutang
                if root.active_tab == 1: VerticalLayout {
                    for p[idx] in root.piutang_items: Rectangle {
                        height: 32px; background: Math.mod(idx, 2) == 0 ? #ffffff : #f8fafc; border-width: 1px; border-color: #f1f5f9;
                        HorizontalLayout {
                            padding-left: 8px; padding-right: 8px;
                            Text { width: 35px; text: "" + (idx + 1); font-size: 11px; color: #64748b; vertical-alignment: center; }
                            Text { width: 160px; text: p.faktur; font-size: 12px; font-weight: 600; color: #0284c7; vertical-alignment: center; }
                            Text { horizontal-stretch: 1; text: p.pihak; font-size: 12px; color: #0f172a; vertical-alignment: center; }
                            Text { width: 140px; text: p.tanggal; font-size: 11px; color: #64748b; vertical-alignment: center; }
                            Text { width: 120px; text: "Rp " + p.tagihan; font-size: 12px; color: #334155; horizontal-alignment: right; vertical-alignment: center; }
                            Text { width: 120px; text: "Rp " + p.dibayar; font-size: 12px; color: #15803d; horizontal-alignment: right; vertical-alignment: center; }
                            Text { width: 120px; text: "Rp " + p.sisa; font-size: 12px; font-weight: 700; color: #dc2626; horizontal-alignment: right; vertical-alignment: center; }
                            Text { width: 90px; text: p.status == "lunas" ? "LUNAS" : "TEMPO"; font-size: 11px; font-weight: 700; color: p.status == "lunas" ? #15803d : #b45309; horizontal-alignment: center; vertical-alignment: center; }
                            Rectangle {
                                width: 80px;
                                if p.sisa > 0: Rectangle {
                                    width: 70px; height: 22px; background: #e0f2fe; border-radius: 3px;
                                    TouchArea { clicked => { root.bayar_piutang(p.id, p.sisa); } }
                                    Text { text: "Terima"; font-size: 10px; font-weight: 700; color: #0369a1; horizontal-alignment: center; vertical-alignment: center; }
                                }
                            }
                        }
                    }
                    if root.piutang_items.length == 0: Rectangle { height: 140px; Text { text: "Tidak ada piutang aktif."; font-size: 12px; color: #94a3b8; horizontal-alignment: center; vertical-alignment: center; } }
                }
            }
        }
    }
}
