import { TransactionGridData } from "../models.slint";

export component RiwayatView inherits Rectangle {
    background: transparent;

    in-out property <[TransactionGridData]> items: [];
    in-out property <float> total_omzet: 0.0;

    callback cetak_struk(string);
    callback refresh_riwayat();

    VerticalLayout {
        spacing: 8px;

        Rectangle {
            height: 44px; background: #ffffff; border-radius: 4px; border-width: 1px; border-color: #e2e8f0;
            HorizontalLayout {
                padding-left: 14px; padding-right: 14px; alignment: space-between;
                Text { text: "Riwayat Penjualan & Transaksi"; font-size: 14px; font-weight: 700; color: #0f172a; vertical-alignment: center; }
                HorizontalLayout {
                    spacing: 16px;
                    Text { text: "Total Omzet: Rp " + root.total_omzet; font-size: 13px; font-weight: 700; color: #15803d; vertical-alignment: center; }
                    Rectangle {
                        height: 28px; background: #e2e8f0; border-radius: 3px;
                        TouchArea { clicked => { root.refresh_riwayat(); } }
                        HorizontalLayout { padding-left: 10px; padding-right: 10px; Text { text: "Refresh"; font-size: 11px; font-weight: 600; color: #334155; vertical-alignment: center; } }
                    }
                }
            }
        }

        Rectangle {
            background: #ffffff; border-radius: 4px; border-width: 1px; border-color: #e2e8f0;
            vertical-stretch: 1;

            VerticalLayout {
                padding: 4px; spacing: 1px;
                Rectangle {
                    height: 30px; background: #f8fafc; border-width: 1px; border-color: #e2e8f0;
                    HorizontalLayout {
                        padding-left: 8px; padding-right: 8px;
                        Text { width: 35px; text: "No."; font-size: 11px; font-weight: 700; color: #475569; vertical-alignment: center; }
                        Text { width: 170px; text: "Faktur"; font-size: 11px; font-weight: 700; color: #475569; vertical-alignment: center; }
                        Text { horizontal-stretch: 1; text: "Tanggal"; font-size: 11px; font-weight: 700; color: #475569; vertical-alignment: center; }
                        Text { width: 90px; text: "Metode"; font-size: 11px; font-weight: 700; color: #475569; vertical-alignment: center; }
                        Text { width: 90px; text: "Kasir"; font-size: 11px; font-weight: 700; color: #475569; vertical-alignment: center; }
                        Text { width: 120px; text: "Total"; font-size: 11px; font-weight: 700; color: #475569; horizontal-alignment: right; vertical-alignment: center; }
                        Text { width: 90px; text: "Aksi"; font-size: 11px; font-weight: 700; color: #475569; horizontal-alignment: center; vertical-alignment: center; }
                    }
                }

                for h[idx] in root.items: Rectangle {
                    height: 32px; background: Math.mod(idx, 2) == 0 ? #ffffff : #f8fafc; border-width: 1px; border-color: #f1f5f9;
                    HorizontalLayout {
                        padding-left: 8px; padding-right: 8px;
                        Text { width: 35px; text: "" + (idx + 1); font-size: 11px; color: #64748b; vertical-alignment: center; }
                        Text { width: 170px; text: h.faktur; font-size: 12px; font-weight: 600; color: #0284c7; vertical-alignment: center; }
                        Text { horizontal-stretch: 1; text: h.tanggal; font-size: 12px; color: #334155; vertical-alignment: center; }
                        Text { width: 90px; text: h.metode; font-size: 11px; color: #64748b; vertical-alignment: center; }
                        Text { width: 90px; text: h.kasir; font-size: 11px; color: #334155; vertical-alignment: center; }
                        Text { width: 120px; text: "Rp " + h.total; font-size: 12px; font-weight: 700; color: #15803d; horizontal-alignment: right; vertical-alignment: center; }

                        Rectangle {
                            width: 90px;
                            Rectangle {
                                width: 75px; height: 22px; background: #e0f2fe; border-radius: 3px;
                                TouchArea { clicked => { root.cetak_struk(h.faktur); } }
                                Text { text: "Cetak Struk"; font-size: 10px; font-weight: 700; color: #0369a1; horizontal-alignment: center; vertical-alignment: center; }
                            }
                        }
                    }
                }

                if root.items.length == 0: Rectangle {
                    height: 180px;
                    Text { text: "Belum ada riwayat transaksi penjualan."; font-size: 13px; color: #94a3b8; horizontal-alignment: center; vertical-alignment: center; }
                }
            }
        }
    }
}
