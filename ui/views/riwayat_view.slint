import { TransactionGridData } from "../models.slint";
import { AppStyle } from "../styles.slint";

export component RiwayatView inherits Rectangle {
    background: transparent;

    in-out property <[TransactionGridData]> items: [];
    in-out property <float> total_omzet: 0.0;

    callback cetak_struk(string);
    callback refresh_riwayat();

    VerticalLayout {
        spacing: AppStyle.space-sm;

        Rectangle {
            height: AppStyle.header-height; background: AppStyle.surface; border-radius: 4px; border-width: 1px; border-color: AppStyle.border;
            HorizontalLayout {
                padding-left: AppStyle.space-md; padding-right: AppStyle.space-md; alignment: space-between;
                Text { text: "Riwayat Penjualan & Transaksi"; font-size: AppStyle.font-body; font-weight: 700; color: AppStyle.text-primary; vertical-alignment: center; }
                HorizontalLayout {
                    spacing: AppStyle.space-lg;
                    Text { text: "Total Omzet: Rp " + root.total_omzet; font-size: AppStyle.font-sm; font-weight: 700; color: AppStyle.success; vertical-alignment: center; }
                    Rectangle {
                        height: 28px; background: AppStyle.border; border-radius: 3px;
                        TouchArea { clicked => { root.refresh_riwayat(); } }
                        HorizontalLayout { padding-left: 10px; padding-right: 10px; Text { text: "Refresh"; font-size: AppStyle.font-xs; font-weight: 600; color: AppStyle.text-secondary; vertical-alignment: center; } }
                    }
                }
            }
        }

        Rectangle {
            background: AppStyle.surface; border-radius: 4px; border-width: 1px; border-color: AppStyle.border;
            vertical-stretch: 1;

            VerticalLayout {
                padding: 4px; spacing: 1px;
                Rectangle {
                    height: 30px; background: AppStyle.bg; border-width: 1px; border-color: AppStyle.border;
                    HorizontalLayout {
                        padding-left: 8px; padding-right: 8px;
                        Text { width: 35px; text: "No."; font-size: AppStyle.font-xs; font-weight: 700; color: AppStyle.text-secondary; vertical-alignment: center; }
                        Text { width: 170px; text: "Faktur"; font-size: AppStyle.font-xs; font-weight: 700; color: AppStyle.text-secondary; vertical-alignment: center; }
                        Text { horizontal-stretch: 1; text: "Tanggal"; font-size: AppStyle.font-xs; font-weight: 700; color: AppStyle.text-secondary; vertical-alignment: center; }
                        Text { width: 90px; text: "Metode"; font-size: AppStyle.font-xs; font-weight: 700; color: AppStyle.text-secondary; vertical-alignment: center; }
                        Text { width: 90px; text: "Kasir"; font-size: AppStyle.font-xs; font-weight: 700; color: AppStyle.text-secondary; vertical-alignment: center; }
                        Text { width: 120px; text: "Total"; font-size: AppStyle.font-xs; font-weight: 700; color: AppStyle.text-secondary; horizontal-alignment: right; vertical-alignment: center; }
                        Text { width: 90px; text: "Aksi"; font-size: AppStyle.font-xs; font-weight: 700; color: AppStyle.text-secondary; horizontal-alignment: center; vertical-alignment: center; }
                    }
                }

                for h[idx] in root.items: Rectangle {
                    height: AppStyle.row-height-dense; background: Math.mod(idx, 2) == 0 ? AppStyle.surface : AppStyle.row-alt; border-width: 1px; border-color: AppStyle.border;
                    HorizontalLayout {
                        padding-left: 8px; padding-right: 8px;
                        Text { width: 35px; text: "" + (idx + 1); font-size: AppStyle.font-xs; color: AppStyle.text-muted; vertical-alignment: center; }
                        Text { width: 170px; text: h.faktur; font-size: AppStyle.font-sm; font-weight: 600; color: AppStyle.primary; vertical-alignment: center; }
                        Text { horizontal-stretch: 1; text: h.tanggal; font-size: AppStyle.font-sm; color: AppStyle.text-secondary; vertical-alignment: center; }
                        Text { width: 90px; text: h.metode; font-size: AppStyle.font-xs; color: AppStyle.text-muted; vertical-alignment: center; }
                        Text { width: 90px; text: h.kasir; font-size: AppStyle.font-xs; color: AppStyle.text-secondary; vertical-alignment: center; }
                        Text { width: 120px; text: "Rp " + h.total; font-size: AppStyle.font-sm; font-weight: 700; color: AppStyle.success; horizontal-alignment: right; vertical-alignment: center; }

                        Rectangle {
                            width: 90px;
                            Rectangle {
                                width: 75px; height: 22px; background: AppStyle.primary-light; border-radius: 3px; border-width: 1px; border-color: AppStyle.primary-border;
                                TouchArea { clicked => { root.cetak_struk(h.faktur); } }
                                Text { text: "Cetak Struk"; font-size: 10px; font-weight: 700; color: AppStyle.primary-dark; horizontal-alignment: center; vertical-alignment: center; }
                            }
                        }
                    }
                }

                if root.items.length == 0: Rectangle {
                    height: 180px;
                    Text { text: "Belum ada riwayat transaksi penjualan."; font-size: AppStyle.font-body; color: AppStyle.text-muted; horizontal-alignment: center; vertical-alignment: center; }
                }
            }
        }
    }
}
