import { OpnameGridData } from "../models.slint";
import { AppStyle } from "../styles.slint";

export component StokOpnameView inherits Rectangle {
    background: transparent;

    in-out property <[OpnameGridData]> items: [];
    in-out property <string> input_kode_barang: "";
    in-out property <string> input_stok_fisik: "0";
    in-out property <string> input_alasan: "Penyesuaian Fisik";

    callback proses_opname(string, float, string);
    callback refresh_opname();

    VerticalLayout {
        spacing: AppStyle.space-sm;

        Rectangle {
            height: AppStyle.header-height; background: AppStyle.surface; border-radius: 4px; border-width: 1px; border-color: AppStyle.border;
            HorizontalLayout {
                padding-left: AppStyle.space-md; padding-right: AppStyle.space-md; alignment: space-between;
                Text { text: "Stok Opname & Penyesuaian Fisik Gudang"; font-size: AppStyle.font-body; font-weight: 700; color: AppStyle.text-primary; vertical-alignment: center; }
                Rectangle {
                    height: 28px; background: AppStyle.border; border-radius: 3px;
                    TouchArea { clicked => { root.refresh_opname(); } }
                    HorizontalLayout { padding-left: 10px; padding-right: 10px; Text { text: "Refresh"; font-size: AppStyle.font-xs; font-weight: 600; color: AppStyle.text-secondary; vertical-alignment: center; } }
                }
            }
        }

        // Form Cek & Penyesuaian Cepat
        Rectangle {
            background: AppStyle.surface; border-radius: 4px; border-width: 1px; border-color: AppStyle.border-focus;

            HorizontalLayout {
                padding: AppStyle.space-sm;
                spacing: AppStyle.space-md;
                alignment: start;

                VerticalLayout {
                    spacing: 3px; width: 160px;
                    Text { text: "Kode / Barcode Produk:"; font-size: AppStyle.font-xs; font-weight: 600; color: AppStyle.text-secondary; }
                    Rectangle { height: 32px; background: AppStyle.bg; border-radius: 4px; border-width: 1px; border-color: AppStyle.border-focus; HorizontalLayout { padding-left: 6px; TextInput { text <=> root.input_kode_barang; font-size: AppStyle.font-sm; color: AppStyle.text-primary; vertical-alignment: center; } } }
                }
                VerticalLayout {
                    spacing: 3px; width: 110px;
                    Text { text: "Jumlah Fisik Nyata:"; font-size: AppStyle.font-xs; font-weight: 600; color: AppStyle.text-secondary; }
                    Rectangle { height: 32px; background: AppStyle.bg; border-radius: 4px; border-width: 1px; border-color: AppStyle.border-focus; HorizontalLayout { padding-left: 6px; TextInput { text <=> root.input_stok_fisik; font-size: AppStyle.font-sm; color: AppStyle.text-primary; vertical-alignment: center; } } }
                }
                VerticalLayout {
                    spacing: 3px; horizontal-stretch: 1;
                    Text { text: "Keterangan / Alasan:"; font-size: AppStyle.font-xs; font-weight: 600; color: AppStyle.text-secondary; }
                    Rectangle { height: 32px; background: AppStyle.bg; border-radius: 4px; border-width: 1px; border-color: AppStyle.border-focus; HorizontalLayout { padding-left: 6px; TextInput { text <=> root.input_alasan; font-size: AppStyle.font-sm; color: AppStyle.text-primary; vertical-alignment: center; } } }
                }
                VerticalLayout {
                    spacing: 3px; width: 140px;
                    Text { text: "Aksi:"; font-size: AppStyle.font-xs; color: transparent; }
                    Rectangle {
                        height: 32px; background: AppStyle.primary; border-radius: 4px;
                        TouchArea { clicked => {
                            root.proses_opname(root.input_kode_barang, root.input_stok_fisik.to-float(), root.input_alasan);
                        } }
                        Text { text: "SIMPAN OPNAME"; font-size: AppStyle.font-xs; font-weight: 700; color: #ffffff; horizontal-alignment: center; vertical-alignment: center; }
                    }
                }
            }
        }

        // Tabel Riwayat Opname
        Rectangle {
            background: AppStyle.surface; border-radius: 4px; border-width: 1px; border-color: AppStyle.border;
            vertical-stretch: 1;

            VerticalLayout {
                padding: 4px; spacing: 1px;
                Rectangle {
                    height: 30px; background: AppStyle.bg; border-width: 1px; border-color: AppStyle.border;
                    HorizontalLayout {
                        padding-left: 8px; padding-right: 8px;
                        Text { width: 35px; text: "No."; font-size: AppStyle.font-xs; font-weight: 700; color: AppStyle.text-secondary; vertical-alignment: center; }
                        Text { width: 110px; text: "Kode"; font-size: AppStyle.font-xs; font-weight: 700; color: AppStyle.text-secondary; vertical-alignment: center; }
                        Text { horizontal-stretch: 1; text: "Nama Produk"; font-size: AppStyle.font-xs; font-weight: 700; color: AppStyle.text-secondary; vertical-alignment: center; }
                        Text { width: 140px; text: "Waktu Opname"; font-size: AppStyle.font-xs; font-weight: 700; color: AppStyle.text-secondary; vertical-alignment: center; }
                        Text { width: 90px; text: "Stok Sistem"; font-size: AppStyle.font-xs; font-weight: 700; color: AppStyle.text-secondary; horizontal-alignment: center; vertical-alignment: center; }
                        Text { width: 90px; text: "Stok Fisik"; font-size: AppStyle.font-xs; font-weight: 700; color: AppStyle.text-secondary; horizontal-alignment: center; vertical-alignment: center; }
                        Text { width: 90px; text: "Selisih"; font-size: AppStyle.font-xs; font-weight: 700; color: AppStyle.text-secondary; horizontal-alignment: center; vertical-alignment: center; }
                        Text { width: 140px; text: "Alasan"; font-size: AppStyle.font-xs; font-weight: 700; color: AppStyle.text-secondary; vertical-alignment: center; }
                    }
                }

                for o[idx] in root.items: Rectangle {
                    height: AppStyle.row-height-dense; background: Math.mod(idx, 2) == 0 ? AppStyle.surface : AppStyle.row-alt; border-width: 1px; border-color: AppStyle.border;
                    HorizontalLayout {
                        padding-left: 8px; padding-right: 8px;
                        Text { width: 35px; text: "" + (idx + 1); font-size: AppStyle.font-xs; color: AppStyle.text-muted; vertical-alignment: center; }
                        Text { width: 110px; text: o.kode; font-size: AppStyle.font-sm; font-weight: 600; color: AppStyle.primary; vertical-alignment: center; }
                        Text { horizontal-stretch: 1; text: o.nama; font-size: AppStyle.font-sm; color: AppStyle.text-primary; vertical-alignment: center; }
                        Text { width: 140px; text: o.tanggal; font-size: AppStyle.font-xs; color: AppStyle.text-muted; vertical-alignment: center; }
                        Text { width: 90px; text: "" + o.stok_sistem; font-size: AppStyle.font-sm; color: AppStyle.text-secondary; horizontal-alignment: center; vertical-alignment: center; }
                        Text { width: 90px; text: "" + o.stok_fisik; font-size: AppStyle.font-sm; font-weight: 700; color: AppStyle.primary; horizontal-alignment: center; vertical-alignment: center; }
                        Text { width: 90px; text: (o.selisih > 0 ? "+" : "") + o.selisih; font-size: AppStyle.font-sm; font-weight: 700; color: o.selisih == 0 ? AppStyle.success : (o.selisih > 0 ? AppStyle.primary : AppStyle.danger); horizontal-alignment: center; vertical-alignment: center; }
                        Text { width: 140px; text: o.alasan; font-size: AppStyle.font-xs; color: AppStyle.text-muted; vertical-alignment: center; }
                    }
                }

                if root.items.length == 0: Rectangle {
                    height: 180px;
                    Text { text: "Belum ada riwayat stok opname."; font-size: AppStyle.font-body; color: AppStyle.text-muted; horizontal-alignment: center; vertical-alignment: center; }
                }
            }
        }
    }
}
