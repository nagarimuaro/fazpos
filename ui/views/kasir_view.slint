import { CartItemData, PendingGridData } from "../models.slint";
import { AppStyle } from "../styles.slint";

export component KasirView inherits Rectangle {
    background: transparent;

    in-out property <string> input_barcode: "";
    in-out property <[CartItemData]> items: [];
    in-out property <float> total_belanja: 0.0;
    in-out property <float> bayar_tunai: 0.0;
    in-out property <float> kembalian: 0.0;

    // Member & Loyalty Poin
    in-out property <string> input_member: "";
    in-out property <string> member_nama: "UMUM (Non-Member)";
    in-out property <string> member_kode: "UMUM";
    in-out property <int> member_poin_saldo: 0;
    in-out property <bool> is_member_attached: false;
    in-out property <int> input_tukar_poin: 0;
    in-out property <float> nilai_tukar_poin: 0.0;

    // Pending / Hold & Recall
    in-out property <[PendingGridData]> pending_items: [];
    in-out property <bool> show_pending_list: false;

    // Metode Bayar ("TUNAI", "NONTUNAI", "KREDIT")
    in-out property <string> metode_bayar: "TUNAI";

    callback cari_barcode(string);
    callback ubah_qty(int, float);
    callback hapus_item(int);
    callback proses_bayar(float);
    callback reset_transaksi();

    // Callbacks Member & Poin
    callback cari_member(string);
    callback lepas_member();
    callback tukar_poin(int);
    callback batal_tukar_poin();

    // Callbacks Pending
    callback hold_transaksi(string);
    callback recall_transaksi(string);
    callback hapus_pending(string);

    HorizontalLayout {
        spacing: AppStyle.space-md;

        // Kiri: Barcode, Member, dan Keranjang / Pending List
        VerticalLayout {
            horizontal-stretch: 3;
            spacing: AppStyle.space-sm;

            // Bar Atas: Scan Barcode & Member Scanner
            HorizontalLayout {
                spacing: AppStyle.space-sm;

                // Scan Barcode Produk
                Rectangle {
                    horizontal-stretch: 3;
                    height: AppStyle.header-height;
                    background: AppStyle.surface;
                    border-radius: 4px;
                    border-width: 1px;
                    border-color: AppStyle.border-focus;

                    HorizontalLayout {
                        padding-left: AppStyle.space-md;
                        padding-right: AppStyle.space-md;
                        spacing: AppStyle.space-sm;

                        Text { text: "SCAN BARCODE:"; font-size: AppStyle.font-xs; font-weight: 700; color: AppStyle.primary-dark; vertical-alignment: center; }
                        TextInput {
                            text <=> root.input_barcode;
                            font-size: AppStyle.font-body;
                            font-weight: 600;
                            color: AppStyle.text-primary;
                            vertical-alignment: center;
                            accepted => {
                                root.cari_barcode(self.text);
                                self.text = "";
                            }
                        }
                    }
                }

                // Scan / Cari Member
                Rectangle {
                    horizontal-stretch: 2;
                    height: AppStyle.header-height;
                    background: AppStyle.surface;
                    border-radius: 4px;
                    border-width: 1px;
                    border-color: AppStyle.border-focus;

                    HorizontalLayout {
                        padding-left: AppStyle.space-md;
                        padding-right: AppStyle.space-md;
                        spacing: AppStyle.space-sm;

                        Text { text: "MEMBER (KARTU/HP):"; font-size: AppStyle.font-xs; font-weight: 700; color: #0f766e; vertical-alignment: center; }
                        TextInput {
                            text <=> root.input_member;
                            font-size: AppStyle.font-body;
                            font-weight: 600;
                            color: AppStyle.text-primary;
                            vertical-alignment: center;
                            accepted => {
                                root.cari_member(self.text);
                                self.text = "";
                            }
                        }
                    }
                }
            }

            // Member Badge & Tukar Poin Bar (Jika member terpasang)
            if root.is_member_attached: Rectangle {
                height: 36px;
                background: AppStyle.success-bg;
                border-radius: 4px;
                border-width: 1px;
                border-color: AppStyle.success-border;

                HorizontalLayout {
                    padding-left: AppStyle.space-md; padding-right: AppStyle.space-md;
                    alignment: space-between;

                    HorizontalLayout {
                        spacing: AppStyle.space-sm;
                        alignment: start;
                        Text { text: "MEMBER:"; font-size: AppStyle.font-xs; font-weight: 700; color: AppStyle.success; vertical-alignment: center; }
                        Text { text: root.member_nama + " (" + root.member_kode + ")"; font-size: AppStyle.font-sm; font-weight: 700; color: AppStyle.text-primary; vertical-alignment: center; }
                        Rectangle { width: 1px; background: AppStyle.success-border; }
                        Text { text: "Saldo Poin: " + root.member_poin_saldo; font-size: AppStyle.font-sm; font-weight: 700; color: AppStyle.primary-dark; vertical-alignment: center; }

                        if root.nilai_tukar_poin > 0: Text {
                            text: "• Terpotong Poin: Rp " + root.nilai_tukar_poin;
                            font-size: AppStyle.font-sm; font-weight: 700; color: AppStyle.success; vertical-alignment: center;
                        }
                    }

                    HorizontalLayout {
                        spacing: 6px;
                        alignment: end;

                        if root.nilai_tukar_poin == 0: Rectangle {
                            width: 80px; height: 24px; background: AppStyle.primary; border-radius: 3px;
                            TouchArea { clicked => { root.tukar_poin(root.member_poin_saldo); } }
                            Text { text: "Tukar Semua"; font-size: 10px; font-weight: 700; color: #ffffff; horizontal-alignment: center; vertical-alignment: center; }
                        }

                        if root.nilai_tukar_poin > 0: Rectangle {
                            width: 75px; height: 24px; background: AppStyle.border; border-radius: 3px;
                            TouchArea { clicked => { root.batal_tukar_poin(); } }
                            Text { text: "Batal Tukar"; font-size: 10px; font-weight: 600; color: AppStyle.text-secondary; horizontal-alignment: center; vertical-alignment: center; }
                        }

                        Rectangle {
                            width: 55px; height: 24px; background: AppStyle.danger-bg; border-radius: 3px; border-width: 1px; border-color: AppStyle.danger-border;
                            TouchArea { clicked => { root.lepas_member(); } }
                            Text { text: "Lepas"; font-size: 10px; font-weight: 700; color: AppStyle.danger; horizontal-alignment: center; vertical-alignment: center; }
                        }
                    }
                }
            }

            // Toolbar Antrean (Hold / Recall)
            Rectangle {
                height: 34px;
                background: AppStyle.surface;
                border-radius: 4px;
                border-width: 1px;
                border-color: AppStyle.border;

                HorizontalLayout {
                    padding-left: 10px; padding-right: 10px;
                    alignment: space-between;

                    HorizontalLayout {
                        spacing: 8px;
                        alignment: start;
                        Text { text: root.show_pending_list ? "DAFTAR ANTREAN TERTUNDA" : "KERANJANG TRANSAKSI"; font-size: AppStyle.font-xs; font-weight: 700; color: AppStyle.text-secondary; vertical-alignment: center; }
                    }

                    HorizontalLayout {
                        spacing: 8px;
                        alignment: end;

                        // Tombol Tahan Antrean (Hold)
                        Rectangle {
                            width: 125px; height: 26px; background: AppStyle.warning-bg; border-radius: 3px; border-width: 1px; border-color: AppStyle.warning-border;
                            TouchArea { clicked => { root.hold_transaksi("Antrean kasir"); } }
                            Text { text: "HOLD ANTREAN (F7)"; font-size: 10px; font-weight: 700; color: AppStyle.warning; horizontal-alignment: center; vertical-alignment: center; }
                        }

                        // Tombol Daftar Pending (Recall)
                        Rectangle {
                            width: 140px; height: 26px;
                            background: root.show_pending_list ? AppStyle.primary : AppStyle.bg;
                            border-radius: 3px; border-width: 1px; border-color: AppStyle.border;
                            TouchArea { clicked => { root.show_pending_list = !root.show_pending_list; } }
                            Text {
                                text: root.show_pending_list ? "KEMBALI KE KERANJANG" : ("ANTREAN TERTAHAN (" + root.pending_items.length + ")");
                                font-size: 10px; font-weight: 700;
                                color: root.show_pending_list ? #ffffff : AppStyle.text-secondary;
                                horizontal-alignment: center; vertical-alignment: center;
                            }
                        }
                    }
                }
            }

            // Konten Utama: Daftar Pending vs Keranjang Kasir
            if root.show_pending_list: Rectangle {
                background: AppStyle.surface;
                border-radius: 4px;
                border-width: 1px;
                border-color: AppStyle.border;
                vertical-stretch: 1;

                VerticalLayout {
                    padding: 6px;
                    spacing: 2px;

                    // Table Header Pending
                    Rectangle {
                        height: 30px; background: AppStyle.bg; border-width: 1px; border-color: AppStyle.border;
                        HorizontalLayout {
                            padding-left: 8px; padding-right: 8px;
                            Text { width: 35px; text: "No."; font-size: AppStyle.font-xs; font-weight: 700; color: AppStyle.text-secondary; vertical-alignment: center; }
                            Text { width: 140px; text: "NO. HOLD"; font-size: AppStyle.font-xs; font-weight: 700; color: AppStyle.text-secondary; vertical-alignment: center; }
                            Text { width: 140px; text: "WAKTU"; font-size: AppStyle.font-xs; font-weight: 700; color: AppStyle.text-secondary; vertical-alignment: center; }
                            Text { width: 100px; text: "MEMBER"; font-size: AppStyle.font-xs; font-weight: 700; color: AppStyle.text-secondary; vertical-alignment: center; }
                            Text { horizontal-stretch: 1; text: "KETERANGAN"; font-size: AppStyle.font-xs; font-weight: 700; color: AppStyle.text-secondary; vertical-alignment: center; }
                            Text { width: 110px; text: "TOTAL"; font-size: AppStyle.font-xs; font-weight: 700; color: AppStyle.text-secondary; horizontal-alignment: right; vertical-alignment: center; }
                            Text { width: 140px; text: "AKSI"; font-size: AppStyle.font-xs; font-weight: 700; color: AppStyle.text-secondary; horizontal-alignment: center; vertical-alignment: center; }
                        }
                    }

                    // Table Rows Pending
                    for p[idx] in root.pending_items: Rectangle {
                        height: AppStyle.row-height-dense;
                        background: Math.mod(idx, 2) == 0 ? AppStyle.surface : AppStyle.row-alt;
                        border-width: 1px; border-color: AppStyle.border;

                        HorizontalLayout {
                            padding-left: 8px; padding-right: 8px;
                            Text { width: 35px; text: "" + (idx + 1); font-size: AppStyle.font-xs; color: AppStyle.text-muted; vertical-alignment: center; }
                            Text { width: 140px; text: p.faktur; font-size: AppStyle.font-sm; font-weight: 600; color: AppStyle.primary; vertical-alignment: center; }
                            Text { width: 140px; text: p.tanggal; font-size: AppStyle.font-xs; color: AppStyle.text-muted; vertical-alignment: center; }
                            Text { width: 100px; text: p.pelanggan; font-size: AppStyle.font-xs; color: AppStyle.text-secondary; vertical-alignment: center; }
                            Text { horizontal-stretch: 1; text: p.keterangan; font-size: AppStyle.font-xs; color: AppStyle.text-muted; vertical-alignment: center; }
                            Text { width: 110px; text: "Rp " + p.total; font-size: AppStyle.font-sm; font-weight: 700; color: AppStyle.success; horizontal-alignment: right; vertical-alignment: center; }

                            HorizontalLayout {
                                width: 140px; alignment: center; spacing: 4px;
                                Rectangle {
                                    width: 70px; height: 22px; background: AppStyle.success; border-radius: 3px;
                                    TouchArea { clicked => {
                                        root.recall_transaksi(p.id);
                                        root.show_pending_list = false;
                                    } }
                                    Text { text: "Panggil"; font-size: 10px; font-weight: 700; color: #ffffff; horizontal-alignment: center; vertical-alignment: center; }
                                }
                                Rectangle {
                                    width: 50px; height: 22px; background: AppStyle.danger-bg; border-radius: 3px; border-width: 1px; border-color: AppStyle.danger-border;
                                    TouchArea { clicked => { root.hapus_pending(p.id); } }
                                    Text { text: "Hapus"; font-size: 10px; font-weight: 700; color: AppStyle.danger; horizontal-alignment: center; vertical-alignment: center; }
                                }
                            }
                        }
                    }

                    if root.pending_items.length == 0: Rectangle {
                        height: 200px;
                        Text { text: "Tidak ada transaksi yang ditahan (Hold)."; font-size: AppStyle.font-body; color: AppStyle.text-muted; horizontal-alignment: center; vertical-alignment: center; }
                    }
                }
            }

            // Keranjang Kasir Biasa
            if !root.show_pending_list: Rectangle {
                background: AppStyle.surface;
                border-radius: 4px;
                border-width: 1px;
                border-color: AppStyle.border;
                vertical-stretch: 1;

                VerticalLayout {
                    padding: 4px;
                    spacing: 1px;

                    // Table Header
                    Rectangle {
                        height: 32px;
                        background: AppStyle.bg;
                        border-width: 1px;
                        border-color: AppStyle.border;

                        HorizontalLayout {
                            padding-left: 10px; padding-right: 10px;
                            Text { width: 35px; text: "No."; font-size: AppStyle.font-xs; font-weight: 700; color: AppStyle.text-secondary; vertical-alignment: center; }
                            Text { width: 95px; text: "KODE"; font-size: AppStyle.font-xs; font-weight: 700; color: AppStyle.primary-dark; vertical-alignment: center; }
                            Text { horizontal-stretch: 1; text: "NAMA BARANG"; font-size: AppStyle.font-xs; font-weight: 700; color: AppStyle.text-secondary; vertical-alignment: center; }
                            Text { width: 65px; text: "SATUAN"; font-size: AppStyle.font-xs; font-weight: 700; color: AppStyle.text-secondary; vertical-alignment: center; }
                            Text { width: 110px; text: "QTY"; font-size: AppStyle.font-xs; font-weight: 700; color: AppStyle.text-secondary; horizontal-alignment: center; vertical-alignment: center; }
                            Text { width: 95px; text: "HARGA"; font-size: AppStyle.font-xs; font-weight: 700; color: AppStyle.text-secondary; horizontal-alignment: right; vertical-alignment: center; }
                            Text { width: 105px; text: "SUBTOTAL"; font-size: AppStyle.font-xs; font-weight: 700; color: AppStyle.text-secondary; horizontal-alignment: right; vertical-alignment: center; }
                            Text { width: 35px; text: ""; font-size: AppStyle.font-xs; }
                        }
                    }

                    // Table Rows
                    for item[idx] in root.items: Rectangle {
                        height: AppStyle.row-height-dense;
                        background: Math.mod(idx, 2) == 0 ? AppStyle.surface : AppStyle.row-alt;
                        border-width: 1px;
                        border-color: AppStyle.border;

                        HorizontalLayout {
                            padding-left: 10px; padding-right: 10px;
                            Text { width: 35px; text: "" + (idx + 1); font-size: AppStyle.font-xs; color: AppStyle.text-muted; vertical-alignment: center; }
                            Text { width: 95px; text: item.kode; font-size: AppStyle.font-sm; font-weight: 600; color: AppStyle.primary; vertical-alignment: center; }
                            Text { horizontal-stretch: 1; text: item.nama; font-size: AppStyle.font-sm; font-weight: 600; color: AppStyle.text-primary; vertical-alignment: center; }
                            Text { width: 65px; text: item.satuan; font-size: AppStyle.font-sm; color: AppStyle.text-secondary; vertical-alignment: center; }

                            // Qty Buttons (- / Qty / +)
                            HorizontalLayout {
                                width: 110px;
                                alignment: center;
                                spacing: 4px;

                                Rectangle {
                                    width: 22px; height: 22px; background: AppStyle.border; border-radius: 3px;
                                    TouchArea { clicked => { root.ubah_qty(idx, item.jumlah - 1.0); } }
                                    Text { text: "-"; font-size: AppStyle.font-body; font-weight: 700; color: AppStyle.text-primary; horizontal-alignment: center; vertical-alignment: center; }
                                }
                                Text { text: "" + item.jumlah; font-size: AppStyle.font-sm; font-weight: 700; color: AppStyle.text-primary; vertical-alignment: center; width: 40px; horizontal-alignment: center; }
                                Rectangle {
                                    width: 22px; height: 22px; background: AppStyle.border; border-radius: 3px;
                                    TouchArea { clicked => { root.ubah_qty(idx, item.jumlah + 1.0); } }
                                    Text { text: "+"; font-size: AppStyle.font-body; font-weight: 700; color: AppStyle.text-primary; horizontal-alignment: center; vertical-alignment: center; }
                                }
                            }

                            Text { width: 95px; text: "" + item.harga; font-size: AppStyle.font-sm; color: AppStyle.text-secondary; horizontal-alignment: right; vertical-alignment: center; }
                            Text { width: 105px; text: "" + item.subtotal; font-size: AppStyle.font-body; font-weight: 700; color: AppStyle.success; horizontal-alignment: right; vertical-alignment: center; }

                            // Tombol Hapus Baris
                            Rectangle {
                                width: 35px;
                                Rectangle {
                                    width: 20px; height: 20px; background: AppStyle.danger-bg; border-radius: 3px; border-width: 1px; border-color: AppStyle.danger-border;
                                    TouchArea { clicked => { root.hapus_item(idx); } }
                                    Text { text: "X"; font-size: 10px; font-weight: 700; color: AppStyle.danger; horizontal-alignment: center; vertical-alignment: center; }
                                }
                            }
                        }
                    }

                    if root.items.length == 0: Rectangle {
                        height: 240px;
                        Text { text: "Keranjang kasir kosong. Scan barcode atau masukkan kode produk di atas."; font-size: AppStyle.font-body; color: AppStyle.text-muted; horizontal-alignment: center; vertical-alignment: center; }
                    }
                }
            }
        }

        // Kanan: Panel Kasir (Total, Metode Bayar, Input Tunai, Kembalian)
        VerticalLayout {
            horizontal-stretch: 1;
            spacing: AppStyle.space-sm;

            // Display Total Besar
            Rectangle {
                background: AppStyle.success-bg;
                border-radius: 4px;
                border-width: 1px;
                border-color: AppStyle.success-border;
                VerticalLayout {
                    padding: AppStyle.space-md;
                    spacing: 4px;
                    Text { text: "TOTAL TAGIHAN"; font-size: AppStyle.font-xs; font-weight: 700; color: AppStyle.success; }
                    Text {
                        text: "Rp " + Math.max(0.0, root.total_belanja - root.nilai_tukar_poin);
                        font-size: AppStyle.font-display; font-weight: 800; color: AppStyle.success;
                    }
                    if root.nilai_tukar_poin > 0: Text {
                        text: "(Hemat Rp " + root.nilai_tukar_poin + " dari Poin Member)";
                        font-size: AppStyle.font-xs; font-weight: 600; color: AppStyle.success;
                    }
                }
            }

            // Form Pembayaran
            Rectangle {
                background: AppStyle.surface;
                border-radius: 4px;
                border-width: 1px;
                border-color: AppStyle.border-focus;
                VerticalLayout {
                    padding: AppStyle.space-md;
                    spacing: 10px;

                    // Pemilihan Metode Bayar
                    VerticalLayout {
                        spacing: 4px;
                        Text { text: "Metode Pembayaran:"; font-size: AppStyle.font-xs; font-weight: 600; color: AppStyle.text-secondary; }
                        HorizontalLayout {
                            spacing: 4px;
                            Rectangle {
                                horizontal-stretch: 1; height: 28px;
                                background: root.metode_bayar == "TUNAI" ? AppStyle.primary : AppStyle.bg;
                                border-radius: 3px;
                                TouchArea { clicked => { root.metode_bayar = "TUNAI"; } }
                                Text { text: "TUNAI"; font-size: 10px; font-weight: 700; color: root.metode_bayar == "TUNAI" ? #ffffff : AppStyle.text-secondary; horizontal-alignment: center; vertical-alignment: center; }
                            }
                            Rectangle {
                                horizontal-stretch: 1; height: 28px;
                                background: root.metode_bayar == "NONTUNAI" ? AppStyle.primary : AppStyle.bg;
                                border-radius: 3px;
                                TouchArea { clicked => { root.metode_bayar = "NONTUNAI"; } }
                                Text { text: "NON-TUNAI"; font-size: 10px; font-weight: 700; color: root.metode_bayar == "NONTUNAI" ? #ffffff : AppStyle.text-secondary; horizontal-alignment: center; vertical-alignment: center; }
                            }
                            Rectangle {
                                horizontal-stretch: 1; height: 28px;
                                background: root.metode_bayar == "KREDIT" ? AppStyle.warning : AppStyle.bg;
                                border-radius: 3px;
                                TouchArea { clicked => { root.metode_bayar = "KREDIT"; } }
                                Text { text: "KREDIT"; font-size: 10px; font-weight: 700; color: root.metode_bayar == "KREDIT" ? #ffffff : AppStyle.text-secondary; horizontal-alignment: center; vertical-alignment: center; }
                            }
                        }
                    }

                    VerticalLayout {
                        spacing: 4px;
                        Text { text: root.metode_bayar == "TUNAI" ? "Uang Diterima (Tunai):" : "Nominal Bayar:"; font-size: AppStyle.font-xs; font-weight: 600; color: AppStyle.text-secondary; }
                        Rectangle {
                            height: AppStyle.input-height; background: AppStyle.bg; border-radius: 4px; border-width: 1px; border-color: AppStyle.border-focus;
                            HorizontalLayout {
                                padding-left: AppStyle.space-sm; padding-right: AppStyle.space-sm;
                                input_tunai := TextInput {
                                    text: "0";
                                    font-size: 16px;
                                    font-weight: 700;
                                    color: AppStyle.text-primary;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }

                    if root.metode_bayar == "TUNAI": VerticalLayout {
                        spacing: 2px;
                        Text { text: "Kembalian:"; font-size: AppStyle.font-xs; color: AppStyle.text-muted; }
                        Text { text: "Rp " + root.kembalian; font-size: 20px; font-weight: 800; color: AppStyle.primary; }
                    }

                    if root.metode_bayar == "KREDIT": Rectangle {
                        height: 28px; background: AppStyle.warning-bg; border-radius: 3px; border-width: 1px; border-color: AppStyle.warning-border;
                        Text { text: "Transaksi dicatat sebagai Piutang Member"; font-size: 10px; font-weight: 600; color: AppStyle.warning; horizontal-alignment: center; vertical-alignment: center; }
                    }

                    Rectangle {
                        height: AppStyle.button-height-primary; background: AppStyle.primary; border-radius: 4px;
                        TouchArea { clicked => {
                            root.bayar_tunai = input_tunai.text.to-float();
                            root.proses_bayar(input_tunai.text.to-float());
                        } }
                        Text { text: "SIMPAN TRANSAKSI (F5)"; font-size: AppStyle.font-sm; font-weight: 700; color: #ffffff; horizontal-alignment: center; vertical-alignment: center; }
                    }

                    Rectangle {
                        height: AppStyle.button-height-secondary; background: AppStyle.border; border-radius: 4px;
                        TouchArea { clicked => {
                            input_tunai.text = "0";
                            root.reset_transaksi();
                        } }
                        Text { text: "BATALKAN TRANSAKSI"; font-size: AppStyle.font-xs; font-weight: 600; color: AppStyle.text-secondary; horizontal-alignment: center; vertical-alignment: center; }
                    }
                }
            }
        }
    }
}
