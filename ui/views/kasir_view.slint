import { CartItemData, PendingGridData, ProductGridData } from "../models.slint";
import { AppStyle } from "../styles.slint";

export component KasirView inherits Rectangle {
    background: transparent;

    in-out property <string> input_barcode: "";
    in-out property <[CartItemData]> items: [];
    in-out property <[ProductGridData]> catalog_products: [];
    in-out property <float> total_belanja: 0.0;
    in-out property <float> bayar_tunai: 0.0;
    in-out property <float> kembalian: 0.0;
    in-out property <string> input_tender_str: "0";

    // Member & Loyalty Poin
    in-out property <string> input_member: "";
    in-out property <string> member_nama: "UMUM (Non-Member)";
    in-out property <string> member_kode: "UMUM";
    in-out property <int> member_poin_saldo: 0;
    in-out property <bool> is_member_attached: false;
    in-out property <float> nilai_tukar_poin: 0.0;

    // Pending / Hold & Recall
    in-out property <[PendingGridData]> pending_items: [];
    in-out property <bool> show_pending_list: false;

    // Metode Bayar ("TUNAI", "NONTUNAI", "KREDIT")
    in-out property <string> metode_bayar: "TUNAI";

    callback cari_barcode(string);
    callback ubah_qty(int, float);
    callback hapus_item(int);
    callback proses_bayar(float);
    callback reset_transaksi();

    // Callbacks Member & Poin
    callback cari_member(string);
    callback lepas_member();
    callback tukar_poin(int);
    callback batal_tukar_poin();

    // Callbacks Pending
    callback hold_transaksi(string);
    callback recall_transaksi(string);
    callback hapus_pending(string);

    HorizontalLayout {
        spacing: AppStyle.space-sm;

        // =========================================================================
        // LEFT PANEL (65%): FAST PRODUCT CATALOG & IN-LINE SELECTION TABLE
        // =========================================================================
        Rectangle {
            horizontal-stretch: 65;
            background: AppStyle.surface;
            border-radius: 4px;
            border-width: 1px;
            border-color: AppStyle.border;

            VerticalLayout {
                padding: 0px;
                spacing: 0px;

                // Search & Barcode Scanner Bar
                Rectangle {
                    height: 48px;
                    background: AppStyle.surface-low;
                    border-width: 1px;
                    border-color: AppStyle.border-subtle;

                    HorizontalLayout {
                        padding-left: AppStyle.space-sm;
                        padding-right: AppStyle.space-sm;
                        padding-top: 6px;
                        padding-bottom: 6px;
                        spacing: AppStyle.space-sm;

                        // Barcode Auto-Focus Input
                        Rectangle {
                            horizontal-stretch: 1;
                            background: AppStyle.surface;
                            border-radius: 4px;
                            border-width: 1px;
                            border-color: AppStyle.border-focus;

                            HorizontalLayout {
                                padding-left: 8px;
                                padding-right: 8px;
                                spacing: 6px;

                                Text { text: "⌕"; font-size: 14px; color: AppStyle.primary; vertical-alignment: center; }
                                barcode_input := TextInput {
                                    text <=> root.input_barcode;
                                    font-size: AppStyle.font-body;
                                    font-weight: 600;
                                    color: AppStyle.text-primary;
                                    vertical-alignment: center;
                                    accepted => {
                                        root.cari_barcode(self.text);
                                        self.text = "";
                                    }
                                }
                                Rectangle {
                                    width: 75px; height: 20px; border-radius: 2px;
                                    background: AppStyle.success-bg; border-width: 1px; border-color: AppStyle.success-border;
                                    Text { text: "AUTO-SCAN"; font-size: 9px; font-weight: 800; color: AppStyle.success; horizontal-alignment: center; vertical-alignment: center; }
                                }
                            }
                        }

                        // Input Member Cepat
                        Rectangle {
                            width: 220px;
                            background: AppStyle.surface;
                            border-radius: 4px;
                            border-width: 1px;
                            border-color: AppStyle.border;

                            HorizontalLayout {
                                padding-left: 8px;
                                padding-right: 8px;
                                spacing: 4px;
                                Text { text: "MEMBER:"; font-size: 10px; font-weight: 700; color: AppStyle.text-muted; vertical-alignment: center; }
                                member_input := TextInput {
                                    text <=> root.input_member;
                                    font-size: AppStyle.font-xs;
                                    color: AppStyle.text-primary;
                                    vertical-alignment: center;
                                    accepted => {
                                        root.cari_member(self.text);
                                        self.text = "";
                                    }
                                }
                            }
                        }
                    }
                }

                // Member Ribbon Status (Jika ada member aktif)
                if root.is_member_attached: Rectangle {
                    height: 28px;
                    background: AppStyle.success-bg;
                    border-width: 1px;
                    border-color: AppStyle.success-border;

                    HorizontalLayout {
                        padding-left: AppStyle.space-sm;
                        padding-right: AppStyle.space-sm;
                        alignment: space-between;

                        HorizontalLayout {
                            spacing: 8px; alignment: start;
                            Text { text: "MEMBER AKTIF: " + root.member_nama + " (" + root.member_kode + ")"; font-size: 10px; font-weight: 700; color: AppStyle.success; vertical-alignment: center; }
                            Text { text: "• Saldo: " + root.member_poin_saldo + " Poin"; font-size: 10px; font-weight: 700; color: AppStyle.primary-dark; vertical-alignment: center; }
                            if root.nilai_tukar_poin > 0: Text { text: "(Potongan Rp " + root.nilai_tukar_poin + ")"; font-size: 10px; font-weight: 700; color: AppStyle.success; vertical-alignment: center; }
                        }

                        HorizontalLayout {
                            spacing: 4px; alignment: end;
                            if root.nilai_tukar_poin == 0: Rectangle {
                                width: 70px; height: 20px; background: AppStyle.primary; border-radius: 2px;
                                TouchArea { clicked => { root.tukar_poin(root.member_poin_saldo); } }
                                Text { text: "Tukar Poin"; font-size: 9px; font-weight: 700; color: #ffffff; horizontal-alignment: center; vertical-alignment: center; }
                            }
                            if root.nilai_tukar_poin > 0: Rectangle {
                                width: 65px; height: 20px; background: AppStyle.border; border-radius: 2px;
                                TouchArea { clicked => { root.batal_tukar_poin(); } }
                                Text { text: "Batal Poin"; font-size: 9px; font-weight: 700; color: AppStyle.text-secondary; horizontal-alignment: center; vertical-alignment: center; }
                            }
                            Rectangle {
                                width: 45px; height: 20px; background: AppStyle.danger-bg; border-radius: 2px;
                                TouchArea { clicked => { root.lepas_member(); } }
                                Text { text: "Lepas"; font-size: 9px; font-weight: 700; color: AppStyle.danger; horizontal-alignment: center; vertical-alignment: center; }
                            }
                        }
                    }
                }

                // High-Density Catalog Product Table
                Rectangle {
                    vertical-stretch: 1;
                    background: AppStyle.surface;

                    VerticalLayout {
                        padding: 0px;
                        spacing: 0px;

                        // Table Header
                        Rectangle {
                            height: 28px;
                            background: AppStyle.surface-low;
                            border-width: 1px;
                            border-color: AppStyle.border;

                            HorizontalLayout {
                                padding-left: 8px; padding-right: 8px;
                                Text { width: 90px; text: "SKU/BARCODE"; font-size: 10px; font-weight: 700; color: AppStyle.text-secondary; vertical-alignment: center; }
                                Text { horizontal-stretch: 1; text: "NAMA PRODUK"; font-size: 10px; font-weight: 700; color: AppStyle.text-secondary; vertical-alignment: center; }
                                Text { width: 100px; text: "KATEGORI"; font-size: 10px; font-weight: 700; color: AppStyle.text-secondary; vertical-alignment: center; }
                                Text { width: 65px; text: "STOK"; font-size: 10px; font-weight: 700; color: AppStyle.text-secondary; horizontal-alignment: center; vertical-alignment: center; }
                                Text { width: 90px; text: "HARGA"; font-size: 10px; font-weight: 700; color: AppStyle.text-secondary; horizontal-alignment: right; vertical-alignment: center; }
                                Text { width: 75px; text: "AKSI"; font-size: 10px; font-weight: 700; color: AppStyle.text-secondary; horizontal-alignment: center; vertical-alignment: center; }
                            }
                        }

                        // Product Rows
                        for p[idx] in root.catalog_products: Rectangle {
                            height: AppStyle.row-height-dense;
                            background: p.is_kritis ? AppStyle.warning-bg : (Math.mod(idx, 2) == 0 ? AppStyle.surface : AppStyle.row-alt);
                            border-width: 1px;
                            border-color: AppStyle.border-subtle;

                            HorizontalLayout {
                                padding-left: 8px; padding-right: 8px;
                                Text { width: 90px; text: p.kode; font-size: 11px; font-weight: 600; color: p.is_kritis ? AppStyle.warning : AppStyle.primary; vertical-alignment: center; }
                                Text { horizontal-stretch: 1; text: p.nama; font-size: 11px; font-weight: 600; color: AppStyle.text-primary; vertical-alignment: center; }
                                Text { width: 100px; text: p.kategori; font-size: 10px; color: AppStyle.text-muted; vertical-alignment: center; }
                                Text { width: 65px; text: "" + p.stok; font-size: 11px; font-weight: 700; color: p.is_kritis ? AppStyle.warning : AppStyle.primary; horizontal-alignment: center; vertical-alignment: center; }
                                Text { width: 90px; text: "Rp " + p.hargajual1; font-size: 11px; font-weight: 700; color: AppStyle.text-primary; horizontal-alignment: right; vertical-alignment: center; }

                                HorizontalLayout {
                                    width: 75px; alignment: center;
                                    Rectangle {
                                        width: 65px; height: 20px; background: AppStyle.primary; border-radius: 2px;
                                        TouchArea { clicked => { root.cari_barcode(p.kode); } }
                                        Text { text: "+ Tambah"; font-size: 9px; font-weight: 700; color: #ffffff; horizontal-alignment: center; vertical-alignment: center; }
                                    }
                                }
                            }
                        }

                        if root.catalog_products.length == 0: Rectangle {
                            height: 180px;
                            Text { text: "Scan barcode atau masukkan kode barang di atas."; font-size: 12px; color: AppStyle.text-muted; horizontal-alignment: center; vertical-alignment: center; }
                        }
                    }
                }

                // Table Footer Info Bar
                Rectangle {
                    height: 24px;
                    background: AppStyle.surface-low;
                    border-width: 1px;
                    border-color: AppStyle.border;

                    HorizontalLayout {
                        padding-left: AppStyle.space-sm; padding-right: AppStyle.space-sm;
                        alignment: space-between;
                        Text { text: "Katalog: " + root.catalog_products.length + " SKU • Tekan [+ Tambah] untuk masukkan ke kasir"; font-size: 9px; color: AppStyle.text-secondary; vertical-alignment: center; }
                        Text { text: "SQLite WAL Engine: 0.1ms"; font-size: 9px; color: AppStyle.success; vertical-alignment: center; }
                    }
                }
            }
        }

        // =========================================================================
        // RIGHT PANEL (35%): ACTIVE CART & NUMERIC CHECKOUT DECK
        // =========================================================================
        Rectangle {
            horizontal-stretch: 35;
            background: AppStyle.surface;
            border-radius: 4px;
            border-width: 1px;
            border-color: AppStyle.border;

            VerticalLayout {
                padding: 0px;
                spacing: 0px;

                // Cart Header
                Rectangle {
                    height: 36px;
                    background: AppStyle.surface-low;
                    border-width: 1px;
                    border-color: AppStyle.border;

                    HorizontalLayout {
                        padding-left: AppStyle.space-sm; padding-right: AppStyle.space-sm;
                        alignment: space-between;
                        HorizontalLayout {
                            spacing: 6px; alignment: start;
                            Text { text: "#ORDER-KASIR"; font-size: 11px; font-weight: 800; color: AppStyle.text-primary; vertical-alignment: center; }
                            Rectangle {
                                width: 50px; height: 18px; border-radius: 2px; background: AppStyle.primary-light;
                                Text { text: "AKTIF"; font-size: 9px; font-weight: 800; color: AppStyle.primary-dark; horizontal-alignment: center; vertical-alignment: center; }
                            }
                        }
                        HorizontalLayout {
                            spacing: 4px; alignment: end;
                            Rectangle {
                                height: 22px; border-radius: 2px;
                                background: root.show_pending_list ? AppStyle.primary : AppStyle.border;
                                TouchArea { clicked => { root.show_pending_list = !root.show_pending_list; } }
                                HorizontalLayout {
                                    padding-left: 6px; padding-right: 6px;
                                    Text {
                                        text: root.show_pending_list ? "Keranjang" : ("Hold (" + root.pending_items.length + ")");
                                        font-size: 9px; font-weight: 700;
                                        color: root.show_pending_list ? #ffffff : AppStyle.text-secondary;
                                        vertical-alignment: center;
                                    }
                                }
                            }
                        }
                    }
                }

                // Cart Items Grid
                Rectangle {
                    vertical-stretch: 1;
                    background: AppStyle.surface;

                    VerticalLayout {
                        padding: 0px; spacing: 0px;

                        // Table Cart Header
                        Rectangle {
                            height: 24px; background: AppStyle.surface-low; border-width: 1px; border-color: AppStyle.border-subtle;
                            HorizontalLayout {
                                padding-left: 6px; padding-right: 6px;
                                Text { horizontal-stretch: 1; text: "ITEM"; font-size: 9px; font-weight: 700; color: AppStyle.text-secondary; vertical-alignment: center; }
                                Text { width: 75px; text: "QTY"; font-size: 9px; font-weight: 700; color: AppStyle.text-secondary; horizontal-alignment: center; vertical-alignment: center; }
                                Text { width: 70px; text: "SUBTOTAL"; font-size: 9px; font-weight: 700; color: AppStyle.text-secondary; horizontal-alignment: right; vertical-alignment: center; }
                                Text { width: 25px; text: ""; font-size: 9px; }
                            }
                        }

                        // Cart Rows
                        for item[idx] in root.items: Rectangle {
                            height: 28px;
                            background: Math.mod(idx, 2) == 0 ? AppStyle.surface : AppStyle.row-alt;
                            border-width: 1px; border-color: AppStyle.border-subtle;

                            HorizontalLayout {
                                padding-left: 6px; padding-right: 6px;
                                VerticalLayout {
                                    horizontal-stretch: 1; alignment: center;
                                    Text { text: item.nama; font-size: 11px; font-weight: 600; color: AppStyle.text-primary; }
                                }

                                HorizontalLayout {
                                    width: 75px; alignment: center; spacing: 2px;
                                    Rectangle {
                                        width: 18px; height: 18px; background: AppStyle.border; border-radius: 2px;
                                        TouchArea { clicked => { root.ubah_qty(idx, item.jumlah - 1.0); } }
                                        Text { text: "-"; font-size: 11px; font-weight: 700; color: AppStyle.text-primary; horizontal-alignment: center; vertical-alignment: center; }
                                    }
                                    Text { text: "" + item.jumlah; font-size: 11px; font-weight: 700; color: AppStyle.text-primary; width: 25px; horizontal-alignment: center; vertical-alignment: center; }
                                    Rectangle {
                                        width: 18px; height: 18px; background: AppStyle.border; border-radius: 2px;
                                        TouchArea { clicked => { root.ubah_qty(idx, item.jumlah + 1.0); } }
                                        Text { text: "+"; font-size: 11px; font-weight: 700; color: AppStyle.text-primary; horizontal-alignment: center; vertical-alignment: center; }
                                    }
                                }

                                Text { width: 70px; text: "Rp " + item.subtotal; font-size: 11px; font-weight: 700; color: AppStyle.success; horizontal-alignment: right; vertical-alignment: center; }

                                HorizontalLayout {
                                    width: 25px; alignment: center;
                                    Rectangle {
                                        width: 16px; height: 16px; background: AppStyle.danger-bg; border-radius: 2px;
                                        TouchArea { clicked => { root.hapus_item(idx); } }
                                        Text { text: "✕"; font-size: 9px; font-weight: 800; color: AppStyle.danger; horizontal-alignment: center; vertical-alignment: center; }
                                    }
                                }
                            }
                        }

                        if root.items.length == 0: Rectangle {
                            height: 120px;
                            Text { text: "Keranjang masih kosong."; font-size: 11px; color: AppStyle.text-muted; horizontal-alignment: center; vertical-alignment: center; }
                        }
                    }
                }

                // Financial Summary Breakdown & High Contrast Grand Total
                Rectangle {
                    background: AppStyle.surface-low;
                    border-width: 1px; border-color: AppStyle.border;

                    VerticalLayout {
                        padding: 8px; spacing: 4px;

                        HorizontalLayout {
                            alignment: space-between;
                            Text { text: "Subtotal (" + root.items.length + " baris)"; font-size: 10px; color: AppStyle.text-secondary; }
                            Text { text: "Rp " + root.total_belanja; font-size: 11px; font-weight: 600; color: AppStyle.text-primary; }
                        }
                        if root.nilai_tukar_poin > 0: HorizontalLayout {
                            alignment: space-between;
                            Text { text: "Diskon Poin Member"; font-size: 10px; color: AppStyle.success; }
                            Text { text: "- Rp " + root.nilai_tukar_poin; font-size: 11px; font-weight: 700; color: AppStyle.success; }
                        }

                        // Grand Total Box (Dark Slate Card)
                        Rectangle {
                            height: 48px;
                            background: AppStyle.header-bg;
                            border-radius: 4px;
                            border-width: 1px;
                            border-color: AppStyle.header-border;

                            HorizontalLayout {
                                padding-left: 10px; padding-right: 10px;
                                alignment: space-between;
                                VerticalLayout {
                                    alignment: center; spacing: 1px;
                                    Text { text: "TOTAL AKHIR"; font-size: 9px; font-weight: 800; color: AppStyle.header-muted; }
                                    Text { text: root.metode_bayar; font-size: 10px; font-weight: 700; color: AppStyle.primary; }
                                }
                                Text {
                                    text: "Rp " + Math.max(0.0, root.total_belanja - root.nilai_tukar_poin);
                                    font-size: 20px; font-weight: 800; color: #ffffff; vertical-alignment: center;
                                }
                            }
                        }
                    }
                }

                // Compact Quick Cash Tender Row
                Rectangle {
                    height: 30px;
                    background: AppStyle.surface-low;
                    HorizontalLayout {
                        padding-left: 6px; padding-right: 6px; spacing: 4px;
                        Rectangle {
                            horizontal-stretch: 1; height: 22px; background: AppStyle.surface; border-radius: 2px; border-width: 1px; border-color: AppStyle.border;
                            TouchArea { clicked => {
                                root.bayar_tunai = Math.max(0.0, root.total_belanja - root.nilai_tukar_poin);
                                root.input_tender_str = "" + root.bayar_tunai;
                            } }
                            Text { text: "Uang Pas"; font-size: 9px; font-weight: 700; color: AppStyle.primary-dark; horizontal-alignment: center; vertical-alignment: center; }
                        }
                        Rectangle {
                            horizontal-stretch: 1; height: 22px; background: AppStyle.surface; border-radius: 2px; border-width: 1px; border-color: AppStyle.border;
                            TouchArea { clicked => { root.bayar_tunai = 50000.0; root.input_tender_str = "50000"; } }
                            Text { text: "50.000"; font-size: 9px; font-weight: 700; color: AppStyle.text-primary; horizontal-alignment: center; vertical-alignment: center; }
                        }
                        Rectangle {
                            horizontal-stretch: 1; height: 22px; background: AppStyle.surface; border-radius: 2px; border-width: 1px; border-color: AppStyle.border;
                            TouchArea { clicked => { root.bayar_tunai = 100000.0; root.input_tender_str = "100000"; } }
                            Text { text: "100.000"; font-size: 9px; font-weight: 700; color: AppStyle.text-primary; horizontal-alignment: center; vertical-alignment: center; }
                        }
                        Rectangle {
                            horizontal-stretch: 1; height: 22px; background: AppStyle.surface; border-radius: 2px; border-width: 1px; border-color: AppStyle.border;
                            TouchArea { clicked => { root.bayar_tunai = 200000.0; root.input_tender_str = "200000"; } }
                            Text { text: "200.000"; font-size: 9px; font-weight: 700; color: AppStyle.text-primary; horizontal-alignment: center; vertical-alignment: center; }
                        }
                    }
                }

                // Payment Method Selector Grid
                Rectangle {
                    height: 32px;
                    background: AppStyle.surface-low;
                    HorizontalLayout {
                        padding-left: 6px; padding-right: 6px; spacing: 4px;
                        Rectangle {
                            horizontal-stretch: 1; height: 24px; border-radius: 3px;
                            background: root.metode_bayar == "TUNAI" ? AppStyle.success : AppStyle.surface;
                            border-width: 1px; border-color: AppStyle.border;
                            TouchArea { clicked => { root.metode_bayar = "TUNAI"; } }
                            Text { text: "[F7] TUNAI"; font-size: 9px; font-weight: 700; color: root.metode_bayar == "TUNAI" ? #ffffff : AppStyle.text-secondary; horizontal-alignment: center; vertical-alignment: center; }
                        }
                        Rectangle {
                            horizontal-stretch: 1; height: 24px; border-radius: 3px;
                            background: root.metode_bayar == "NONTUNAI" ? AppStyle.primary : AppStyle.surface;
                            border-width: 1px; border-color: AppStyle.border;
                            TouchArea { clicked => { root.metode_bayar = "NONTUNAI"; } }
                            Text { text: "[F8] QRIS"; font-size: 9px; font-weight: 700; color: root.metode_bayar == "NONTUNAI" ? #ffffff : AppStyle.text-secondary; horizontal-alignment: center; vertical-alignment: center; }
                        }
                        Rectangle {
                            horizontal-stretch: 1; height: 24px; border-radius: 3px;
                            background: root.metode_bayar == "KREDIT" ? AppStyle.warning : AppStyle.surface;
                            border-width: 1px; border-color: AppStyle.border;
                            TouchArea { clicked => { root.metode_bayar = "KREDIT"; } }
                            Text { text: "[F9] KREDIT"; font-size: 9px; font-weight: 700; color: root.metode_bayar == "KREDIT" ? #ffffff : AppStyle.text-secondary; horizontal-alignment: center; vertical-alignment: center; }
                        }
                    }
                }

                // Input Tender Box & Kembalian
                Rectangle {
                    height: 42px;
                    background: AppStyle.surface;
                    border-width: 1px; border-color: AppStyle.border;

                    HorizontalLayout {
                        padding-left: 8px; padding-right: 8px;
                        alignment: space-between;

                        HorizontalLayout {
                            spacing: 6px; alignment: start;
                            Text { text: "Diterima (Rp):"; font-size: 10px; font-weight: 700; color: AppStyle.text-secondary; vertical-alignment: center; }
                            Rectangle {
                                width: 110px; height: 26px; background: AppStyle.surface-low; border-radius: 2px; border-width: 1px; border-color: AppStyle.border-focus;
                                HorizontalLayout {
                                    padding-left: 6px; padding-right: 6px;
                                    input_bayar_box := TextInput {
                                        text <=> root.input_tender_str;
                                        font-size: 12px; font-weight: 700; color: AppStyle.text-primary; vertical-alignment: center;
                                        edited => { root.bayar_tunai = self.text.to-float(); }
                                    }
                                }
                            }
                        }

                        HorizontalLayout {
                            spacing: 4px; alignment: end;
                            Text { text: "Kembali:"; font-size: 10px; color: AppStyle.text-muted; vertical-alignment: center; }
                            Text {
                                text: "Rp " + Math.max(0.0, root.bayar_tunai - Math.max(0.0, root.total_belanja - root.nilai_tukar_poin));
                                font-size: 13px; font-weight: 800; color: AppStyle.primary; vertical-alignment: center;
                            }
                        }
                    }
                }

                // PRIMARY ACTION BUTTON (EMERALD TERMINAL CHECKOUT)
                Rectangle {
                    height: 42px;
                    background: AppStyle.success;
                    TouchArea { clicked => {
                        root.bayar_tunai = root.input_tender_str.to-float();
                        root.proses_bayar(root.input_tender_str.to-float());
                    } }

                    HorizontalLayout {
                        padding-left: 12px; padding-right: 12px;
                        alignment: space-between;
                        HorizontalLayout {
                            spacing: 6px; alignment: start;
                            Rectangle {
                                width: 70px; height: 18px; background: AppStyle.success-dark; border-radius: 2px;
                                Text { text: "ENTER / F5"; font-size: 8px; font-weight: 800; color: #a7f3d0; horizontal-alignment: center; vertical-alignment: center; }
                            }
                            Text { text: "PROSES BAYAR SEKARANG"; font-size: 11px; font-weight: 800; color: #ffffff; vertical-alignment: center; }
                        }
                        Text {
                            text: "Rp " + Math.max(0.0, root.total_belanja - root.nilai_tukar_poin);
                            font-size: 13px; font-weight: 800; color: #ffffff; vertical-alignment: center;
                        }
                    }
                }

                // Auxiliary Action Buttons (Hold, Void)
                Rectangle {
                    height: 28px;
                    background: AppStyle.surface-low;
                    HorizontalLayout {
                        padding-left: 6px; padding-right: 6px; spacing: 4px;
                        Rectangle {
                            horizontal-stretch: 1; height: 22px; background: AppStyle.surface; border-radius: 2px; border-width: 1px; border-color: AppStyle.border;
                            TouchArea { clicked => { root.hold_transaksi("Antrean kasir"); } }
                            Text { text: "[F10] Tahan Nota"; font-size: 9px; font-weight: 700; color: AppStyle.warning; horizontal-alignment: center; vertical-alignment: center; }
                        }
                        Rectangle {
                            horizontal-stretch: 1; height: 22px; background: AppStyle.danger-bg; border-radius: 2px; border-width: 1px; border-color: AppStyle.danger-border;
                            TouchArea { clicked => {
                                root.input_tender_str = "0";
                                root.reset_transaksi();
                            } }
                            Text { text: "[ESC] Void Nota"; font-size: 9px; font-weight: 700; color: AppStyle.danger; horizontal-alignment: center; vertical-alignment: center; }
                        }
                    }
                }
            }
        }
    }
}

