import { PelangganGridData } from "../models.slint";
import { AppStyle } from "../styles.slint";

export component PelangganView inherits Rectangle {
    background: transparent;

    in-out property <[PelangganGridData]> items: [];
    callback cari_pelanggan(string);

    VerticalLayout {
        spacing: AppStyle.space-sm;

        Rectangle {
            height: AppStyle.header-height; background: AppStyle.surface; border-radius: 4px; border-width: 1px; border-color: AppStyle.border;
            HorizontalLayout {
                padding-left: AppStyle.space-md; padding-right: AppStyle.space-md; alignment: space-between;
                Text { text: "Master Pelanggan & Member"; font-size: AppStyle.font-body; font-weight: 700; color: AppStyle.text-primary; vertical-alignment: center; }
            }
        }

        Rectangle {
            background: AppStyle.surface; border-radius: 4px; border-width: 1px; border-color: AppStyle.border;
            vertical-stretch: 1;

            VerticalLayout {
                padding: 4px; spacing: 1px;
                Rectangle {
                    height: 30px; background: AppStyle.bg; border-width: 1px; border-color: AppStyle.border;
                    HorizontalLayout {
                        padding-left: 8px; padding-right: 8px;
                        Text { width: 35px; text: "No."; font-size: AppStyle.font-xs; font-weight: 700; color: AppStyle.text-secondary; vertical-alignment: center; }
                        Text { width: 100px; text: "Kode"; font-size: AppStyle.font-xs; font-weight: 700; color: AppStyle.text-secondary; vertical-alignment: center; }
                        Text { width: 180px; text: "Nama Pelanggan"; font-size: AppStyle.font-xs; font-weight: 700; color: AppStyle.text-secondary; vertical-alignment: center; }
                        Text { horizontal-stretch: 1; text: "Alamat"; font-size: AppStyle.font-xs; font-weight: 700; color: AppStyle.text-secondary; vertical-alignment: center; }
                        Text { width: 130px; text: "No Hp / Telp"; font-size: AppStyle.font-xs; font-weight: 700; color: AppStyle.text-secondary; vertical-alignment: center; }
                        Text { width: 100px; text: "Poin Saldo"; font-size: AppStyle.font-xs; font-weight: 700; color: AppStyle.text-secondary; horizontal-alignment: center; vertical-alignment: center; }
                    }
                }

                for pl[idx] in root.items: Rectangle {
                    height: AppStyle.row-height-dense; background: Math.mod(idx, 2) == 0 ? AppStyle.surface : AppStyle.row-alt; border-width: 1px; border-color: AppStyle.border;
                    HorizontalLayout {
                        padding-left: 8px; padding-right: 8px;
                        Text { width: 35px; text: "" + (idx + 1); font-size: AppStyle.font-xs; color: AppStyle.text-muted; vertical-alignment: center; }
                        Text { width: 100px; text: pl.kode; font-size: AppStyle.font-sm; font-weight: 600; color: AppStyle.primary; vertical-alignment: center; }
                        Text { width: 180px; text: pl.nama; font-size: AppStyle.font-sm; font-weight: 600; color: AppStyle.text-primary; vertical-alignment: center; }
                        Text { horizontal-stretch: 1; text: pl.alamat; font-size: AppStyle.font-sm; color: AppStyle.text-secondary; vertical-alignment: center; }
                        Text { width: 130px; text: pl.telepon; font-size: AppStyle.font-sm; color: AppStyle.text-muted; vertical-alignment: center; }
                        Text { width: 100px; text: "" + pl.poin_saldo; font-size: AppStyle.font-sm; font-weight: 700; color: AppStyle.success; horizontal-alignment: center; vertical-alignment: center; }
                    }
                }

                if root.items.length == 0: Rectangle {
                    height: 180px;
                    Text { text: "Data pelanggan kosong."; font-size: AppStyle.font-body; color: AppStyle.text-muted; horizontal-alignment: center; vertical-alignment: center; }
                }
            }
        }
    }
}
