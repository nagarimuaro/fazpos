import { PembelianGridData } from "../models.slint";
import { AppStyle } from "../styles.slint";

export component PembelianView inherits Rectangle {
    background: transparent;

    in-out property <[PembelianGridData]> items: [];
    in-out property <string> input_kode_barang: "";
    in-out property <string> input_nama_supplier: "";
    in-out property <string> input_qty: "1";
    in-out property <string> input_harga_beli: "0";
    in-out property <string> input_bayar: "0";
    in-out property <string> input_metode: "TUNAI";

    callback simpan_pembelian(string, string, float, float, float, string);
    callback refresh_pembelian();

    VerticalLayout {
        spacing: AppStyle.space-sm;

        Rectangle {
            height: AppStyle.header-height; background: AppStyle.surface; border-radius: 4px; border-width: 1px; border-color: AppStyle.border;
            HorizontalLayout {
                padding-left: AppStyle.space-md; padding-right: AppStyle.space-md; alignment: space-between;
                Text { text: "Transaksi Pembelian & Pengadaan Barang"; font-size: AppStyle.font-body; font-weight: 700; color: AppStyle.text-primary; vertical-alignment: center; }
                Rectangle {
                    height: 28px; background: AppStyle.border; border-radius: 3px;
                    TouchArea { clicked => { root.refresh_pembelian(); } }
                    HorizontalLayout { padding-left: 10px; padding-right: 10px; Text { text: "Refresh"; font-size: AppStyle.font-xs; font-weight: 600; color: AppStyle.text-secondary; vertical-alignment: center; } }
                }
            }
        }

        // Form Entri Pembelian Cepat
        Rectangle {
            background: AppStyle.surface; border-radius: 4px; border-width: 1px; border-color: AppStyle.border-focus;

            HorizontalLayout {
                padding: AppStyle.space-sm;
                spacing: 10px;
                alignment: start;

                VerticalLayout {
                    spacing: 3px; width: 140px;
                    Text { text: "Kode / Barcode:"; font-size: AppStyle.font-xs; font-weight: 600; color: AppStyle.text-secondary; }
                    Rectangle { height: 32px; background: AppStyle.bg; border-radius: 4px; border-width: 1px; border-color: AppStyle.border-focus; HorizontalLayout { padding-left: 6px; TextInput { text <=> root.input_kode_barang; font-size: AppStyle.font-sm; color: AppStyle.text-primary; vertical-alignment: center; } } }
                }
                VerticalLayout {
                    spacing: 3px; horizontal-stretch: 1;
                    Text { text: "Nama Supplier:"; font-size: AppStyle.font-xs; font-weight: 600; color: AppStyle.text-secondary; }
                    Rectangle { height: 32px; background: AppStyle.bg; border-radius: 4px; border-width: 1px; border-color: AppStyle.border-focus; HorizontalLayout { padding-left: 6px; TextInput { text <=> root.input_nama_supplier; font-size: AppStyle.font-sm; color: AppStyle.text-primary; vertical-alignment: center; } } }
                }
                VerticalLayout {
                    spacing: 3px; width: 80px;
                    Text { text: "Qty Beli:"; font-size: AppStyle.font-xs; font-weight: 600; color: AppStyle.text-secondary; }
                    Rectangle { height: 32px; background: AppStyle.bg; border-radius: 4px; border-width: 1px; border-color: AppStyle.border-focus; HorizontalLayout { padding-left: 6px; TextInput { text <=> root.input_qty; font-size: AppStyle.font-sm; color: AppStyle.text-primary; vertical-alignment: center; } } }
                }
                VerticalLayout {
                    spacing: 3px; width: 110px;
                    Text { text: "Harga Pokok (Rp):"; font-size: AppStyle.font-xs; font-weight: 600; color: AppStyle.text-secondary; }
                    Rectangle { height: 32px; background: AppStyle.bg; border-radius: 4px; border-width: 1px; border-color: AppStyle.border-focus; HorizontalLayout { padding-left: 6px; TextInput { text <=> root.input_harga_beli; font-size: AppStyle.font-sm; color: AppStyle.text-primary; vertical-alignment: center; } } }
                }
                VerticalLayout {
                    spacing: 3px; width: 110px;
                    Text { text: "Uang Muka/Bayar:"; font-size: AppStyle.font-xs; font-weight: 600; color: AppStyle.text-secondary; }
                    Rectangle { height: 32px; background: AppStyle.bg; border-radius: 4px; border-width: 1px; border-color: AppStyle.border-focus; HorizontalLayout { padding-left: 6px; TextInput { text <=> root.input_bayar; font-size: AppStyle.font-sm; color: AppStyle.text-primary; vertical-alignment: center; } } }
                }
                VerticalLayout {
                    spacing: 3px; width: 90px;
                    Text { text: "Metode:"; font-size: AppStyle.font-xs; font-weight: 600; color: AppStyle.text-secondary; }
                    Rectangle {
                        height: 32px; border-radius: 4px; background: root.input_metode == "TUNAI" ? AppStyle.success : AppStyle.warning;
                        TouchArea { clicked => { root.input_metode = root.input_metode == "TUNAI" ? "KREDIT" : "TUNAI"; } }
                        Text { text: root.input_metode; font-size: 10px; font-weight: 700; color: #ffffff; horizontal-alignment: center; vertical-alignment: center; }
                    }
                }
                VerticalLayout {
                    spacing: 3px; width: 130px;
                    Text { text: "Aksi:"; font-size: AppStyle.font-xs; color: transparent; }
                    Rectangle {
                        height: 32px; background: AppStyle.primary; border-radius: 4px;
                        TouchArea { clicked => {
                            root.simpan_pembelian(
                                root.input_kode_barang,
                                root.input_nama_supplier,
                                root.input_qty.to-float(),
                                root.input_harga_beli.to-float(),
                                root.input_bayar.to-float(),
                                root.input_metode
                            );
                        } }
                        Text { text: "SIMPAN NOTA"; font-size: AppStyle.font-xs; font-weight: 700; color: #ffffff; horizontal-alignment: center; vertical-alignment: center; }
                    }
                }
            }
        }

        // Tabel Riwayat Pembelian
        Rectangle {
            background: AppStyle.surface; border-radius: 4px; border-width: 1px; border-color: AppStyle.border;
            vertical-stretch: 1;

            VerticalLayout {
                padding: 4px; spacing: 1px;
                Rectangle {
                    height: 30px; background: AppStyle.bg; border-width: 1px; border-color: AppStyle.border;
                    HorizontalLayout {
                        padding-left: 8px; padding-right: 8px;
                        Text { width: 35px; text: "No."; font-size: AppStyle.font-xs; font-weight: 700; color: AppStyle.text-secondary; vertical-alignment: center; }
                        Text { width: 160px; text: "Faktur Beli"; font-size: AppStyle.font-xs; font-weight: 700; color: AppStyle.text-secondary; vertical-alignment: center; }
                        Text { horizontal-stretch: 1; text: "Supplier"; font-size: AppStyle.font-xs; font-weight: 700; color: AppStyle.text-secondary; vertical-alignment: center; }
                        Text { width: 140px; text: "Tanggal"; font-size: AppStyle.font-xs; font-weight: 700; color: AppStyle.text-secondary; vertical-alignment: center; }
                        Text { width: 120px; text: "Total (Rp)"; font-size: AppStyle.font-xs; font-weight: 700; color: AppStyle.text-secondary; horizontal-alignment: right; vertical-alignment: center; }
                        Text { width: 120px; text: "Bayar (Rp)"; font-size: AppStyle.font-xs; font-weight: 700; color: AppStyle.text-secondary; horizontal-alignment: right; vertical-alignment: center; }
                        Text { width: 120px; text: "Sisa Hutang"; font-size: AppStyle.font-xs; font-weight: 700; color: AppStyle.text-secondary; horizontal-alignment: right; vertical-alignment: center; }
                    }
                }

                for p[idx] in root.items: Rectangle {
                    height: AppStyle.row-height-dense; background: Math.mod(idx, 2) == 0 ? AppStyle.surface : AppStyle.row-alt; border-width: 1px; border-color: AppStyle.border;
                    HorizontalLayout {
                        padding-left: 8px; padding-right: 8px;
                        Text { width: 35px; text: "" + (idx + 1); font-size: AppStyle.font-xs; color: AppStyle.text-muted; vertical-alignment: center; }
                        Text { width: 160px; text: p.faktur; font-size: AppStyle.font-sm; font-weight: 600; color: AppStyle.primary; vertical-alignment: center; }
                        Text { horizontal-stretch: 1; text: p.supplier; font-size: AppStyle.font-sm; color: AppStyle.text-primary; vertical-alignment: center; }
                        Text { width: 140px; text: p.tanggal; font-size: AppStyle.font-xs; color: AppStyle.text-muted; vertical-alignment: center; }
                        Text { width: 120px; text: "Rp " + p.total; font-size: AppStyle.font-sm; font-weight: 700; color: AppStyle.text-primary; horizontal-alignment: right; vertical-alignment: center; }
                        Text { width: 120px; text: "Rp " + p.bayar; font-size: AppStyle.font-sm; color: AppStyle.success; horizontal-alignment: right; vertical-alignment: center; }
                        Text { width: 120px; text: p.sisa > 0 ? "Rp " + p.sisa : "LUNAS"; font-size: AppStyle.font-sm; font-weight: 700; color: p.sisa > 0 ? AppStyle.danger : AppStyle.success; horizontal-alignment: right; vertical-alignment: center; }
                    }
                }

                if root.items.length == 0: Rectangle {
                    height: 180px;
                    Text { text: "Belum ada transaksi pembelian barang."; font-size: AppStyle.font-body; color: AppStyle.text-muted; horizontal-alignment: center; vertical-alignment: center; }
                }
            }
        }
    }
}
