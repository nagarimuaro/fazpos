import { AppStyle } from "../styles.slint";

export component ShiftView inherits Rectangle {
    background: transparent;

    in-out property <float> modal_awal: 100000.0;
    in-out property <float> total_tunai: 0.0;
    in-out property <float> total_nontunai: 0.0;
    in-out property <float> total_retur: 0.0;
    in-out property <float> uang_seharusnya: 100000.0;
    in-out property <string> shift_status: "SHIFT AKTIF";
    in-out property <string> catatan: "";
    in-out property <string> input_modal_buka: "100000";

    callback tutup_shift();
    callback buka_shift(float);

    HorizontalLayout {
        spacing: AppStyle.space-md;

        // Rekapitulasi Kas Shift (Kiri - Anti AI-Slop)
        Rectangle {
            horizontal-stretch: 1;
            background: AppStyle.surface;
            border-radius: 4px;
            border-width: 1px;
            border-color: AppStyle.border;

            VerticalLayout {
                padding: AppStyle.space-lg;
                spacing: AppStyle.space-md;

                Text { text: "REKAPITULASI KAS SHIFT KASIR (§12.4)"; font-size: AppStyle.font-body; font-weight: 800; color: AppStyle.primary-dark; }

                HorizontalLayout { alignment: space-between; Text { text: "Modal Awal Kasir:"; color: AppStyle.text-secondary; font-size: AppStyle.font-sm; } Text { text: "Rp " + root.modal_awal; font-weight: 700; color: AppStyle.text-primary; font-size: AppStyle.font-body; } }
                HorizontalLayout { alignment: space-between; Text { text: "Total Penjualan Tunai (+):"; color: AppStyle.text-secondary; font-size: AppStyle.font-sm; } Text { text: "Rp " + root.total_tunai; font-weight: 700; color: AppStyle.success; font-size: AppStyle.font-body; } }
                HorizontalLayout { alignment: space-between; Text { text: "Total Penjualan Non-Tunai:"; color: AppStyle.text-secondary; font-size: AppStyle.font-sm; } Text { text: "Rp " + root.total_nontunai; font-weight: 700; color: AppStyle.primary; font-size: AppStyle.font-body; } }
                HorizontalLayout { alignment: space-between; Text { text: "Total Retur (-):"; color: AppStyle.text-secondary; font-size: AppStyle.font-sm; } Text { text: "Rp " + root.total_retur; font-weight: 700; color: AppStyle.danger; font-size: AppStyle.font-body; } }

                Rectangle { height: 1px; background: AppStyle.border; }

                HorizontalLayout {
                    alignment: space-between;
                    Text { text: "Uang Kas Seharusnya:"; font-size: AppStyle.font-body; font-weight: 800; color: AppStyle.text-primary; }
                    Text { text: "Rp " + root.uang_seharusnya; font-size: 22px; font-weight: 800; color: AppStyle.primary; }
                }
            }
        }

        // Panel Aksi Tutup / Buka Shift (Kanan)
        Rectangle {
            horizontal-stretch: 1;
            background: AppStyle.surface;
            border-radius: 4px;
            border-width: 1px;
            border-color: AppStyle.border;

            VerticalLayout {
                padding: AppStyle.space-lg;
                spacing: AppStyle.space-md;

                if root.shift_status != "CLOSED": VerticalLayout {
                    spacing: AppStyle.space-md;
                    Text { text: "TUTUP SHIFT KASIR AKTIF"; font-size: AppStyle.font-body; font-weight: 800; color: AppStyle.warning; }

                    VerticalLayout {
                        spacing: 4px;
                        Text { text: "Catatan Kasir / Keterangan:"; font-size: AppStyle.font-xs; font-weight: 600; color: AppStyle.text-secondary; }
                        Rectangle { height: 38px; background: AppStyle.bg; border-radius: 4px; border-width: 1px; border-color: AppStyle.border-focus; HorizontalLayout { padding-left: 8px; TextInput { text <=> root.catatan; font-size: AppStyle.font-sm; color: AppStyle.text-primary; vertical-alignment: center; } } }
                    }

                    Rectangle {
                        height: AppStyle.button-height-primary; background: AppStyle.danger; border-radius: 4px;
                        TouchArea { clicked => { root.tutup_shift(); } }
                        Text { text: "TUTUP SHIFT KASIR SEKARANG"; font-size: AppStyle.font-sm; font-weight: 700; color: #ffffff; horizontal-alignment: center; vertical-alignment: center; }
                    }
                }

                if root.shift_status == "CLOSED": VerticalLayout {
                    spacing: AppStyle.space-md;
                    Text { text: "BUKA SHIFT KASIR BARU"; font-size: AppStyle.font-body; font-weight: 800; color: AppStyle.success; }

                    VerticalLayout {
                        spacing: 4px;
                        Text { text: "Modal Awal Kasir (Rp):"; font-size: AppStyle.font-xs; font-weight: 600; color: AppStyle.text-secondary; }
                        Rectangle { height: 38px; background: AppStyle.bg; border-radius: 4px; border-width: 1px; border-color: AppStyle.border-focus; HorizontalLayout { padding-left: 8px; TextInput { text <=> root.input_modal_buka; font-size: AppStyle.font-body; font-weight: 700; color: AppStyle.text-primary; vertical-alignment: center; } } }
                    }

                    Rectangle {
                        height: AppStyle.button-height-primary; background: AppStyle.success; border-radius: 4px;
                        TouchArea { clicked => { root.buka_shift(root.input_modal_buka.to-float()); } }
                        Text { text: "BUKA SHIFT BARU"; font-size: AppStyle.font-sm; font-weight: 700; color: #ffffff; horizontal-alignment: center; vertical-alignment: center; }
                    }
                }
            }
        }
    }
}
