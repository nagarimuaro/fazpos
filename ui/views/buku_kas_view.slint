import { CashflowGridData } from "../models.slint";

export component BukuKasView inherits Rectangle {
    background: transparent;

    in-out property <[CashflowGridData]> items: [];
    in-out property <float> total_masuk: 0.0;
    in-out property <float> total_keluar: 0.0;
    in-out property <float> saldo_kas: 0.0;

    in-out property <string> input_jenis: "KELUAR"; // "MASUK" atau "KELUAR"
    in-out property <string> input_kategori: "Operasional Toko";
    in-out property <string> input_nominal: "0";
    in-out property <string> input_keterangan: "";

    callback catat_kas(string, string, float, string);
    callback refresh_kas();

    VerticalLayout {
        spacing: 8px;

        // KPI Ringkasan Kas (Light Theme)
        Rectangle {
            height: 48px; background: #ffffff; border-radius: 4px; border-width: 1px; border-color: #e2e8f0;
            HorizontalLayout {
                padding-left: 14px; padding-right: 14px; alignment: space-between;

                HorizontalLayout {
                    spacing: 8px; alignment: start;
                    Text { text: "Buku Kas & Biaya Operasional Toko"; font-size: 14px; font-weight: 700; color: #0f172a; vertical-alignment: center; }
                }

                HorizontalLayout {
                    spacing: 20px; alignment: end;
                    HorizontalLayout {
                        spacing: 6px;
                        Text { text: "Kas Masuk (+):"; font-size: 11px; color: #64748b; vertical-alignment: center; }
                        Text { text: "Rp " + root.total_masuk; font-size: 12px; font-weight: 700; color: #15803d; vertical-alignment: center; }
                    }
                    HorizontalLayout {
                        spacing: 6px;
                        Text { text: "Kas Keluar (-):"; font-size: 11px; color: #64748b; vertical-alignment: center; }
                        Text { text: "Rp " + root.total_keluar; font-size: 12px; font-weight: 700; color: #dc2626; vertical-alignment: center; }
                    }
                    HorizontalLayout {
                        spacing: 6px;
                        Text { text: "Saldo Kas:"; font-size: 12px; font-weight: 700; color: #0f172a; vertical-alignment: center; }
                        Text { text: "Rp " + root.saldo_kas; font-size: 14px; font-weight: 800; color: #0284c7; vertical-alignment: center; }
                    }
                }
            }
        }

        // Form Entri Kas
        Rectangle {
            background: #ffffff; border-radius: 4px; border-width: 1px; border-color: #cbd5e1;

            HorizontalLayout {
                padding: 10px;
                spacing: 12px;
                alignment: start;

                VerticalLayout {
                    spacing: 3px; width: 100px;
                    Text { text: "Jenis Aliran:"; font-size: 11px; font-weight: 600; color: #475569; }
                    Rectangle {
                        height: 32px; border-radius: 4px; background: root.input_jenis == "MASUK" ? #16a34a : #dc2626;
                        TouchArea { clicked => { root.input_jenis = root.input_jenis == "MASUK" ? "KELUAR" : "MASUK"; } }
                        Text { text: root.input_jenis; font-size: 11px; font-weight: 700; color: #ffffff; horizontal-alignment: center; vertical-alignment: center; }
                    }
                }

                VerticalLayout {
                    spacing: 3px; width: 180px;
                    Text { text: "Kategori Beban / Kas:"; font-size: 11px; font-weight: 600; color: #475569; }
                    Rectangle { height: 32px; background: #f8fafc; border-radius: 4px; border-width: 1px; border-color: #cbd5e1; HorizontalLayout { padding-left: 6px; TextInput { text <=> root.input_kategori; font-size: 12px; color: #0f172a; vertical-alignment: center; } } }
                }

                VerticalLayout {
                    spacing: 3px; width: 130px;
                    Text { text: "Nominal (Rp):"; font-size: 11px; font-weight: 600; color: #475569; }
                    Rectangle { height: 32px; background: #f8fafc; border-radius: 4px; border-width: 1px; border-color: #cbd5e1; HorizontalLayout { padding-left: 6px; TextInput { text <=> root.input_nominal; font-size: 12px; color: #0f172a; vertical-alignment: center; } } }
                }

                VerticalLayout {
                    spacing: 3px; horizontal-stretch: 1;
                    Text { text: "Keterangan:"; font-size: 11px; font-weight: 600; color: #475569; }
                    Rectangle { height: 32px; background: #f8fafc; border-radius: 4px; border-width: 1px; border-color: #cbd5e1; HorizontalLayout { padding-left: 6px; TextInput { text <=> root.input_keterangan; font-size: 12px; color: #0f172a; vertical-alignment: center; } } }
                }

                VerticalLayout {
                    spacing: 3px; width: 130px;
                    Text { text: "Aksi:"; font-size: 11px; color: transparent; }
                    Rectangle {
                        height: 32px; background: #0284c7; border-radius: 4px;
                        TouchArea { clicked => {
                            root.catat_kas(root.input_jenis, root.input_kategori, root.input_nominal.to-float(), root.input_keterangan);
                        } }
                        Text { text: "CATAT KAS"; font-size: 11px; font-weight: 700; color: #ffffff; horizontal-alignment: center; vertical-alignment: center; }
                    }
                }
            }
        }

        // Tabel Riwayat Mutasi Kas
        Rectangle {
            background: #ffffff; border-radius: 4px; border-width: 1px; border-color: #e2e8f0;
            vertical-stretch: 1;

            VerticalLayout {
                padding: 4px; spacing: 1px;
                Rectangle {
                    height: 30px; background: #f8fafc; border-width: 1px; border-color: #e2e8f0;
                    HorizontalLayout {
                        padding-left: 8px; padding-right: 8px;
                        Text { width: 35px; text: "No."; font-size: 11px; font-weight: 700; color: #475569; vertical-alignment: center; }
                        Text { width: 150px; text: "Waktu Transaksi"; font-size: 11px; font-weight: 700; color: #475569; vertical-alignment: center; }
                        Text { width: 90px; text: "Jenis"; font-size: 11px; font-weight: 700; color: #475569; horizontal-alignment: center; vertical-alignment: center; }
                        Text { width: 170px; text: "Kategori"; font-size: 11px; font-weight: 700; color: #475569; vertical-alignment: center; }
                        Text { width: 140px; text: "Nominal (Rp)"; font-size: 11px; font-weight: 700; color: #475569; horizontal-alignment: right; vertical-alignment: center; }
                        Text { horizontal-stretch: 1; text: "Keterangan"; font-size: 11px; font-weight: 700; color: #475569; vertical-alignment: center; }
                    }
                }

                for k[idx] in root.items: Rectangle {
                    height: 32px; background: Math.mod(idx, 2) == 0 ? #ffffff : #f8fafc; border-width: 1px; border-color: #f1f5f9;
                    HorizontalLayout {
                        padding-left: 8px; padding-right: 8px;
                        Text { width: 35px; text: "" + (idx + 1); font-size: 11px; color: #64748b; vertical-alignment: center; }
                        Text { width: 150px; text: k.tanggal; font-size: 11px; color: #64748b; vertical-alignment: center; }
                        Text { width: 90px; text: k.jenis; font-size: 11px; font-weight: 700; color: k.jenis == "MASUK" ? #15803d : #dc2626; horizontal-alignment: center; vertical-alignment: center; }
                        Text { width: 170px; text: k.kategori; font-size: 12px; font-weight: 600; color: #0f172a; vertical-alignment: center; }
                        Text { width: 140px; text: (k.jenis == "MASUK" ? "+Rp " : "-Rp ") + k.nominal; font-size: 12px; font-weight: 700; color: k.jenis == "MASUK" ? #15803d : #dc2626; horizontal-alignment: right; vertical-alignment: center; }
                        Text { horizontal-stretch: 1; text: k.keterangan; font-size: 12px; color: #334155; vertical-alignment: center; }
                    }
                }

                if root.items.length == 0: Rectangle {
                    height: 180px;
                    Text { text: "Belum ada riwayat mutasi kas."; font-size: 13px; color: #94a3b8; horizontal-alignment: center; vertical-alignment: center; }
                }
            }
        }
    }
}
