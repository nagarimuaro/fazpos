import { CashflowGridData } from "../models.slint";
import { AppStyle } from "../styles.slint";

export component BukuKasView inherits Rectangle {
    background: transparent;

    in-out property <[CashflowGridData]> items: [];
    in-out property <float> total_masuk: 0.0;
    in-out property <float> total_keluar: 0.0;
    in-out property <float> saldo_kas: 0.0;

    in-out property <string> input_jenis: "KELUAR"; // "MASUK" atau "KELUAR"
    in-out property <string> input_kategori: "Operasional Toko";
    in-out property <string> input_nominal: "0";
    in-out property <string> input_keterangan: "";

    callback catat_kas(string, string, float, string);
    callback refresh_kas();

    VerticalLayout {
        spacing: AppStyle.space-sm;

        // KPI Ringkasan Kas (Light Theme Anti AI-Slop)
        Rectangle {
            height: 48px; background: AppStyle.surface; border-radius: 4px; border-width: 1px; border-color: AppStyle.border;
            HorizontalLayout {
                padding-left: AppStyle.space-md; padding-right: AppStyle.space-md; alignment: space-between;

                HorizontalLayout {
                    spacing: AppStyle.space-sm; alignment: start;
                    Text { text: "Buku Kas & Biaya Operasional Toko"; font-size: AppStyle.font-body; font-weight: 700; color: AppStyle.text-primary; vertical-alignment: center; }
                }

                HorizontalLayout {
                    spacing: AppStyle.space-lg; alignment: end;
                    HorizontalLayout {
                        spacing: 6px;
                        Text { text: "Kas Masuk (+):"; font-size: AppStyle.font-xs; color: AppStyle.text-muted; vertical-alignment: center; }
                        Text { text: "Rp " + root.total_masuk; font-size: AppStyle.font-sm; font-weight: 700; color: AppStyle.success; vertical-alignment: center; }
                    }
                    HorizontalLayout {
                        spacing: 6px;
                        Text { text: "Kas Keluar (-):"; font-size: AppStyle.font-xs; color: AppStyle.text-muted; vertical-alignment: center; }
                        Text { text: "Rp " + root.total_keluar; font-size: AppStyle.font-sm; font-weight: 700; color: AppStyle.danger; vertical-alignment: center; }
                    }
                    HorizontalLayout {
                        spacing: 6px;
                        Text { text: "Saldo Kas:"; font-size: AppStyle.font-sm; font-weight: 700; color: AppStyle.text-primary; vertical-alignment: center; }
                        Text { text: "Rp " + root.saldo_kas; font-size: AppStyle.font-heading; font-weight: 800; color: AppStyle.primary; vertical-alignment: center; }
                    }
                }
            }
        }

        // Form Entri Kas
        Rectangle {
            background: AppStyle.surface; border-radius: 4px; border-width: 1px; border-color: AppStyle.border-focus;

            HorizontalLayout {
                padding: AppStyle.space-sm;
                spacing: AppStyle.space-md;
                alignment: start;

                VerticalLayout {
                    spacing: 3px; width: 100px;
                    Text { text: "Jenis Aliran:"; font-size: AppStyle.font-xs; font-weight: 600; color: AppStyle.text-secondary; }
                    Rectangle {
                        height: 32px; border-radius: 4px; background: root.input_jenis == "MASUK" ? AppStyle.success : AppStyle.danger;
                        TouchArea { clicked => { root.input_jenis = root.input_jenis == "MASUK" ? "KELUAR" : "MASUK"; } }
                        Text { text: root.input_jenis; font-size: AppStyle.font-xs; font-weight: 700; color: #ffffff; horizontal-alignment: center; vertical-alignment: center; }
                    }
                }

                VerticalLayout {
                    spacing: 3px; width: 180px;
                    Text { text: "Kategori Beban / Kas:"; font-size: AppStyle.font-xs; font-weight: 600; color: AppStyle.text-secondary; }
                    Rectangle { height: 32px; background: AppStyle.bg; border-radius: 4px; border-width: 1px; border-color: AppStyle.border-focus; HorizontalLayout { padding-left: 6px; TextInput { text <=> root.input_kategori; font-size: AppStyle.font-sm; color: AppStyle.text-primary; vertical-alignment: center; } } }
                }

                VerticalLayout {
                    spacing: 3px; width: 130px;
                    Text { text: "Nominal (Rp):"; font-size: AppStyle.font-xs; font-weight: 600; color: AppStyle.text-secondary; }
                    Rectangle { height: 32px; background: AppStyle.bg; border-radius: 4px; border-width: 1px; border-color: AppStyle.border-focus; HorizontalLayout { padding-left: 6px; TextInput { text <=> root.input_nominal; font-size: AppStyle.font-sm; color: AppStyle.text-primary; vertical-alignment: center; } } }
                }

                VerticalLayout {
                    spacing: 3px; horizontal-stretch: 1;
                    Text { text: "Keterangan:"; font-size: AppStyle.font-xs; font-weight: 600; color: AppStyle.text-secondary; }
                    Rectangle { height: 32px; background: AppStyle.bg; border-radius: 4px; border-width: 1px; border-color: AppStyle.border-focus; HorizontalLayout { padding-left: 6px; TextInput { text <=> root.input_keterangan; font-size: AppStyle.font-sm; color: AppStyle.text-primary; vertical-alignment: center; } } }
                }

                VerticalLayout {
                    spacing: 3px; width: 130px;
                    Text { text: "Aksi:"; font-size: AppStyle.font-xs; color: transparent; }
                    Rectangle {
                        height: 32px; background: AppStyle.primary; border-radius: 4px;
                        TouchArea { clicked => {
                            root.catat_kas(root.input_jenis, root.input_kategori, root.input_nominal.to-float(), root.input_keterangan);
                        } }
                        Text { text: "CATAT KAS"; font-size: AppStyle.font-xs; font-weight: 700; color: #ffffff; horizontal-alignment: center; vertical-alignment: center; }
                    }
                }
            }
        }

        // Tabel Riwayat Mutasi Kas
        Rectangle {
            background: AppStyle.surface; border-radius: 4px; border-width: 1px; border-color: AppStyle.border;
            vertical-stretch: 1;

            VerticalLayout {
                padding: 4px; spacing: 1px;
                Rectangle {
                    height: 30px; background: AppStyle.bg; border-width: 1px; border-color: AppStyle.border;
                    HorizontalLayout {
                        padding-left: 8px; padding-right: 8px;
                        Text { width: 35px; text: "No."; font-size: AppStyle.font-xs; font-weight: 700; color: AppStyle.text-secondary; vertical-alignment: center; }
                        Text { width: 150px; text: "Waktu Transaksi"; font-size: AppStyle.font-xs; font-weight: 700; color: AppStyle.text-secondary; vertical-alignment: center; }
                        Text { width: 90px; text: "Jenis"; font-size: AppStyle.font-xs; font-weight: 700; color: AppStyle.text-secondary; horizontal-alignment: center; vertical-alignment: center; }
                        Text { width: 170px; text: "Kategori"; font-size: AppStyle.font-xs; font-weight: 700; color: AppStyle.text-secondary; vertical-alignment: center; }
                        Text { width: 140px; text: "Nominal (Rp)"; font-size: AppStyle.font-xs; font-weight: 700; color: AppStyle.text-secondary; horizontal-alignment: right; vertical-alignment: center; }
                        Text { horizontal-stretch: 1; text: "Keterangan"; font-size: AppStyle.font-xs; font-weight: 700; color: AppStyle.text-secondary; vertical-alignment: center; }
                    }
                }

                for k[idx] in root.items: Rectangle {
                    height: AppStyle.row-height-dense; background: Math.mod(idx, 2) == 0 ? AppStyle.surface : AppStyle.row-alt; border-width: 1px; border-color: AppStyle.border;
                    HorizontalLayout {
                        padding-left: 8px; padding-right: 8px;
                        Text { width: 35px; text: "" + (idx + 1); font-size: AppStyle.font-xs; color: AppStyle.text-muted; vertical-alignment: center; }
                        Text { width: 150px; text: k.tanggal; font-size: AppStyle.font-xs; color: AppStyle.text-muted; vertical-alignment: center; }
                        Text { width: 90px; text: k.jenis; font-size: AppStyle.font-xs; font-weight: 700; color: k.jenis == "MASUK" ? AppStyle.success : AppStyle.danger; horizontal-alignment: center; vertical-alignment: center; }
                        Text { width: 170px; text: k.kategori; font-size: AppStyle.font-sm; font-weight: 600; color: AppStyle.text-primary; vertical-alignment: center; }
                        Text { width: 140px; text: (k.jenis == "MASUK" ? "+Rp " : "-Rp ") + k.nominal; font-size: AppStyle.font-sm; font-weight: 700; color: k.jenis == "MASUK" ? AppStyle.success : AppStyle.danger; horizontal-alignment: right; vertical-alignment: center; }
                        Text { horizontal-stretch: 1; text: k.keterangan; font-size: AppStyle.font-sm; color: AppStyle.text-secondary; vertical-alignment: center; }
                    }
                }

                if root.items.length == 0: Rectangle {
                    height: 180px;
                    Text { text: "Belum ada riwayat mutasi kas."; font-size: AppStyle.font-body; color: AppStyle.text-muted; horizontal-alignment: center; vertical-alignment: center; }
                }
            }
        }
    }
}
