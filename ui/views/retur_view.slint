import { ReturGridData } from "../models.slint";

export component ReturView inherits Rectangle {
    background: transparent;

    in-out property <[ReturGridData]> items: [];
    in-out property <string> input_faktur_jual: "";
    in-out property <string> input_kode_barang: "";
    in-out property <string> input_jumlah_retur: "1";

    callback proses_retur(string, string, float);
    callback refresh_retur();

    VerticalLayout {
        spacing: 8px;

        Rectangle {
            height: 44px; background: #ffffff; border-radius: 4px; border-width: 1px; border-color: #e2e8f0;
            HorizontalLayout {
                padding-left: 14px; padding-right: 14px; alignment: space-between;
                Text { text: "Retur Penjualan Kasir"; font-size: 14px; font-weight: 700; color: #0f172a; vertical-alignment: center; }
                Rectangle {
                    height: 28px; background: #e2e8f0; border-radius: 3px;
                    TouchArea { clicked => { root.refresh_retur(); } }
                    HorizontalLayout { padding-left: 10px; padding-right: 10px; Text { text: "Refresh"; font-size: 11px; font-weight: 600; color: #334155; vertical-alignment: center; } }
                }
            }
        }

        // Form Entri Retur Cepat
        Rectangle {
            background: #ffffff; border-radius: 4px; border-width: 1px; border-color: #cbd5e1;

            HorizontalLayout {
                padding: 10px;
                spacing: 12px;
                alignment: start;

                VerticalLayout {
                    spacing: 3px;
                    Text { text: "No. Faktur Penjualan:"; font-size: 11px; font-weight: 600; color: #475569; }
                    Rectangle {
                        width: 220px; height: 32px; background: #f8fafc; border-radius: 4px; border-width: 1px; border-color: #cbd5e1;
                        HorizontalLayout { padding-left: 8px; TextInput { text <=> root.input_faktur_jual; font-size: 12px; color: #0f172a; vertical-alignment: center; } }
                    }
                }

                VerticalLayout {
                    spacing: 3px;
                    Text { text: "Kode / Barcode Barang:"; font-size: 11px; font-weight: 600; color: #475569; }
                    Rectangle {
                        width: 200px; height: 32px; background: #f8fafc; border-radius: 4px; border-width: 1px; border-color: #cbd5e1;
                        HorizontalLayout { padding-left: 8px; TextInput { text <=> root.input_kode_barang; font-size: 12px; color: #0f172a; vertical-alignment: center; } }
                    }
                }

                VerticalLayout {
                    spacing: 3px;
                    Text { text: "Qty Retur:"; font-size: 11px; font-weight: 600; color: #475569; }
                    Rectangle {
                        width: 90px; height: 32px; background: #f8fafc; border-radius: 4px; border-width: 1px; border-color: #cbd5e1;
                        HorizontalLayout { padding-left: 8px; TextInput { text <=> root.input_jumlah_retur; font-size: 12px; color: #0f172a; vertical-alignment: center; } }
                    }
                }

                VerticalLayout {
                    spacing: 3px;
                    Text { text: "Aksi:"; font-size: 11px; color: transparent; }
                    Rectangle {
                        width: 130px; height: 32px; background: #dc2626; border-radius: 4px;
                        TouchArea { clicked => {
                            root.proses_retur(root.input_faktur_jual, root.input_kode_barang, root.input_jumlah_retur.to-float());
                        } }
                        Text { text: "SIMPAN RETUR"; font-size: 11px; font-weight: 700; color: #ffffff; horizontal-alignment: center; vertical-alignment: center; }
                    }
                }
            }
        }

        // Tabel Riwayat Retur
        Rectangle {
            background: #ffffff; border-radius: 4px; border-width: 1px; border-color: #e2e8f0;
            vertical-stretch: 1;

            VerticalLayout {
                padding: 4px; spacing: 1px;
                Rectangle {
                    height: 30px; background: #f8fafc; border-width: 1px; border-color: #e2e8f0;
                    HorizontalLayout {
                        padding-left: 8px; padding-right: 8px;
                        Text { width: 35px; text: "No."; font-size: 11px; font-weight: 700; color: #475569; vertical-alignment: center; }
                        Text { width: 170px; text: "Faktur Retur"; font-size: 11px; font-weight: 700; color: #475569; vertical-alignment: center; }
                        Text { width: 170px; text: "Faktur Asal"; font-size: 11px; font-weight: 700; color: #475569; vertical-alignment: center; }
                        Text { horizontal-stretch: 1; text: "Tanggal"; font-size: 11px; font-weight: 700; color: #475569; vertical-alignment: center; }
                        Text { width: 140px; text: "Total Retur (Rp)"; font-size: 11px; font-weight: 700; color: #475569; horizontal-alignment: right; vertical-alignment: center; }
                    }
                }

                for r[idx] in root.items: Rectangle {
                    height: 32px; background: Math.mod(idx, 2) == 0 ? #ffffff : #f8fafc; border-width: 1px; border-color: #f1f5f9;
                    HorizontalLayout {
                        padding-left: 8px; padding-right: 8px;
                        Text { width: 35px; text: "" + (idx + 1); font-size: 11px; color: #64748b; vertical-alignment: center; }
                        Text { width: 170px; text: r.faktur; font-size: 12px; font-weight: 600; color: #dc2626; vertical-alignment: center; }
                        Text { width: 170px; text: r.faktur_penjualan; font-size: 12px; color: #0284c7; vertical-alignment: center; }
                        Text { horizontal-stretch: 1; text: r.tanggal; font-size: 12px; color: #334155; vertical-alignment: center; }
                        Text { width: 140px; text: "Rp " + r.total; font-size: 12px; font-weight: 700; color: #dc2626; horizontal-alignment: right; vertical-alignment: center; }
                    }
                }

                if root.items.length == 0: Rectangle {
                    height: 180px;
                    Text { text: "Belum ada data retur penjualan."; font-size: 13px; color: #94a3b8; horizontal-alignment: center; vertical-alignment: center; }
                }
            }
        }
    }
}
