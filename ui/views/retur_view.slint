import { ReturGridData } from "../models.slint";
import { AppStyle } from "../styles.slint";

export component ReturView inherits Rectangle {
    background: transparent;

    in-out property <[ReturGridData]> items: [];
    in-out property <string> input_faktur_jual: "";
    in-out property <string> input_kode_barang: "";
    in-out property <string> input_jumlah_retur: "1";

    callback proses_retur(string, string, float);
    callback refresh_retur();

    VerticalLayout {
        spacing: AppStyle.space-sm;

        Rectangle {
            height: AppStyle.header-height; background: AppStyle.surface; border-radius: 4px; border-width: 1px; border-color: AppStyle.border;
            HorizontalLayout {
                padding-left: AppStyle.space-md; padding-right: AppStyle.space-md; alignment: space-between;
                Text { text: "Retur Penjualan Kasir"; font-size: AppStyle.font-body; font-weight: 700; color: AppStyle.text-primary; vertical-alignment: center; }
                Rectangle {
                    height: 28px; background: AppStyle.border; border-radius: 3px;
                    TouchArea { clicked => { root.refresh_retur(); } }
                    HorizontalLayout { padding-left: 10px; padding-right: 10px; Text { text: "Refresh"; font-size: AppStyle.font-xs; font-weight: 600; color: AppStyle.text-secondary; vertical-alignment: center; } }
                }
            }
        }

        // Form Entri Retur Cepat
        Rectangle {
            background: AppStyle.surface; border-radius: 4px; border-width: 1px; border-color: AppStyle.border-focus;

            HorizontalLayout {
                padding: AppStyle.space-sm;
                spacing: AppStyle.space-md;
                alignment: start;

                VerticalLayout {
                    spacing: 3px;
                    Text { text: "No. Faktur Penjualan:"; font-size: AppStyle.font-xs; font-weight: 600; color: AppStyle.text-secondary; }
                    Rectangle {
                        width: 220px; height: 32px; background: AppStyle.bg; border-radius: 4px; border-width: 1px; border-color: AppStyle.border-focus;
                        HorizontalLayout { padding-left: 8px; TextInput { text <=> root.input_faktur_jual; font-size: AppStyle.font-sm; color: AppStyle.text-primary; vertical-alignment: center; } }
                    }
                }

                VerticalLayout {
                    spacing: 3px;
                    Text { text: "Kode / Barcode Barang:"; font-size: AppStyle.font-xs; font-weight: 600; color: AppStyle.text-secondary; }
                    Rectangle {
                        width: 200px; height: 32px; background: AppStyle.bg; border-radius: 4px; border-width: 1px; border-color: AppStyle.border-focus;
                        HorizontalLayout { padding-left: 8px; TextInput { text <=> root.input_kode_barang; font-size: AppStyle.font-sm; color: AppStyle.text-primary; vertical-alignment: center; } }
                    }
                }

                VerticalLayout {
                    spacing: 3px;
                    Text { text: "Qty Retur:"; font-size: AppStyle.font-xs; font-weight: 600; color: AppStyle.text-secondary; }
                    Rectangle {
                        width: 90px; height: 32px; background: AppStyle.bg; border-radius: 4px; border-width: 1px; border-color: AppStyle.border-focus;
                        HorizontalLayout { padding-left: 8px; TextInput { text <=> root.input_jumlah_retur; font-size: AppStyle.font-sm; color: AppStyle.text-primary; vertical-alignment: center; } }
                    }
                }

                VerticalLayout {
                    spacing: 3px;
                    Text { text: "Aksi:"; font-size: AppStyle.font-xs; color: transparent; }
                    Rectangle {
                        width: 130px; height: 32px; background: AppStyle.danger; border-radius: 4px;
                        TouchArea { clicked => {
                            root.proses_retur(root.input_faktur_jual, root.input_kode_barang, root.input_jumlah_retur.to-float());
                        } }
                        Text { text: "SIMPAN RETUR"; font-size: AppStyle.font-xs; font-weight: 700; color: #ffffff; horizontal-alignment: center; vertical-alignment: center; }
                    }
                }
            }
        }

        // Tabel Riwayat Retur
        Rectangle {
            background: AppStyle.surface; border-radius: 4px; border-width: 1px; border-color: AppStyle.border;
            vertical-stretch: 1;

            VerticalLayout {
                padding: 4px; spacing: 1px;
                Rectangle {
                    height: 30px; background: AppStyle.bg; border-width: 1px; border-color: AppStyle.border;
                    HorizontalLayout {
                        padding-left: 8px; padding-right: 8px;
                        Text { width: 35px; text: "No."; font-size: AppStyle.font-xs; font-weight: 700; color: AppStyle.text-secondary; vertical-alignment: center; }
                        Text { width: 170px; text: "Faktur Retur"; font-size: AppStyle.font-xs; font-weight: 700; color: AppStyle.text-secondary; vertical-alignment: center; }
                        Text { width: 170px; text: "Faktur Asal"; font-size: AppStyle.font-xs; font-weight: 700; color: AppStyle.text-secondary; vertical-alignment: center; }
                        Text { horizontal-stretch: 1; text: "Tanggal"; font-size: AppStyle.font-xs; font-weight: 700; color: AppStyle.text-secondary; vertical-alignment: center; }
                        Text { width: 140px; text: "Total Retur (Rp)"; font-size: AppStyle.font-xs; font-weight: 700; color: AppStyle.text-secondary; horizontal-alignment: right; vertical-alignment: center; }
                    }
                }

                for r[idx] in root.items: Rectangle {
                    height: AppStyle.row-height-dense; background: Math.mod(idx, 2) == 0 ? AppStyle.surface : AppStyle.row-alt; border-width: 1px; border-color: AppStyle.border;
                    HorizontalLayout {
                        padding-left: 8px; padding-right: 8px;
                        Text { width: 35px; text: "" + (idx + 1); font-size: AppStyle.font-xs; color: AppStyle.text-muted; vertical-alignment: center; }
                        Text { width: 170px; text: r.faktur; font-size: AppStyle.font-sm; font-weight: 600; color: AppStyle.danger; vertical-alignment: center; }
                        Text { width: 170px; text: r.faktur_penjualan; font-size: AppStyle.font-sm; color: AppStyle.primary; vertical-alignment: center; }
                        Text { horizontal-stretch: 1; text: r.tanggal; font-size: AppStyle.font-sm; color: AppStyle.text-secondary; vertical-alignment: center; }
                        Text { width: 140px; text: "Rp " + r.total; font-size: AppStyle.font-sm; font-weight: 700; color: AppStyle.danger; horizontal-alignment: right; vertical-alignment: center; }
                    }
                }

                if root.items.length == 0: Rectangle {
                    height: 180px;
                    Text { text: "Belum ada data retur penjualan."; font-size: AppStyle.font-body; color: AppStyle.text-muted; horizontal-alignment: center; vertical-alignment: center; }
                }
            }
        }
    }
}
