export component PengaturanView inherits Rectangle {
    background: transparent;

    in-out property <int> sub_tab: 0; // 0: Lisensi, 1: Import SQL, 2: Backup
    in-out property <string> machine_id: "RTG-XXXX-XXXX-XXXX-XXXX";
    in-out property <string> input_license_token: "";
    in-out property <string> license_status_text: "BELUM AKTIVASI";
    in-out property <string> license_toko: "-";

    in-out property <string> input_sql_dump: "";
    in-out property <string> import_summary: "Tempel query dump INSERT SQL dari iB Retago 5, lalu klik Proses Import.";

    callback aktivasi_lisensi(string);
    callback jalankan_import_sql(string);
    callback buat_backup_db();

    VerticalLayout {
        spacing: 12px;

        // Sub-Tab Switcher
        Rectangle {
            height: 44px; background: #ffffff; border-radius: 4px; border-width: 1px; border-color: #e2e8f0;
            HorizontalLayout {
                padding-left: 12px; spacing: 8px; alignment: start;
                Rectangle {
                    height: 28px; border-radius: 3px; background: root.sub_tab == 0 ? #0284c7 : #e2e8f0;
                    TouchArea { clicked => { root.sub_tab = 0; } }
                    HorizontalLayout { padding-left: 12px; padding-right: 12px; Text { text: "Lisensi Offline"; font-size: 11px; font-weight: 700; color: root.sub_tab == 0 ? #ffffff : #334155; vertical-alignment: center; } }
                }
                Rectangle {
                    height: 28px; border-radius: 3px; background: root.sub_tab == 1 ? #0284c7 : #e2e8f0;
                    TouchArea { clicked => { root.sub_tab = 1; } }
                    HorizontalLayout { padding-left: 12px; padding-right: 12px; Text { text: "Import SQL Lama"; font-size: 11px; font-weight: 700; color: root.sub_tab == 1 ? #ffffff : #334155; vertical-alignment: center; } }
                }
                Rectangle {
                    height: 28px; border-radius: 3px; background: root.sub_tab == 2 ? #0284c7 : #e2e8f0;
                    TouchArea { clicked => { root.sub_tab = 2; } }
                    HorizontalLayout { padding-left: 12px; padding-right: 12px; Text { text: "Backup Database"; font-size: 11px; font-weight: 700; color: root.sub_tab == 2 ? #ffffff : #334155; vertical-alignment: center; } }
                }
            }
        }

        // KONTEN 0: LISENSI
        if root.sub_tab == 0: Rectangle {
            background: #ffffff; border-radius: 4px; border-width: 1px; border-color: #cbd5e1;
            VerticalLayout {
                padding: 18px; spacing: 14px;
                Text { text: "AKTIVASI LISENSI HARDWARE-LOCKED (OFFLINE ED25519)"; font-size: 13px; font-weight: 800; color: #0369a1; }

                VerticalLayout {
                    spacing: 4px;
                    Text { text: "Machine ID Perangkat Ini (Kirimkan ke Vendor):"; font-size: 11px; font-weight: 600; color: #475569; }
                    Rectangle {
                        height: 38px; background: #f8fafc; border-radius: 4px; border-width: 1px; border-color: #0284c7;
                        HorizontalLayout { padding-left: 12px; Text { text: root.machine_id; font-size: 14px; font-weight: 800; color: #0369a1; vertical-alignment: center; } }
                    }
                }

                VerticalLayout {
                    spacing: 4px;
                    Text { text: "Token Lisensi Resmi dari Vendor:"; font-size: 11px; font-weight: 600; color: #475569; }
                    Rectangle {
                        height: 44px; background: #f8fafc; border-radius: 4px; border-width: 1px; border-color: #cbd5e1;
                        HorizontalLayout { padding-left: 12px; padding-right: 12px; TextInput { text <=> root.input_license_token; font-size: 12px; color: #0f172a; vertical-alignment: center; } }
                    }
                }

                HorizontalLayout {
                    spacing: 12px;
                    Rectangle {
                        width: 160px; height: 38px; background: #16a34a; border-radius: 4px;
                        TouchArea { clicked => { root.aktivasi_lisensi(root.input_license_token); } }
                        Text { text: "AKTIFKAN LISENSI"; font-size: 11px; font-weight: 700; color: #ffffff; horizontal-alignment: center; vertical-alignment: center; }
                    }
                    Rectangle {
                        background: root.license_status_text == "TERAKTIVASI (LIFETIME)" ? #dcfce7 : #fee2e2;
                        border-radius: 4px; height: 38px;
                        HorizontalLayout { padding-left: 12px; padding-right: 12px; Text { text: root.license_status_text + " — Toko: " + root.license_toko; font-size: 11px; font-weight: 700; color: root.license_status_text == "TERAKTIVASI (LIFETIME)" ? #15803d : #dc2626; vertical-alignment: center; } }
                    }
                }
            }
        }

        // KONTEN 1: IMPORT SQL
        if root.sub_tab == 1: Rectangle {
            background: #ffffff; border-radius: 4px; border-width: 1px; border-color: #cbd5e1;
            VerticalLayout {
                padding: 18px; spacing: 12px;
                Text { text: "IMPORT DATA SQL DUMP DARI iB RETACO 5 (LEGACY)"; font-size: 13px; font-weight: 800; color: #0369a1; }
                Rectangle {
                    height: 150px; background: #f8fafc; border-radius: 4px; border-width: 1px; border-color: #cbd5e1;
                    HorizontalLayout { padding: 10px; TextInput { text <=> root.input_sql_dump; font-size: 12px; color: #0f172a; } }
                }
                Rectangle {
                    width: 160px; height: 38px; background: #0284c7; border-radius: 4px;
                    TouchArea { clicked => { root.jalankan_import_sql(root.input_sql_dump); } }
                    Text { text: "MULAI IMPORT SQL"; font-size: 11px; font-weight: 700; color: #ffffff; horizontal-alignment: center; vertical-alignment: center; }
                }
                Rectangle {
                    background: #f1f5f9; border-radius: 4px;
                    HorizontalLayout { padding: 12px; Text { text: root.import_summary; font-size: 12px; color: #334155; } }
                }
            }
        }

        // KONTEN 2: BACKUP
        if root.sub_tab == 2: Rectangle {
            background: #ffffff; border-radius: 4px; border-width: 1px; border-color: #cbd5e1;
            VerticalLayout {
                padding: 18px; spacing: 12px;
                Text { text: "BACKUP DATABASE & PEMELIHARAAN SISTEM SQLITE"; font-size: 13px; font-weight: 800; color: #0369a1; }
                Text { text: "Database SQLite lokal beroperasi dalam mode WAL (Write-Ahead Logging). Backup dapat dilakukan secara online tanpa perlu menutup kasir."; font-size: 12px; color: #64748b; }
                Rectangle {
                    width: 210px; height: 40px; background: #0284c7; border-radius: 4px;
                    TouchArea { clicked => { root.buat_backup_db(); } }
                    Text { text: "BUAT BACKUP SEKARANG"; font-size: 11px; font-weight: 700; color: #ffffff; horizontal-alignment: center; vertical-alignment: center; }
                }
            }
        }
    }
}
