import { AppStyle } from "../styles.slint";

export component PengaturanView inherits Rectangle {
    background: transparent;

    in-out property <int> sub_tab: 0; // 0: Lisensi, 1: Import SQL, 2: Backup
    in-out property <string> machine_id: "RTG-XXXX-XXXX-XXXX-XXXX";
    in-out property <string> input_license_token: "";
    in-out property <string> license_status_text: "BELUM AKTIVASI";
    in-out property <string> license_toko: "-";

    in-out property <string> input_sql_dump: "";
    in-out property <string> import_summary: "Tempel query dump INSERT SQL dari iB Retago 5, lalu klik Proses Import.";

    callback aktivasi_lisensi(string);
    callback jalankan_import_sql(string);
    callback buat_backup_db();

    VerticalLayout {
        spacing: AppStyle.space-md;

        // Sub-Tab Switcher
        Rectangle {
            height: AppStyle.header-height; background: AppStyle.surface; border-radius: 4px; border-width: 1px; border-color: AppStyle.border;
            HorizontalLayout {
                padding-left: AppStyle.space-md; spacing: AppStyle.space-sm; alignment: start;
                Rectangle {
                    height: 28px; border-radius: 3px;
                    background: root.sub_tab == 0 ? AppStyle.primary : AppStyle.border;
                    TouchArea { clicked => { root.sub_tab = 0; } }
                    HorizontalLayout { padding-left: 12px; padding-right: 12px; Text { text: "Lisensi Offline"; font-size: AppStyle.font-xs; font-weight: 700; color: root.sub_tab == 0 ? #ffffff : AppStyle.text-secondary; vertical-alignment: center; } }
                }
                Rectangle {
                    height: 28px; border-radius: 3px;
                    background: root.sub_tab == 1 ? AppStyle.primary : AppStyle.border;
                    TouchArea { clicked => { root.sub_tab = 1; } }
                    HorizontalLayout { padding-left: 12px; padding-right: 12px; Text { text: "Import SQL Lama"; font-size: AppStyle.font-xs; font-weight: 700; color: root.sub_tab == 1 ? #ffffff : AppStyle.text-secondary; vertical-alignment: center; } }
                }
                Rectangle {
                    height: 28px; border-radius: 3px;
                    background: root.sub_tab == 2 ? AppStyle.primary : AppStyle.border;
                    TouchArea { clicked => { root.sub_tab = 2; } }
                    HorizontalLayout { padding-left: 12px; padding-right: 12px; Text { text: "Backup Database"; font-size: AppStyle.font-xs; font-weight: 700; color: root.sub_tab == 2 ? #ffffff : AppStyle.text-secondary; vertical-alignment: center; } }
                }
            }
        }

        // KONTEN 0: LISENSI
        if root.sub_tab == 0: Rectangle {
            background: AppStyle.surface; border-radius: 4px; border-width: 1px; border-color: AppStyle.border;
            VerticalLayout {
                padding: AppStyle.space-lg; spacing: AppStyle.space-md;
                Text { text: "AKTIVASI LISENSI HARDWARE-LOCKED (OFFLINE ED25519)"; font-size: AppStyle.font-body; font-weight: 800; color: AppStyle.primary-dark; }

                VerticalLayout {
                    spacing: 4px;
                    Text { text: "Machine ID Perangkat Ini (Kirimkan ke Vendor):"; font-size: AppStyle.font-xs; font-weight: 600; color: AppStyle.text-secondary; }
                    Rectangle {
                        height: 38px; background: AppStyle.bg; border-radius: 4px; border-width: 1px; border-color: AppStyle.primary;
                        HorizontalLayout { padding-left: 12px; Text { text: root.machine_id; font-size: AppStyle.font-body; font-weight: 800; color: AppStyle.primary-dark; vertical-alignment: center; } }
                    }
                }

                VerticalLayout {
                    spacing: 4px;
                    Text { text: "Token Lisensi Resmi dari Vendor:"; font-size: AppStyle.font-xs; font-weight: 600; color: AppStyle.text-secondary; }
                    Rectangle {
                        height: 44px; background: AppStyle.bg; border-radius: 4px; border-width: 1px; border-color: AppStyle.border-focus;
                        HorizontalLayout { padding-left: 12px; padding-right: 12px; TextInput { text <=> root.input_license_token; font-size: AppStyle.font-sm; color: AppStyle.text-primary; vertical-alignment: center; } }
                    }
                }

                HorizontalLayout {
                    spacing: 12px;
                    Rectangle {
                        width: 160px; height: 38px; background: AppStyle.success; border-radius: 4px;
                        TouchArea { clicked => { root.aktivasi_lisensi(root.input_license_token); } }
                        Text { text: "AKTIFKAN LISENSI"; font-size: AppStyle.font-xs; font-weight: 700; color: #ffffff; horizontal-alignment: center; vertical-alignment: center; }
                    }
                    Rectangle {
                        background: root.license_status_text == "TERAKTIVASI (LIFETIME)" ? AppStyle.success-bg : AppStyle.danger-bg;
                        border-radius: 4px; height: 38px;
                        border-width: 1px; border-color: root.license_status_text == "TERAKTIVASI (LIFETIME)" ? AppStyle.success-border : AppStyle.danger-border;
                        HorizontalLayout { padding-left: 12px; padding-right: 12px; Text { text: root.license_status_text + " — Toko: " + root.license_toko; font-size: AppStyle.font-xs; font-weight: 700; color: root.license_status_text == "TERAKTIVASI (LIFETIME)" ? AppStyle.success : AppStyle.danger; vertical-alignment: center; } }
                    }
                }
            }
        }

        // KONTEN 1: IMPORT SQL
        if root.sub_tab == 1: Rectangle {
            background: AppStyle.surface; border-radius: 4px; border-width: 1px; border-color: AppStyle.border;
            VerticalLayout {
                padding: AppStyle.space-lg; spacing: AppStyle.space-md;
                Text { text: "IMPORT DATA SQL DUMP DARI iB RETAGO 5 (LEGACY)"; font-size: AppStyle.font-body; font-weight: 800; color: AppStyle.primary-dark; }
                Rectangle {
                    height: 150px; background: AppStyle.bg; border-radius: 4px; border-width: 1px; border-color: AppStyle.border-focus;
                    HorizontalLayout { padding: 10px; TextInput { text <=> root.input_sql_dump; font-size: AppStyle.font-sm; color: AppStyle.text-primary; } }
                }
                Rectangle {
                    width: 160px; height: 38px; background: AppStyle.primary; border-radius: 4px;
                    TouchArea { clicked => { root.jalankan_import_sql(root.input_sql_dump); } }
                    Text { text: "MULAI IMPORT SQL"; font-size: AppStyle.font-xs; font-weight: 700; color: #ffffff; horizontal-alignment: center; vertical-alignment: center; }
                }
                Rectangle {
                    background: AppStyle.bg; border-radius: 4px; border-width: 1px; border-color: AppStyle.border;
                    HorizontalLayout { padding: 12px; Text { text: root.import_summary; font-size: AppStyle.font-sm; color: AppStyle.text-secondary; } }
                }
            }
        }

        // KONTEN 2: BACKUP
        if root.sub_tab == 2: Rectangle {
            background: AppStyle.surface; border-radius: 4px; border-width: 1px; border-color: AppStyle.border;
            VerticalLayout {
                padding: AppStyle.space-lg; spacing: AppStyle.space-md;
                Text { text: "BACKUP DATABASE & PEMELIHARAAN SISTEM SQLITE"; font-size: AppStyle.font-body; font-weight: 800; color: AppStyle.primary-dark; }
                Text { text: "Database SQLite lokal beroperasi dalam mode WAL (Write-Ahead Logging). Backup dapat dilakukan secara online tanpa perlu menutup kasir."; font-size: AppStyle.font-sm; color: AppStyle.text-muted; }
                Rectangle {
                    width: 210px; height: 40px; background: AppStyle.primary; border-radius: 4px;
                    TouchArea { clicked => { root.buat_backup_db(); } }
                    Text { text: "BUAT BACKUP SEKARANG"; font-size: AppStyle.font-xs; font-weight: 700; color: #ffffff; horizontal-alignment: center; vertical-alignment: center; }
                }
            }
        }
    }
}
